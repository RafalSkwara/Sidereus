// EXPERIMENT (ui-fact-rhythm): one icon per fact.
import { Clock, Compass, Diameter, Ellipse, Eye, Info, Contrast, SunDim, Telescope } from "lucide-react";

export const FACT_ICONS = {
  window: Clock,
  best: Compass,
  expect: Eye,
  eyepiece: Telescope,
  reason: Info,
  see: Eye,
  magnitude: SunDim,
  size: Diameter,
  phase: Contrast,
  rings: Ellipse,
} as const;
export type FactIcon = (typeof FACT_ICONS)[keyof typeof FACT_ICONS];
