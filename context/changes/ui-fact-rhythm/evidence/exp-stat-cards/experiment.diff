// EXPERIMENT (ui-fact-rhythm): one fact, an icon then an optional muted label and the value or sentence.
import type { HTMLAttributes } from "astro/types";
import type { FactIcon } from "@/lib/ui/fact-icons";

interface Props extends HTMLAttributes<"div"> {
  icon: FactIcon;
  label?: string;
  muted?: boolean;
}
const { icon: Icon, label, muted = false, ...rest } = Astro.props;
---

<div class:list={["flex items-start gap-2 text-label", muted ? "text-muted-foreground" : "text-foreground"]} {...rest}>
  <Icon className="mt-0.5 size-4 shrink-0 text-muted-foreground" aria-hidden="true" />
  <div class="min-w-0 space-y-1">
    {label && <span class="text-muted-foreground">{label} </span>}<slot />
  </div>
</div>
