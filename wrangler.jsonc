{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sidereus",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // Per-site Open-Meteo forecast cache (src/lib/forecast/kv-cache.ts). After changing bindings,
  // rerun `npm run cf:types` and commit worker-configuration.d.ts.
  "kv_namespaces": [{ "binding": "FORECAST_CACHE", "id": "61441b2363ea41fca5731cfbc735b006" }],
  "observability": {
    "enabled": true,
    // The Open-Meteo request's query string carries site coordinates; keep it out of logs and traces.
    "redact_query_string": true,
    // The invocation event stores the whole `request.cf` of every visitor (latitude, longitude, city, postal code, region),
    // which is IP-derived location and cannot be redacted, so the event stays off. Our own console lines and Issues stay.
    // src/lib/wrangler-config.test.ts fails if this goes.
    "logs": { "enabled": true, "invocation_logs": false },
    // Per-fetch spans (Supabase, KV, Open-Meteo) so a slow request can be pinned to one call.
    "traces": { "enabled": true },
    // Every logged console.error becomes an Issue (the line shape is src/lib/observability/log-failure.ts). Keep it:
    // a dashboard-only switch is turned off by the next deploy, and src/lib/wrangler-config.test.ts fails if it goes.
    "issues": { "enabled": true },
  },
  // Version URLs are off: the probe that needed them is over (owner, 2026-10-15), and pinning the setting here means a
  // CI deploy cannot turn them back on, so no later Worker version has a public URL.
  "preview_urls": false,
  // Lets Cloudflare run the Worker near Supabase when a request makes several round trips to it.
  "placement": { "mode": "smart" },
}
