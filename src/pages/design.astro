  },
  {
    title: "Verdicts",
    tokens: [
      { name: "go", swatch: "bg-go" },
      { name: "go-surface", swatch: "bg-go-surface" },
      { name: "go-border", swatch: "bg-go-border" },
      { name: "marginal", swatch: "bg-marginal" },
      { name: "marginal-surface", swatch: "bg-marginal-surface" },
      { name: "marginal-border", swatch: "bg-marginal-border" },
      { name: "no-go", swatch: "bg-no-go" },
      { name: "no-go-surface", swatch: "bg-no-go-surface" },
      { name: "no-go-border", swatch: "bg-no-go-border" },
    ],
  },
  {
    title: "Status and sky",
    tokens: [
      { name: "destructive", swatch: "bg-destructive" },
      { name: "destructive-foreground", swatch: "bg-destructive-foreground" },
      { name: "warning", swatch: "bg-warning" },
      { name: "success", swatch: "bg-success" },
      { name: "star", swatch: "bg-star" },
      { name: "chart-star", swatch: "bg-chart-star" },
      { name: "star-accent", swatch: "bg-star-accent" },
      { name: "zenith", swatch: "bg-zenith" },
      { name: "horizon", swatch: "bg-horizon" },
    ],
  },
  {
    title: "Dusk (the live sky's sunset and twilight mix)",
    tokens: [
      { name: "dusk-glow", swatch: "bg-dusk-glow" },
      { name: "dusk-glow-horizon", swatch: "bg-dusk-glow-horizon" },
      { name: "dusk-twilight", swatch: "bg-dusk-twilight" },
      { name: "dusk-twilight-horizon", swatch: "bg-dusk-twilight-horizon" },
    ],
  },
];

const radii = [
  { name: "rounded-sm", swatch: "rounded-sm" },
  { name: "rounded-md", swatch: "rounded-md" },
  { name: "rounded-lg (controls)", swatch: "rounded-lg" },
  { name: "rounded-xl (dialog)", swatch: "rounded-xl" },
  { name: "rounded-2xl", swatch: "rounded-2xl" },
  { name: "rounded-full", swatch: "rounded-full" },
];

/** Where each of the 7 states is shown (the plan's contract). */
const stateContract = [
  { state: "default", where: "every component (the “default · live” cells are the real components)" },
  { state: "hover", where: "every interactive component (specimen + real hover on the live cell)" },
  { state: "focus-visible", where: "every control (specimen + real focus by Tab on the live cell)" },
  { state: "disabled", where: "every control" },
  { state: "error", where: "FormField invalid, Input / NativeSelect aria-invalid, Combobox, ServerError" },
  { state: "empty", where: "an empty Band, a Combobox with no match" },
  { state: "loading", where: "SubmitButton pending, Combobox loading" },
];

/*
 * The eight Button variants and the class each one takes on `:hover` (button.tsx). The hover specimen applies that
 * class directly (quiet's also mirrors `red:hover:decoration-2` as `red:decoration-2`); the focus-visible specimen applies the `focus-visible:` outline classes directly.
 */
const variants = [
  { variant: "default", label: "Primary", hover: "bg-primary/85" },
  { variant: "outline", label: "Outline", hover: "bg-accent" },
  { variant: "secondary", label: "Secondary", hover: "bg-accent" },
  { variant: "ghost", label: "Ghost", hover: "bg-accent" },
  { variant: "destructive", label: "Destructive", hover: "bg-destructive/10" },
  { variant: "hairline", label: "Hairline", hover: "border-primary-strong bg-accent" },
  { variant: "quiet", label: "Quiet", hover: "underline underline-offset-4 red:decoration-2" },
  { variant: "link", label: "Link", hover: "decoration-2" },
] as const;
// `hairline` wraps and is used at `sm`, `quiet` at `bare` (no horizontal padding), so their specimens render so too.
const sizeOf = (variant: (typeof variants)[number]["variant"]) =>
  variant === "quiet" ? "bare" : variant === "hairline" ? "sm" : "default";
const linkVariants = variants.filter(
  (v) =>
    v.variant === "default" ||
    v.variant === "outline" ||
    v.variant === "ghost" ||
    v.variant === "hairline" ||
    v.variant === "quiet",
);
// A hairline or quiet link while offline (`html[data-offline] [data-needs-network]`, global.css): muted ink on the
// control and its icon, no fill, no underline, a dashed `--border` (a quiet action has no border width, so none shows).
const offlineAction =
  "border-dashed border-border bg-transparent text-muted-foreground cursor-not-allowed [&_svg]:text-muted-foreground no-underline!";

const focusRing = "outline-2 outline-offset-2 outline-ring";
// The field look on `:focus-visible` (input.tsx `fieldClass`).
const fieldFocus = "border-ring ring-1 ring-ring";
// The field look on `:focus-visible` while `aria-invalid`.
const fieldFocusInvalid = "border-destructive ring-1 ring-destructive";

const bortleOptions = ([4, 5, 6] as const).map((value) => ({
  value: String(value),
  label: m.siteForm.bortleOption({ value: String(value), label: m.siteForm.bortleLabels[value] }),
}));

// Sample rows in the hub's row pattern. Static sample data, never a store.
const sampleSites = [
  { name: "Back garden", meta: ["52.23, 21.01", "Bortle 6", "Min 15°", "Europe/Warsaw (auto)"] },
  { name: "Dark-sky park", meta: ["49.27, 22.53", "Bortle 2", "Min 10°", "Europe/Warsaw (pinned)"] },
];
const rowLink =
  "-mx-2 flex min-h-11 flex-col justify-center rounded-lg px-2 py-3 transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring";

const submitIcon = createElement(Save, { className: "size-4", "aria-hidden": true });

/*
 * Tonight (tonight-nightfall). Static sample verdicts and a sample view, worded through Tonight's own formatter so
 * they follow the page's language; no store, no clock, no forecast.
 */
const fmt = createFormatter(locale);
const SAMPLE_ZONE = "Europe/Warsaw";
const SAMPLE_DATE = "2026-10-10";
const SAMPLE_ZONE_LABEL = zoneLabel(new Date(`${SAMPLE_DATE}T12:00:00Z`), SAMPLE_ZONE);
const MINUTE_MS = 60_000;

const goVerdict = { level: "go", reason: { kind: "clear-run", runHours: 7, cloudPct: 8 } } satisfies Verdict;
const marginalVerdict = {
  level: "marginal",
  reason: { kind: "clear-run", runHours: 3, cloudPct: 45 },
} satisfies Verdict;
const noGoVerdict = { level: "no-go", reason: { kind: "cloudy", bestRunHours: 1, minCloudPct: 82 } } satisfies Verdict;
const sampleWindow: TonightDarkWindow = { kind: "window", start: "19:42", end: "05:18" };
const freshForecast: ForecastStatus = { kind: "fresh", ageMs: 20 * MINUTE_MS };
const weatherNoGo: TonightExplanation = {
  kind: "weather-no-go",
  nextText: fmt.nextNightText({ kind: "found", date: "2026-10-12", verdict: marginalVerdict }),
};

interface SkySample {
  label: string;
  date: string;
  timeZone: string;
  verdict: Verdict;
  darkWindow: TonightDarkWindow;
  forecast: ForecastStatus;
  explanation: TonightExplanation | null;
}

const skySamples: SkySample[] = [
  {
    label: "go · clear",
    date: SAMPLE_DATE,
    timeZone: SAMPLE_ZONE,
    verdict: goVerdict,
    darkWindow: sampleWindow,
    forecast: freshForecast,
    explanation: null,
  },
  {
    label: "forecast fallback · stale saved copy (shown on phones too)",
    date: SAMPLE_DATE,
    timeZone: SAMPLE_ZONE,
    verdict: { level: "marginal", reason: { kind: "fallback-cap", runHours: 6, cloudPct: 12 } },
    darkWindow: sampleWindow,
    forecast: { kind: "fallback", ageMs: 5 * 60 * MINUTE_MS },
    explanation: null,
  },
  {
    label: "marginal · partly clear",
    date: SAMPLE_DATE,
    timeZone: SAMPLE_ZONE,
    verdict: marginalVerdict,
    darkWindow: sampleWindow,
    forecast: freshForecast,
    explanation: null,
  },
  {
    label: "no-go · cloudy, with the next clearer night",
    date: SAMPLE_DATE,
    timeZone: SAMPLE_ZONE,
    verdict: noGoVerdict,
    darkWindow: sampleWindow,
    forecast: freshForecast,
    explanation: weatherNoGo,
  },
  {
    label: "forecast none · no forecast",
    date: SAMPLE_DATE,
    timeZone: SAMPLE_ZONE,
    verdict: { level: "marginal", reason: { kind: "no-weather-data" } },
    darkWindow: sampleWindow,
    forecast: { kind: "none" },
    explanation: null,
  },
  {
    label: "forecast fresh · an hour of the dark window missing",
    date: SAMPLE_DATE,
    timeZone: SAMPLE_ZONE,
    verdict: { level: "marginal", reason: { kind: "missing-hours" } },
    darkWindow: sampleWindow,
    forecast: freshForecast,
    explanation: null,
  },
  {
    label: "no dark window · summer at 54° N",
    date: "2026-06-20",
    timeZone: SAMPLE_ZONE,
    verdict: { level: "no-go", reason: { kind: "no-darkness" } },
    darkWindow: { kind: "none" },
    forecast: freshForecast,
    explanation: {
      kind: "no-darkness",
      causeText: fmt.noDarknessCauseText({ latitudeDeg: 54.4, minSunAltitudeDeg: -12.2, thresholdDeg: -18, bortle: 3 }),
      returnText: fmt.darkReturnText(
        {
          date: "2026-08-03",
          window: { start: new Date("2026-08-03T21:58:00Z"), end: new Date("2026-08-04T00:36:00Z") },
        },
        SAMPLE_ZONE,
      ),
    },
  },
];

// The gear cards' specimens (TonightContent): one card per kind, with a select once there are two or more of a kind.
const gearItems = (count: number) =>
  ["Back garden", "Dark-sky park", "Balcony", "Rooftop"].slice(0, count).map((name, i) => ({
    id: `sample-site-${String(i + 1)}`,
    name,
  }));
const gearRowClass = "px-4";
const sampleTelescopeName = "150 mm reflector";
const oneItem = gearItems(1);
const twoItems = gearItems(2);
const fourItems = gearItems(4);
const sampleTelescopes = [
  { id: "sample-telescope-1", name: sampleTelescopeName },
  { id: "sample-telescope-2", name: "Dobsonian 200 mm" },
];

const skies = skySamples.map((sample) => ({
  label: sample.label,
  props: {
    level: sample.verdict.level,
    dateLabel: fmt.formatNightDate(sample.date),
    headline: fmt.skyHeadline(sample.verdict),
    text: fmt.verdictReasonText(sample.verdict),
    darkWindow: sample.darkWindow,
    zoneLabel: zoneLabel(new Date(`${sample.date}T12:00:00Z`), sample.timeZone),
    withSlider: false,
    forecastStatus: { kind: sample.forecast.kind, text: fmt.forecastStatusText(sample.forecast) },
    explanation: sample.explanation,
  },
}));

// The best targets, already in best-time order, as `summaryTargets` holds them: Messier objects and one Caldwell
// object (the Double Cluster, whose label is "NGC 869 / 884" while its key stays the space-free "NGC869").
const sampleTarget = (
  rank: number,
  object: { id: string; label: string; caldwell: number | null },
  commonName: string,
  constellation: string,
  bestTime: string,
  bestAt: number,
): TonightEntry => ({
  rank,
  id: object.id,
  label: object.label,
  caldwell: object.caldwell,
  commonName,
  constellation,
  windowStart: "19:42",
  windowEnd: "05:18",
  bestTime,
  bestAt,
  bestDirection: "S, 70°",
  pair: null,
  reason: "",
  seenText: null,
  notSeenYet: true,
});
const messierSample = (n: number) => ({ id: `M${n}`, label: `M${n}`, caldwell: null });
const sampleTargets = [
  sampleTarget(
    3,
    messierSample(13),
    "Great Globular Cluster in Hercules",
    "Her",
    "19:55",
    Date.UTC(2026, 9, 10, 17, 55),
  ),
  sampleTarget(1, messierSample(31), "Andromeda Galaxy", "And", "23:40", Date.UTC(2026, 9, 10, 21, 40)),
  sampleTarget(2, messierSample(45), "Pleiades", "Tau", "02:15", Date.UTC(2026, 9, 11, 0, 15)),
  sampleTarget(
    4,
    { id: "NGC869", label: "NGC 869 / 884", caldwell: 14 },
    "Double Cluster",
    "Per",
    "03:30",
    Date.UTC(2026, 9, 11, 1, 30),
  ),
];
// The Targets row specimen for "What to expect": M13 with an eyepiece pair, as a full-plan row shows it.
const expectSample = sampleTarget(
  1,
  messierSample(13),
  "Great Globular Cluster in Hercules",
  "Her",
  "19:55",
  Date.UTC(2026, 9, 10, 17, 55),
);
// The dashboard tile holds SUMMARY_TARGETS (3): the Double Cluster takes the place of M13.
const sampleSummaryTargets = sampleTargets.filter((entry) => entry.id !== "M13");

const sampleMoon: MoonDiscState = {
  time: "2026-10-10T21:40:00Z",
  illuminatedFraction: 0.63,
  waxing: true,
  band: "waxing-gibbous",
  brightLimbAngleDeg: 270,
  librationLatDeg: 0,
  librationLonDeg: 0,
};

const samplePlanet = (key: "jupiter" | "saturn", bestTime: string, bestAt: number): TonightPlanetEntry => ({
  key,
  name: m.targets.planet[key],
  windowStart: "19:42",
  windowEnd: "05:18",
  bestTime,
  bestAt,
  bestDirection: "S, 45°",
  magnitudeText: "",
  sizeText: "",
  phaseText: null,
  ringText: null,
  eyepiece: null,
  reason: m.tonight.planets.reason.high.night({ time: bestTime }),
  note: "",
  seenText: null,
  notSeenYet: true,
});

// Nights 1-3 carry a verdict (go, marginal, no-go), nights 4-7 an outlook; `null` is a night without a clear share.
const NIGHT_VERDICTS = [goVerdict, marginalVerdict, noGoVerdict];
const sampleNights = (clear: (number | null)[]): TonightNight[] =>
  clear.map((clearPct, i) => {
    const date = `2026-10-${String(10 + i)}`;
    const base = { date, label: fmt.formatShortNightDate(date), darkText: "19:42–05:18", moonText: "", clearPct };
    const verdict = NIGHT_VERDICTS.at(i);
    return verdict
      ? { ...base, kind: "verdict", level: verdict.level, headline: fmt.skyHeadline(verdict), reasonText: null }
      : { ...base, kind: "outlook", cloudText: null };
  });

// The sky events' specimens (sky-events): hand-made lines for the tile and the verdict, and the engine's real list for
// a fixed site and night.
const eventSpecimens = eventSamples(locale);

const summaryView: TonightView = {
  siteId: "sample-site",
  telescopeId: "sample-telescope",
  siteName: "Back garden",
  telescopeName: "150 mm reflector",
  date: SAMPLE_DATE,
  dateLabel: fmt.formatNightDate(SAMPLE_DATE),
  timeZone: SAMPLE_ZONE,
  zoneLabel: SAMPLE_ZONE_LABEL,
  verdict: goVerdict,
  headline: fmt.skyHeadline(goVerdict),
  verdictText: fmt.verdictReasonText(goVerdict),
  darkWindow: sampleWindow,
  darkStart: null,
  validUntil: new Date(`${SAMPLE_DATE}T23:59:00Z`),
  forecastFetchedAt: null,
  ranking: {
    clearedCount: 14,
    clearedText: fmt.clearedLine(14),
    entries: sampleTargets,
    washedOutCount: 0,
    washedOutText: null,
    washedOutEntries: [],
  },
  summaryTargets: sampleSummaryTargets,
  hasEyepieces: false,
  forecastStatus: { kind: freshForecast.kind, text: fmt.forecastStatusText(freshForecast) },
  explanation: null,
  nights: sampleNights([92, 55, 14, 30, 70, 85, 60]),
  planetsAbsentText: null,
  solarSystem: {
    windowText: "",
    weatherText: null,
    entries: [
      samplePlanet("jupiter", "01:30", Date.UTC(2026, 9, 10, 23, 30)),
      samplePlanet("saturn", "21:50", Date.UTC(2026, 9, 10, 19, 50)),
    ],
    noneText: null,
  },
  moonCard: {
    window: { start: "19:42", end: "05:18" },
    windowKind: "dark",
    states: [sampleMoon],
    timeLabels: ["23:40"],
    initialIndex: 0,
    phaseText: fmt.moonPhaseText(sampleMoon.band, sampleMoon.illuminatedFraction),
    upText: fmt.moonUpText(
      {
        kind: "part",
        spans: [{ start: new Date("2026-10-10T19:10:00Z"), end: new Date("2026-10-11T03:18:00Z") }],
        upAtStart: false,
      },
      SAMPLE_ZONE,
    ),
    faintText: null,
    target: null,
  },
  skyView: null,
  sessionPlan: null,
  skyEvents: eventSpecimens.tiles[2].events,
  reachable: null,
};
// One band only (the Moon band is left out so its disc's clip id stays unique on the page).
const targetsOnlyView: TonightView = {
  ...summaryView,
  moonCard: null,
  solarSystem: null,
  planetsAbsentText: m.tonight.planets.absent.unavailable,
  nights: [],
};
const noTargetsView: TonightView = {
  ...targetsOnlyView,
  verdict: noGoVerdict,
  headline: fmt.skyHeadline(noGoVerdict),
  verdictText: fmt.verdictReasonText(noGoVerdict),
  ranking: null,
  summaryTargets: [],
  explanation: weatherNoGo,
};
const nullBarsView: TonightView = { ...targetsOnlyView, nights: sampleNights([88, null, 40, 12, null, 65, 95]) };

/*
 * The live sky (interactive-sky): a real `skyView` from `buildTonight` for a fixed site and night (Warsaw, the night of
 * 10 October 2026, a clear forecast), shown at three Sun altitudes by starting the slider at the frame nearest each.
 * Built server-side on every load of this dev page, never hand-written.
 */
const PANORAMA_SITE: SiteRecord = {
  id: "sample-site",
  name: "Back garden",
  latitudeDeg: 52.23,
  longitudeDeg: 21.01,
  bortle: 4,
  minAltitudeDeg: 15,
  timeZone: SAMPLE_ZONE,
  timeZoneSource: "auto",
  createdAt: "2026-09-01T00:00:00Z",
};
const PANORAMA_NOW = new Date("2026-10-10T18:00:00Z");
const panoramaForecast: ForecastResult = {
  forecast: {
    hours: Array.from({ length: 48 }, (_, i) => ({
      start: new Date(Date.UTC(2026, 9, 10) + i * 60 * MINUTE_MS),
      cloudCoverPct: 5,
      humidityPct: 60,
    })),
  },
  fetchedAt: new Date(PANORAMA_NOW.getTime() - 20 * MINUTE_MS),
  fallback: false,
};
const panoramaView = buildTonight(
  {
    site: PANORAMA_SITE,
    telescope: { id: "sample-telescope", name: "150 mm reflector", apertureMm: 150, focalLengthMm: 750, createdAt: "" },
    eyepieces: [],
    forecast: panoramaForecast,
    now: PANORAMA_NOW,
  },
  locale,
  { withSkyView: true, withSessionPlan: true },
);
const panoramaSky = panoramaView.skyView;
// The same night's Session plan: long deep-sky windows, short planet and Moon ones, and a planet up most of the night.
const panoramaPlan = panoramaView.sessionPlan;
// The plan editor's specimens (adjustable-session-plan): the same night, suggested and with a saved list applied.
const planSpecimens = planSamples(locale);
const planText = m.tonight.pages.plan;
// The editor's status region (F6) after a Move, a Remove and an Add on the saved sample list.
const planStatus = planSpecimens.edited ? planStatusSamples(planSpecimens.edited.editor, locale) : [];
const frameNearestSun = (altitudeDeg: number) =>
  panoramaSky
    ? panoramaSky.sunAltDeg.reduce(
        (best, alt, i) =>
          Math.abs(alt - altitudeDeg) < Math.abs(panoramaSky.sunAltDeg[best] - altitudeDeg) ? i : best,
        0,
      )
    : 0;
const panoramas = panoramaSky
  ? [
      { label: "sunset · Sun near 0°, full glow", index: frameNearestSun(0) },
      { label: "mid-twilight · Sun near −9°", index: frameNearestSun(-9) },
      { label: "deep night · the Sun at its lowest", index: frameNearestSun(-90) },
    ].map((sample) => ({
      label: `${sample.label} (${String(panoramaSky.sunAltDeg[sample.index])}°)`,
      view: { ...panoramaSky, initialIndex: sample.index },
    }))
  : [];

/*
 * The tiles are links inside TonightTiles, so the specimens reach them from a wrapper with the
 * child variant (wrapper > tiles root > tile) and apply the classes the tile takes on `:hover` /
 * `:focus-visible`. `inert` keeps the specimen links out of the tab order.
 */
const summaryHover = "*:*:bg-accent";
const summaryFocus = "*:*:outline-2 *:*:-outline-offset-2 *:*:outline-ring";
// The Tile specimens sit one level up: wrapper > tile (the tile is the `<a>` itself).
const tileHover = "*:bg-accent";
const tileFocus = "*:outline-2 *:-outline-offset-2 *:outline-ring";

// Shared page classes (token classes and type roles only).
// The progress checklists' specimens (observing-progress): a log with a few seen objects, and an empty one.
const progressSome = observingProgress([
  { target: "M1", night: "2026-08-02", rating: 3 },
  { target: "M31", night: "2026-09-12", rating: 4 },
  { target: "M31", night: "2026-08-20", rating: 5 },
  { target: "M110", night: "2026-09-12", rating: 3 },
  { target: "M13", night: "2026-09-01", rating: 2 },
  { target: "NGC7000", night: "2026-09-05", rating: 5 },
]);
const progressNone = observingProgress([]);
// The milestones' specimens (observing-milestones): none reached, and some (two derived from the log, the Moon from the
// stored record alone, as after its entry was deleted).
const milestonesNone = milestonesOf(progressNone);
const milestonesSome = withStored(milestonesOf(progressSome), new Map([["first-moon", "2026-08-20"]]));

// The celebration dialog's specimens (Phase 6): one milestone, and three (a save that reaches several at once).
const celebrateOne: MilestoneKey[] = ["first-galaxy"];
const celebrateThree: MilestoneKey[] = ["first-planet", "all-planets", "messier-10"];

// The finder chart's specimens (finder-chart): real engine charts from the real star file at a fixed public point.
const finder = await finderSamples(locale);

/*
 * The fact rhythm's specimens (ui-fact-rhythm): the rhythm roles, the stacked stat pair at the real widths of a Targets
 * row at 320 px (English and Polish, the longest real values), the facts, the icon map, and the chosen item rhythm (20 px
 * on each side of the rule, owner, 2026-10-15). Fixed-width frames (`w-72` = 288 px, the 320 px column), so they render
 * the same at any width.
 */
const rhythmRoles = [
  { name: "line", px: "8 px", bar: "h-line", use: "between the lines of one group" },
  { name: "group", px: "24 px", bar: "h-group", use: "between the groups of one item; the hairline's padding" },
  {
    name: "item",
    px: "20 px",
    bar: "h-item",
    use: "each side of the rule between two items holding groups (40 px between two items)",
  },
];
const STAT_WINDOW = "20:51–07:10";
const STAT_BEST = "03:21";
const STAT_BEST_DIRECTION = "NNE, 87°";
const statLocales = (["en", "pl"] as const).map((tag) => {
  const messages = getMessages(tag);
  return {
    tag,
    label: tag.toUpperCase(),
    object: messages.tonight.object,
    planets: messages.tonight.planets,
    detailLine: createFormatter(tag).objectDetailLine(null, "Her"),
  };
});
// TargetsPageContent's scroll region of the other objects, in the 288 px column: its border and px-3 (ObjectRow's body
// then indents by pl-10, which leaves the pair about 222 px).
const rowRegionClass = "w-72 rounded-lg border border-border px-3 py-1";
const sampleEyepieces = { finding: "25 mm Plössl", findingX: "30", detail: "10 mm Plössl", detailX: "75" };
const sampleReason = m.tonight.reason.line({
  lead: m.tonight.reason.moon.lead,
  second: m.tonight.reason.brightness.follow({ aperture: "150" }),
});
const noFacts: string[] = [];
const factIconGroups = [
  { title: "Facts · FACT_ICONS", icons: FACT_KINDS.map((kind) => ({ name: kind, Icon: FACT_ICONS[kind] })) },
  {
    title: "Event kinds · EVENT_KIND_ICONS",
    icons: Object.entries(EVENT_KIND_ICONS).map(([name, Icon]) => ({ name, Icon })),
  },
  {
    title: "Visibility marks · VISIBILITY_MARK_ICONS",
    icons: Object.entries(VISIBILITY_MARK_ICONS).map(([name, Icon]) => ({ name, Icon })),
  },
];
const rhythmRows = [
  { rank: 1, id: "M13", commonName: "Great Globular Cluster in Hercules", constellation: "Her" },
  { rank: 2, id: "M31", commonName: "Andromeda Galaxy", constellation: "And" },
].map((row) => ({
  ...row,
  commonName: localCommonName(row.id, row.commonName, locale),
  detailLine: fmt.objectDetailLine(null, row.constellation),
}));
// "What to expect"'s second row (ui-fact-rhythm): M13 again, now with a find/detail pair and a reason, so every fact
// of a Targets row shows. The shared `sampleTarget` (also the tiles') stays as it is.
const expectPairSample: TonightEntry = {
  ...expectSample,
  pair: {
    kind: "pair",
    finding: { name: sampleEyepieces.finding, magnification: Number(sampleEyepieces.findingX) },
    detail: { name: sampleEyepieces.detail, magnification: Number(sampleEyepieces.detailX) },
  },
  reason: sampleReason,
};
// The Moon card with the Moon as a target (ui-fact-rhythm): the night at capture may not have one. The specimens spread
// two states into it, so the slider renders its range as on the real page, and show it with and without the target to
// measure the skeleton's `moon` layout against both nights. Each island gets its own clip-id prefix; MoonCard's own
// `#moon` / `#moon-heading` ids repeat on this dev-only page.
const moonCardUp = {
  kind: "part" as const,
  spans: [{ start: new Date("2026-10-10T19:10:00Z"), end: new Date("2026-10-11T03:18:00Z") }],
  upAtStart: false,
};
const moonCardWashedOut = 4;
const moonTargetCard: NonNullable<TonightView["moonCard"]> = {
  window: { start: "19:42", end: "05:18" },
  windowKind: "dark",
  states: [sampleMoon],
  timeLabels: ["23:40"],
  initialIndex: 0,
  phaseText: fmt.moonPhaseText(sampleMoon.band, sampleMoon.illuminatedFraction),
  upText: fmt.moonUpText(moonCardUp, SAMPLE_ZONE),
  faintText: fmt.moonFaintText(moonCardUp, moonCardWashedOut, SAMPLE_ZONE),
  target: {
    key: "moon",
    name: m.targets.moon,
    windowStart: "19:42",
    windowEnd: "03:18",
    bestTime: "23:10",
    bestAt: Date.UTC(2026, 9, 10, 21, 10),
    bestDirection: "SE, 42°",
    band: sampleMoon.band,
    wholeDisc: { name: sampleEyepieces.finding, magnification: Number(sampleEyepieces.findingX) },
    wholeDiscFits: true,
    detail: { name: sampleEyepieces.detail, magnification: Number(sampleEyepieces.detailX) },
    reason: m.tonight.moon.reason.line({ altitude: "42", time: "23:10", timing: m.tonight.moon.reason.timing.night }),
    note: m.tonight.moon.note[sampleMoon.band],
    seenText: null,
    notSeenYet: true,
  },
};
const moonCardWashedOutLink = {
  href: "#c-moon-card",
  label: plural(locale, moonCardWashedOut, m.tonight.pages.seeWashedOut)({ count: String(moonCardWashedOut) }),
};

// App icon proposals (app-icon): the round-2 candidate icons (round 1 stays in the evidence folder), read as text from the change's evidence folder (in
// `context/changes/` now, `context/archive/` once archived; a glob, so the page still builds when neither matches)
// and drawn as `<img>` data URIs, so red mode filters them like any image. Server-side `?raw` strings only: nothing
// is emitted as a client asset, so the service worker never precaches a proposal.
const appIconFiles = import.meta.glob<string>("/context/*/app-icon/evidence/icon-proposals/*/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});
const appIconSvg = (proposal: string, file: string) => {
  const entry = Object.entries(appIconFiles).find(([path]) => path.endsWith(`/${proposal}/${file}`));
  return entry ? `data:image/svg+xml,${encodeURIComponent(entry[1])}` : null;
};
const appIconProposals = [
  {
    dir: "r2-1-white-star-dusk",
    name: "R2-1 · White star, dusk",
    note: "Round 1's white star (primary) and primary-strong companion over round 3's dusk-glow horizon and ground.",
  },
  {
    dir: "r2-2-gold-star-navy",
    name: "R2-2 · Gold star, navy",
    note: "The horizon proposal's gold star (star-accent base) with a primary companion on the plain zenith-to-horizon tile.",
  },
  {
    dir: "r2-3-rising-star",
    name: "R2-3 · Rising star",
    note: "One large white star (primary) rising: its lower arm sets behind a low ridge (background) under the dusk glow.",
  },
  {
    dir: "r2-4-gold-star-dusk",
    name: "R2-4 · Gold star, dusk",
    note: "The horizon proposal with the companion kept: gold star, primary-strong companion, dusk-glow horizon.",
  },
].map((proposal) => ({
  ...proposal,
  favicon: appIconSvg(proposal.dir, "favicon.svg"),
  icon: appIconSvg(proposal.dir, "icon.svg"),
  maskable: appIconSvg(proposal.dir, "maskable.svg"),
}));
// favicon.svg at the tab sizes, icon.svg at the home-screen sizes, maskable.svg in a launcher's circle crop.
const appIconSizes = [
  { label: "16 · favicon", file: "favicon", size: "size-4" },
  { label: "32 · favicon", file: "favicon", size: "size-8" },
  { label: "64 · icon", file: "icon", size: "size-16" },
  { label: "128 · icon", file: "icon", size: "size-32" },
  { label: "128 · maskable, circle", file: "maskable", size: "size-32 rounded-full" },
] as const;

const block = "flex flex-col gap-4 border-t border-border pt-6 first:border-t-0 first:pt-0";
const blockTitle = "font-display text-title font-semibold text-heading";
const blockNote = "text-sm text-muted-foreground";
const grid = "grid gap-x-6 gap-y-5 sm:grid-cols-2 lg:grid-cols-3";
const cell = "flex min-w-0 flex-col gap-2";
const wideCell = "flex min-w-0 flex-col gap-2 sm:col-span-2 lg:col-span-3";
const stateLabel = "font-mono text-sm text-muted-foreground";
const notApplicable = "text-sm text-faint";
const row = "flex flex-wrap items-center gap-3";
const groupTitle = "text-label font-semibold text-muted-foreground";
---

<Layout title="Design · Sidereus">
  <div class="min-h-screen w-full bg-background text-foreground">
    <div class="border-b border-border bg-linear-to-b from-zenith to-horizon">
      <div class="mx-auto flex h-16 w-full max-w-5xl items-center gap-4 px-4 pt-4 sm:px-8 sm:pt-6">
        <span class="flex shrink-0 items-center gap-2.5">
          <svg viewBox="0 0 24 24" class="size-5.5 text-primary" fill="currentColor" aria-hidden="true">
            <path d="M12 2 13.8 10.2 22 12l-8.2 1.8L12 22l-1.8-8.2L2 12l8.2-1.8Z"></path>
          </svg>
          <span class="font-display text-title font-semibold text-heading">{m.common.appName}</span>
        </span>
        <div class="ml-auto">
          <TopbarControls theme={theme} locale={locale} email={null} client:load />
        </div>
      </div>
      <div class="mx-auto w-full max-w-5xl px-4 pt-6 pb-8 sm:px-8 sm:pt-10 sm:pb-12">
        <PageHeader
          title="Kitchen sink"
          subtitle="Dev only. Every colour on this page is a theme token; switch the theme above to review dark, light and red."
        >
          <a slot="actions" href="#components-heading" class:list={buttonVariants({ variant: "outline" })}>
            State matrix
          </a>
        </PageHeader>
      </div>
    </div>

    <main class="mx-auto w-full max-w-5xl px-4 py-8 sm:px-8 sm:py-12">
      <Band headingId="tokens-heading" heading="Tokens">
        <div class="flex flex-col gap-6">
          {tokenGroups.map((group) => (
            <div class="flex flex-col gap-3">
              <h3 class:list={groupTitle}>{group.title}</h3>
              <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
                {group.tokens.map((token) => (
                  <li class="flex min-w-0 flex-col gap-1.5">
                    <span class:list={["h-14 rounded-lg border border-border", token.swatch]} aria-hidden="true" />
                    <span class="font-mono text-xs break-all text-heading">--{token.name}</span>
                    <span class="font-mono text-xs text-muted-foreground" data-token-value={token.name} />
                  </li>
                ))}
              </ul>
            </div>
          ))}
          <div class="flex flex-col gap-3">
            <h3 class:list={groupTitle}>Sky gradient</h3>
            <div class="flex h-28 items-end rounded-lg border-b border-border bg-linear-to-b from-zenith to-horizon px-4 pb-3">
              <span class="font-mono text-xs text-heading">--zenith → --horizon</span>
            </div>
          </div>
        </div>
      </Band>

      <Band headingId="type-heading" heading="Type and radius">
        <div class="flex flex-col gap-6">
          <div class="flex flex-col gap-4">
            <p class="font-display text-display font-semibold break-words text-heading">text-display · My gear</p>
            <p class="font-display text-title font-semibold text-heading">text-title · M31 · Andromeda Galaxy</p>
            <p class="text-label font-semibold text-heading">text-label · Field label, button, row meta</p>
            <p class="text-caption font-semibold text-heading">
              text-caption · M31 · Jupiter · <span class="font-normal text-muted-foreground">Vega, Deneb</span> (the
              live sky's body and star labels)
            </p>
            <p class="text-body text-foreground">
              text-body · Up for 7 h 50 min of the dark window · bright for your 150 mm. Find with{" "}
              <span class="font-semibold text-heading">25 mm Plössl</span>.
            </p>
            <p class="text-body text-foreground">
              font-mono (Archivo, tabular figures) · Dark from <span class="font-mono text-heading">19:42</span> to{" "}
              <span class="font-mono text-heading">05:18</span> · best{" "}
              <span class="font-mono text-heading">23:40 · S, 78°</span>
            </p>
            <p class="text-sm text-muted-foreground">Muted · 150 mm reflector · times in Europe/Warsaw</p>
            <p class="text-xs text-faint">
              Faint · Object data: OpenNGC (CC BY-SA 4.0) · Weather: Open-Meteo (CC BY 4.0)
            </p>
            <p class="text-body text-foreground">
              Polish glyphs · Zażółć gęślą jaźń ·{" "}
              <span class="font-display font-semibold text-heading">Łabędź, Wężownik</span>
            </p>
          </div>
          <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
            {radii.map((radius) => (
              <li class="flex min-w-0 flex-col gap-1.5">
                <span class:list={["h-14 border border-border bg-surface", radius.swatch]} aria-hidden="true" />
                <span class="font-mono text-xs text-heading">{radius.name}</span>
              </li>
            ))}
          </ul>
          <!-- The overline and the rhythm roles (ui-fact-rhythm) -->
          <div class="flex flex-col gap-3">
            <h3 id="t-rhythm-roles" class:list={groupTitle}>
              Overline and rhythm roles
            </h3>
            <p class="text-overline text-muted-foreground">
              text-overline · Night of Wednesday, 21 October 2026 (a group label: muted, sentence case)
            </p>
            <p class="text-overline text-muted-foreground">text-overline · Noc: środa, 21 października 2026</p>
            <ul class="flex flex-col gap-3">
              {rhythmRoles.map((role) => (
                <li class="flex min-w-0 items-center gap-3">
                  <span
                    class:list={["w-16 shrink-0 rounded-sm bg-primary", role.bar]}
                    data-role-sample={role.name}
                    aria-hidden="true"
                  />
                  <span class="min-w-0 text-sm text-muted-foreground">
                    <span class="font-mono text-heading">
                      {role.name} · {role.px}
                    </span>{" "}
                    · {role.use}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </Band>

      <Band headingId="app-icon-heading" heading="App icon proposals">
        <div class="flex flex-col gap-6" data-app-icon-proposals>
          <p class:list={blockNote}>
            Round-2 proposals for the app-icon change, not in use: the home-screen icons are still generated from
            public/pwa-icon.svg and the tab still shows public/favicon.png. Literal hex inside each SVG (an icon cannot
            read the tokens); the files, their PNG previews and round 1 live in
            context/changes/app-icon/evidence/icon-proposals/.
          </p>
          {appIconProposals.map((proposal) => (
            <section class="flex flex-col gap-3" aria-labelledby={`app-icon-${proposal.dir}`}>
              <h3 id={`app-icon-${proposal.dir}`} class:list={groupTitle}>
                {proposal.name}
              </h3>
              <p class:list={blockNote}>{proposal.note}</p>
              <ul class="flex flex-wrap items-end gap-6">
                {appIconSizes.map((spec) => {
                  const src = proposal[spec.file];
                  return (
                    <li class="flex flex-col items-center gap-2">
                      {src ? (
                        <img src={src} alt="" class:list={["shrink-0", spec.size]} />
                      ) : (
                        <span class:list={["shrink-0 rounded-lg border border-dashed border-border", spec.size]} />
                      )}
                      <span class:list={stateLabel}>{spec.label}</span>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
        </div>
      </Band>

      <Band headingId="components-heading" heading="Components × states">
        <div class="flex flex-col gap-8">
          <div class="flex flex-col gap-3">
            <dl class="grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2">
              {stateContract.map((entry) => (
                <div class="flex min-w-0 flex-wrap gap-x-2">
                  <dt class="font-mono font-semibold text-heading">{entry.state}</dt>
                  <dd class="text-muted-foreground">{entry.where}</dd>
                </div>
              ))}
            </dl>
            <p class:list={blockNote}>
              Skeletons: N/A for /gear. It is server-rendered and has no loading state besides form submission.
            </p>
          </div>

          <div class="flex flex-col gap-10">
            <!-- Button -->
            <section class:list={block} aria-labelledby="c-button">
              <h3 id="c-button" class:list={blockTitle}>
                Button
              </h3>
              <div class:list={grid}>
                <div class:list={wideCell}>
                  <p class:list={stateLabel}>default · live</p>
                  <div class:list={row}>
                    {variants.map((v) => (
                      <Button type="button" variant={v.variant} size={sizeOf(v.variant)}>
                        {v.label}
                      </Button>
                    ))}
                  </div>
                </div>
                <div class:list={wideCell}>
                  <p class:list={stateLabel}>hover · specimen</p>
                  <div class:list={row}>
                    {variants.map((v) => (
                      <Button
                        type="button"
                        variant={v.variant}
                        size={sizeOf(v.variant)}
                        className={v.hover}
                        tabIndex={-1}
                      >
                        {v.label}
                      </Button>
                    ))}
                  </div>
                </div>
                <div class:list={wideCell}>
                  <p class:list={stateLabel}>focus-visible · specimen</p>
                  <div class:list={row}>
                    {variants.map((v) => (
                      <Button
                        type="button"
                        variant={v.variant}
                        size={sizeOf(v.variant)}
                        className={focusRing}
                        tabIndex={-1}
                      >
                        {v.label}
                      </Button>
                    ))}
                  </div>
                </div>
                <div class:list={wideCell}>
                  <p class:list={stateLabel}>disabled</p>
                  <div class:list={row}>
                    {variants.map((v) => (
                      <Button type="button" variant={v.variant} size={sizeOf(v.variant)} disabled>
                        {v.label}
                      </Button>
                    ))}
                  </div>
                </div>
              </div>
              <p class:list={blockNote}>
                A disabled link is only ever the offline <code>aria-disabled</code> state (see the Link-button offline
                specimens): <code>disabled</code> exists on <code>&lt;button&gt;</code> only.
              </p>
              <p class:list={notApplicable}>error, empty — N/A · loading — see SubmitButton</p>
            </section>

            <!-- Link-button -->
            <section class:list={block} aria-labelledby="c-link-button">
              <h3 id="c-link-button" class:list={blockTitle}>
                Link-button (buttonVariants on an a)
              </h3>
              <div class:list={grid}>
                <div class:list={cell}>
                  <p class:list={stateLabel}>default · live</p>
                  <div class:list={row}>
                    {linkVariants.map((v) => (
                      <a
                        href="#c-link-button"
                        class:list={buttonVariants({ variant: v.variant, size: sizeOf(v.variant) })}
                      >
                        <Plus aria-hidden="true" />
