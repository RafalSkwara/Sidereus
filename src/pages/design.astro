<script>
  // Print each token's resolved value next to its swatch, and refresh it when the theme flips.
  function showTokenValues() {
    const styles = getComputedStyle(document.documentElement);
    document.querySelectorAll<HTMLElement>("[data-token-value]").forEach((el) => {
      el.textContent = styles.getPropertyValue(`--${el.dataset.tokenValue ?? ""}`).trim();
    });
  }
  showTokenValues();
  new MutationObserver(showTokenValues).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });
</script>
