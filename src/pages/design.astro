              </div>
              <div class:list={cell}>
                <p class:list={stateLabel}>
                  default · every fact of a row: what you'll see, the find/detail pair and why (ObjectDetails)
                </p>
                <div id="c-expect-details-pair" class="max-w-md rounded-lg border border-border p-4">
                  <ObjectDetails
                    entry={expectPairSample}
                    logHref="/design"
                    finderHref="/design"
                    expectation={{ key: "globularResolved", text: m.tonight.expect.phrase.globularResolved }}
                  />
                </div>
              </div>
              <div class:list={cell}>
                <p class:list={stateLabel}>locked · a free account, under the Targets count</p>
                <div id="c-expect-locked" class="max-w-md rounded-lg border border-border p-4">
                  <p class="flex items-start gap-2 text-label text-muted-foreground">
                    <Lock className="mt-0.5 size-4 shrink-0" aria-hidden="true" />
                    <span class="min-w-0">{m.tonight.expect.locked}</span>
                  </p>
                </div>
              </div>
            </div>
            <p class:list={notApplicable}>
              hover, focus-visible, active, disabled — N/A (a line of text: no control) · error — N/A (a failed plan
              read renders neither line) · empty — N/A (an unknown object has no line) · loading — N/A (the line arrives
              with its island)
            </p>
          </section>
        </div>
      </Band>

      <footer class="mt-12 border-t border-border pt-4 text-xs text-faint">
        Object data: OpenNGC (CC BY-SA 4.0) · Weather: Open-Meteo (CC BY 4.0)
      </footer>
    </main>
  </div>
</Layout>

<script>
  // Print each token's resolved value next to its swatch, and refresh it when the theme flips.
  function showTokenValues() {
    const styles = getComputedStyle(document.documentElement);
    document.querySelectorAll<HTMLElement>("[data-token-value]").forEach((el) => {
      el.textContent = styles.getPropertyValue(`--${el.dataset.tokenValue ?? ""}`).trim();
    });
  }
  showTokenValues();
  new MutationObserver(showTokenValues).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });
</script>
