---
// Dev-only kitchen sink for the Nightfall design system (visual-redesign). Not linked from anywhere and not gated:
// it 404s outside `npm run dev`. It shows the tokens, the type roles and every shared component in the 7-state
// matrix, built from token classes only (no arbitrary values, no literal colours), with static sample data and no
// stores. Hover and focus-visible cannot be forced on a static page, so those cells are labelled specimens that
// apply the classes the component uses on `:hover` / `:focus-visible`; the "default · live" cells are the real
// components, so real hover and real focus (Tab) can be checked there. The Tonight band shows Tonight's sky, tiles
// and skeleton (tonight-nightfall) the same way, plus the focused pages' slim sky and its skeleton (tonight-dashboard).
import { createElement } from "react";
import { Plus, Save } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import TopbarControls from "@/components/TopbarControls";
import { Button, buttonVariants } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { NativeSelect, NativeSelectOption } from "@/components/ui/native-select";
import PageHeader from "@/components/ui/PageHeader.astro";
import Band from "@/components/ui/Band.astro";
import BackLink from "@/components/ui/BackLink.astro";
import Notice from "@/components/ui/Notice.astro";
import { FormField } from "@/components/forms/FormField";
import { ServerError } from "@/components/forms/ServerError";
import { SubmitButton } from "@/components/forms/SubmitButton";
import DeleteButton from "@/components/gear/DeleteButton";
import TonightPageSkeleton from "@/components/tonight/TonightPageSkeleton.astro";
import TonightPageSky from "@/components/tonight/TonightPageSky.astro";
import TonightSkeleton from "@/components/tonight/TonightSkeleton.astro";
import TonightSky from "@/components/tonight/TonightSky.astro";
import TonightTiles from "@/components/tonight/TonightTiles.astro";
import VerdictCard from "@/components/tonight/VerdictCard.astro";
import { getMessages } from "@/i18n";
import type { MoonDiscState, Verdict } from "@/lib/engine";
import { OUTLOOK_NIGHTS } from "@/lib/engine/parameters";
import type {
  TonightDarkWindow,
  TonightEntry,
  TonightExplanation,
  TonightNight,
  TonightPlanetEntry,
  TonightView,
} from "@/lib/tonight/build";
import { createFormatter, type ForecastStatus } from "@/lib/tonight/format";
import { cn } from "@/lib/utils";

// Dev only: anywhere else the page is a bare 404 and renders nothing.
if (!import.meta.env.DEV) return new Response(null, { status: 404 });

const { theme, locale } = Astro.locals;
const m = getMessages(locale);

const tokenGroups = [
  {
    title: "Surfaces",
    tokens: [
      { name: "background", swatch: "bg-background" },
      { name: "surface", swatch: "bg-surface" },
      { name: "card", swatch: "bg-card" },
      { name: "muted", swatch: "bg-muted" },
      { name: "secondary", swatch: "bg-secondary" },
      { name: "accent", swatch: "bg-accent" },
      { name: "border", swatch: "bg-border" },
      { name: "input", swatch: "bg-input" },
    ],
  },
  {
    title: "Text",
    tokens: [
      { name: "heading", swatch: "bg-heading" },
      { name: "foreground", swatch: "bg-foreground" },
      { name: "muted-foreground", swatch: "bg-muted-foreground" },
      { name: "faint", swatch: "bg-faint" },
      { name: "accent-foreground", swatch: "bg-accent-foreground" },
      { name: "secondary-foreground", swatch: "bg-secondary-foreground" },
    ],
  },
  {
    title: "Brand and focus",
    tokens: [
      { name: "primary", swatch: "bg-primary" },
      { name: "primary-foreground", swatch: "bg-primary-foreground" },
      { name: "primary-strong", swatch: "bg-primary-strong" },
      { name: "ring", swatch: "bg-ring" },
      { name: "selected", swatch: "bg-selected" },
      { name: "selected-foreground", swatch: "bg-selected-foreground" },
    ],
  },
  {
    title: "Verdicts",
    tokens: [
      { name: "go", swatch: "bg-go" },
      { name: "go-surface", swatch: "bg-go-surface" },
      { name: "go-border", swatch: "bg-go-border" },
      { name: "marginal", swatch: "bg-marginal" },
      { name: "marginal-surface", swatch: "bg-marginal-surface" },
      { name: "marginal-border", swatch: "bg-marginal-border" },
      { name: "no-go", swatch: "bg-no-go" },
      { name: "no-go-surface", swatch: "bg-no-go-surface" },
      { name: "no-go-border", swatch: "bg-no-go-border" },
    ],
  },
  {
    title: "Status and sky",
    tokens: [
      { name: "destructive", swatch: "bg-destructive" },
      { name: "destructive-foreground", swatch: "bg-destructive-foreground" },
      { name: "warning", swatch: "bg-warning" },
      { name: "success", swatch: "bg-success" },
      { name: "star", swatch: "bg-star" },
      { name: "star-accent", swatch: "bg-star-accent" },
      { name: "zenith", swatch: "bg-zenith" },
      { name: "horizon", swatch: "bg-horizon" },
    ],
  },
];

const radii = [
  { name: "rounded-sm", swatch: "rounded-sm" },
  { name: "rounded-md", swatch: "rounded-md" },
  { name: "rounded-lg (controls)", swatch: "rounded-lg" },
  { name: "rounded-xl (dialog)", swatch: "rounded-xl" },
  { name: "rounded-2xl", swatch: "rounded-2xl" },
  { name: "rounded-full", swatch: "rounded-full" },
];

/** Where each of the 7 states is shown (the plan's contract). */
const stateContract = [
  { state: "default", where: "every component (the “default · live” cells are the real components)" },
  { state: "hover", where: "every interactive component (specimen + real hover on the live cell)" },
  { state: "focus-visible", where: "every control (specimen + real focus by Tab on the live cell)" },
  { state: "disabled", where: "every control" },
  { state: "error", where: "FormField invalid, Input / NativeSelect aria-invalid, ServerError" },
  { state: "empty", where: "an empty Band" },
  { state: "loading", where: "SubmitButton pending" },
];

/*
 * The six Button variants and the class each one takes on `:hover` (button.tsx). The hover specimen applies that
 * class directly; the focus-visible specimen applies the `focus-visible:` outline classes directly.
 */
const variants = [
  { variant: "default", label: "Primary", hover: "bg-primary/85" },
  { variant: "outline", label: "Outline", hover: "bg-accent" },
  { variant: "secondary", label: "Secondary", hover: "bg-accent" },
  { variant: "ghost", label: "Ghost", hover: "bg-accent" },
  { variant: "destructive", label: "Destructive", hover: "bg-destructive/10" },
  { variant: "link", label: "Link", hover: "underline" },
] as const;
const linkVariants = variants.filter(
  (v) => v.variant === "default" || v.variant === "outline" || v.variant === "ghost",
);

const focusRing = "outline-2 outline-offset-2 outline-ring";
// The field look on `:focus-visible` (input.tsx `fieldClass`).
const fieldFocus = "border-ring ring-1 ring-ring";
// The field look on `:focus-visible` while `aria-invalid`.
const fieldFocusInvalid = "border-destructive ring-1 ring-destructive";

const bortleOptions = ([4, 5, 6] as const).map((value) => ({
  value: String(value),
  label: m.siteForm.bortleOption({ value: String(value), label: m.siteForm.bortleLabels[value] }),
}));

// Sample rows in the hub's row pattern. Static sample data, never a store.
const sampleSites = [
  { name: "Back garden", meta: ["52.23, 21.01", "Bortle 6", "Min 15°", "Europe/Warsaw (auto)"] },
  { name: "Dark-sky park", meta: ["49.27, 22.53", "Bortle 2", "Min 10°", "Europe/Warsaw (pinned)"] },
];
const rowLink =
  "-mx-2 flex min-h-11 flex-col justify-center rounded-lg px-2 py-3 transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring";

const submitIcon = createElement(Save, { className: "size-4", "aria-hidden": true });

/*
 * Tonight (tonight-nightfall). Static sample verdicts and a sample view, worded through Tonight's own formatter so
 * they follow the page's language; no store, no clock, no forecast. Switch the language above to Polish to see the
 * giant word's Polish sizes (Tak, Może, Nie).
 */
const fmt = createFormatter(locale);
const SAMPLE_ZONE = "Europe/Warsaw";
const SAMPLE_DATE = "2026-10-10";
const MINUTE_MS = 60_000;

const goVerdict = { level: "go", reason: { kind: "clear-run", runHours: 7, cloudPct: 8 } } satisfies Verdict;
const marginalVerdict = {
  level: "marginal",
  reason: { kind: "clear-run", runHours: 3, cloudPct: 45 },
} satisfies Verdict;
const noGoVerdict = { level: "no-go", reason: { kind: "cloudy", bestRunHours: 1, minCloudPct: 82 } } satisfies Verdict;
const sampleWindow: TonightDarkWindow = { kind: "window", start: "19:42", end: "05:18" };
const freshForecast: ForecastStatus = { kind: "fresh", ageMs: 20 * MINUTE_MS };
const weatherNoGo: TonightExplanation = {
  kind: "weather-no-go",
  nextText: fmt.nextNightText({ kind: "found", date: "2026-10-12", verdict: marginalVerdict }),
};

interface SkySample {
  label: string;
  date: string;
  timeZone: string;
  verdict: Verdict;
  darkWindow: TonightDarkWindow;
  forecast: ForecastStatus;
  explanation: TonightExplanation | null;
}

const skySamples: SkySample[] = [
  {
    label: "go · clear",
    date: SAMPLE_DATE,
    timeZone: SAMPLE_ZONE,
    verdict: goVerdict,
    darkWindow: sampleWindow,
    forecast: freshForecast,
    explanation: null,
  },
  {
    label: "marginal · partly clear",
    date: SAMPLE_DATE,
    timeZone: SAMPLE_ZONE,
    verdict: marginalVerdict,
    darkWindow: sampleWindow,
    forecast: freshForecast,
    explanation: null,
  },
  {
    label: "no-go · cloudy, with the next clearer night",
    date: SAMPLE_DATE,
    timeZone: SAMPLE_ZONE,
    verdict: noGoVerdict,
    darkWindow: sampleWindow,
    forecast: freshForecast,
    explanation: weatherNoGo,
  },
  {
    label: "forecast none · no forecast",
    date: SAMPLE_DATE,
    timeZone: SAMPLE_ZONE,
    verdict: { level: "marginal", reason: { kind: "no-weather-data" } },
    darkWindow: sampleWindow,
    forecast: { kind: "none" },
    explanation: null,
  },
  {
    label: "no dark window · summer at 54° N",
    date: "2026-06-20",
    timeZone: SAMPLE_ZONE,
    verdict: { level: "no-go", reason: { kind: "no-darkness" } },
    darkWindow: { kind: "none" },
    forecast: freshForecast,
    explanation: {
      kind: "no-darkness",
      causeText: fmt.noDarknessCauseText({ latitudeDeg: 54.4, minSunAltitudeDeg: -12.2, thresholdDeg: -18, bortle: 3 }),
      returnText: fmt.darkReturnText(
        {
          date: "2026-08-03",
          window: { start: new Date("2026-08-03T21:58:00Z"), end: new Date("2026-08-04T00:36:00Z") },
        },
        SAMPLE_ZONE,
      ),
    },
  },
];

const skies = skySamples.map((sample) => ({
  label: sample.label,
  props: {
    level: sample.verdict.level,
    dateLabel: fmt.formatNightDate(sample.date),
    headline: fmt.skyHeadline(sample.verdict),
    text: fmt.verdictReasonText(sample.verdict),
    darkWindow: sample.darkWindow,
    timeZone: sample.timeZone,
    forecastStatus: { kind: sample.forecast.kind, text: fmt.forecastStatusText(sample.forecast) },
    explanation: sample.explanation,
  },
}));

// The best three targets, already in best-time order, as `summaryTargets` holds them.
const sampleTarget = (
  rank: number,
  messier: number,
  commonName: string,
  constellation: string,
  bestTime: string,
  bestAt: number,
): TonightEntry => ({
  rank,
  id: `M${messier}`,
  messier,
  commonName,
  constellation,
  windowStart: "19:42",
  windowEnd: "05:18",
  bestTime,
  bestAt,
  bestDirection: "S, 70°",
  pair: null,
  reason: "",
  seenText: null,
});
const sampleTargets = [
  sampleTarget(3, 13, "Great Globular Cluster in Hercules", "Her", "19:55", Date.UTC(2026, 9, 10, 17, 55)),
  sampleTarget(1, 31, "Andromeda Galaxy", "And", "23:40", Date.UTC(2026, 9, 10, 21, 40)),
  sampleTarget(2, 45, "Pleiades", "Tau", "02:15", Date.UTC(2026, 9, 11, 0, 15)),
];

const sampleMoon: MoonDiscState = {
  time: "2026-10-10T21:40:00Z",
  illuminatedFraction: 0.63,
  waxing: true,
  band: "waxing-gibbous",
  brightLimbAngleDeg: 270,
  librationLatDeg: 0,
  librationLonDeg: 0,
};

const samplePlanet = (key: "jupiter" | "saturn", bestTime: string, bestAt: number): TonightPlanetEntry => ({
  key,
  name: m.targets.planet[key],
  windowStart: "19:42",
  windowEnd: "05:18",
  bestTime,
  bestAt,
  bestDirection: "S, 45°",
  magnitudeText: "",
  sizeText: "",
  phaseText: null,
  ringText: null,
  eyepiece: null,
  reason: m.tonight.planets.reason.high.night({ time: bestTime }),
  note: "",
  seenText: null,
});

// Nights 1-3 carry a verdict (go, marginal, no-go), nights 4-7 an outlook; `null` is a night without a clear share.
const NIGHT_VERDICTS = [goVerdict, marginalVerdict, noGoVerdict];
const sampleNights = (clear: (number | null)[]): TonightNight[] =>
  clear.map((clearPct, i) => {
    const date = `2026-10-${String(10 + i)}`;
    const base = { date, label: fmt.formatShortNightDate(date), darkText: "19:42–05:18", moonText: "", clearPct };
    const verdict = NIGHT_VERDICTS.at(i);
    return verdict
      ? { ...base, kind: "verdict", level: verdict.level, headline: fmt.skyHeadline(verdict), reasonText: null }
      : { ...base, kind: "outlook", cloudText: null };
  });

const summaryView: TonightView = {
  siteId: "sample-site",
  telescopeId: "sample-telescope",
  siteName: "Back garden",
  telescopeName: "150 mm reflector",
  date: SAMPLE_DATE,
  dateLabel: fmt.formatNightDate(SAMPLE_DATE),
  timeZone: SAMPLE_ZONE,
  verdict: goVerdict,
  headline: fmt.skyHeadline(goVerdict),
  verdictText: fmt.verdictReasonText(goVerdict),
  darkWindow: sampleWindow,
  darkStart: null,
  ranking: {
    clearedCount: 14,
    clearedText: fmt.clearedLine(14),
    entries: sampleTargets,
    washedOutCount: 0,
    washedOutText: null,
    washedOutEntries: [],
  },
  summaryTargets: sampleTargets,
  hasEyepieces: false,
  forecastStatus: { kind: freshForecast.kind, text: fmt.forecastStatusText(freshForecast) },
  explanation: null,
  nights: sampleNights([92, 55, 14, 30, 70, 85, 60]),
  solarSystem: {
    windowText: "",
    weatherText: null,
    entries: [
      samplePlanet("jupiter", "01:30", Date.UTC(2026, 9, 10, 23, 30)),
      samplePlanet("saturn", "21:50", Date.UTC(2026, 9, 10, 19, 50)),
    ],
    noneText: null,
  },
  moonCard: {
    window: { start: "19:42", end: "05:18" },
    windowKind: "dark",
    states: [sampleMoon],
    timeLabels: ["23:40"],
    initialIndex: 0,
    phaseText: fmt.moonPhaseText(sampleMoon.band, sampleMoon.illuminatedFraction),
    upText: fmt.moonUpText(
      {
        kind: "part",
        spans: [{ start: new Date("2026-10-10T19:10:00Z"), end: new Date("2026-10-11T03:18:00Z") }],
        upAtStart: false,
      },
      SAMPLE_ZONE,
    ),
    faintText: null,
    target: null,
  },
};
// One band only (the Moon band is left out so its disc's clip id stays unique on the page).
const targetsOnlyView: TonightView = { ...summaryView, moonCard: null, solarSystem: null, nights: [] };
const noTargetsView: TonightView = {
  ...targetsOnlyView,
  verdict: noGoVerdict,
  headline: fmt.skyHeadline(noGoVerdict),
  verdictText: fmt.verdictReasonText(noGoVerdict),
  ranking: null,
  summaryTargets: [],
  explanation: weatherNoGo,
};
const nullBarsView: TonightView = { ...targetsOnlyView, nights: sampleNights([88, null, 40, 12, null, 65, 95]) };

/*
 * The tiles are links inside TonightTiles, so the specimens reach them from a wrapper with the
 * child variant (wrapper > tiles root > tile) and apply the classes the tile takes on `:hover` /
 * `:focus-visible`. `inert` keeps the specimen links out of the tab order.
 */
const summaryHover = "*:*:bg-accent";
const summaryFocus = "*:*:outline-2 *:*:-outline-offset-2 *:*:outline-ring";

// Shared page classes (token classes and type roles only).
const block = "flex flex-col gap-4 border-t border-border pt-6 first:border-t-0 first:pt-0";
const blockTitle = "font-display text-title font-semibold text-heading";
const blockNote = "text-sm text-muted-foreground";
const grid = "grid gap-x-6 gap-y-5 sm:grid-cols-2 lg:grid-cols-3";
const cell = "flex min-w-0 flex-col gap-2";
const wideCell = "flex min-w-0 flex-col gap-2 sm:col-span-2 lg:col-span-3";
const stateLabel = "font-mono text-sm text-muted-foreground";
const notApplicable = "text-sm text-faint";
const row = "flex flex-wrap items-center gap-3";
const groupTitle = "text-label font-semibold text-muted-foreground";
---

<Layout title="Design · Sidereus">
  <div class="min-h-screen w-full bg-background text-foreground">
    <div class="border-b border-border bg-linear-to-b from-zenith to-horizon">
      <div class="mx-auto flex h-16 w-full max-w-5xl items-center gap-4 px-4 pt-4 sm:px-8 sm:pt-6">
        <span class="flex shrink-0 items-center gap-2.5">
          <svg viewBox="0 0 24 24" class="size-5.5 text-primary" fill="currentColor" aria-hidden="true">
            <path d="M12 2 13.8 10.2 22 12l-8.2 1.8L12 22l-1.8-8.2L2 12l8.2-1.8Z"></path>
          </svg>
          <span class="font-display text-title font-semibold text-heading">{m.common.appName}</span>
        </span>
        <div class="ml-auto">
          <TopbarControls theme={theme} locale={locale} email={null} client:load />
        </div>
      </div>
      <div class="mx-auto w-full max-w-5xl px-4 pt-6 pb-8 sm:px-8 sm:pt-10 sm:pb-12">
        <PageHeader
          title="Kitchen sink"
          subtitle="Dev only. Every colour on this page is a theme token; switch the theme above to review dark, light and red."
        >
          <a slot="actions" href="#components-heading" class:list={buttonVariants({ variant: "outline" })}>
            State matrix
          </a>
        </PageHeader>
      </div>
    </div>

    <main class="mx-auto w-full max-w-5xl px-4 py-8 sm:px-8 sm:py-12">
      <Band headingId="tokens-heading" heading="Tokens">
        <div class="flex flex-col gap-6">
          {tokenGroups.map((group) => (
            <div class="flex flex-col gap-3">
              <h3 class:list={groupTitle}>{group.title}</h3>
              <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
                {group.tokens.map((token) => (
                  <li class="flex min-w-0 flex-col gap-1.5">
                    <span class:list={["h-14 rounded-lg border border-border", token.swatch]} aria-hidden="true" />
                    <span class="font-mono text-xs break-all text-heading">--{token.name}</span>
                    <span class="font-mono text-xs text-muted-foreground" data-token-value={token.name} />
                  </li>
                ))}
              </ul>
            </div>
          ))}
          <div class="flex flex-col gap-3">
            <h3 class:list={groupTitle}>Sky gradient</h3>
            <div class="flex h-28 items-end rounded-lg border-b border-border bg-linear-to-b from-zenith to-horizon px-4 pb-3">
              <span class="font-mono text-xs text-heading">--zenith → --horizon</span>
            </div>
          </div>
        </div>
      </Band>

      <Band headingId="type-heading" heading="Type and radius">
        <div class="flex flex-col gap-6">
          <div class="flex flex-col gap-4">
            <p class="font-display text-display font-semibold break-words text-heading">text-display · My gear</p>
            <p class="font-display text-title font-semibold text-heading">text-title · M31 · Andromeda Galaxy</p>
            <p class="text-label font-semibold text-heading">text-label · Field label, button, row meta</p>
            <p class="text-body text-foreground">
              text-body · Up for 7 h 50 min of the dark window, 92% clear of moonlight. Find with{" "}
              <span class="font-semibold text-primary-strong">25 mm Plössl</span>.
            </p>
            <p class="text-body text-foreground">
              font-mono (Archivo, tabular figures) · Dark from <span class="font-mono text-heading">19:42</span> to{" "}
              <span class="font-mono text-heading">05:18</span> · best{" "}
              <span class="font-mono text-heading">23:40 · S, 78°</span>
            </p>
            <p class="text-sm text-muted-foreground">Muted · 150 mm reflector · times in Europe/Warsaw</p>
            <p class="text-xs text-faint">
              Faint · Object data: OpenNGC (CC BY-SA 4.0) · Weather: Open-Meteo (CC BY 4.0)
            </p>
            <p class="text-body text-foreground">
              Polish glyphs · Zażółć gęślą jaźń ·{" "}
              <span class="font-display font-semibold text-heading">Łabędź, Wężownik</span>
            </p>
          </div>
          <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
            {radii.map((radius) => (
              <li class="flex min-w-0 flex-col gap-1.5">
                <span class:list={["h-14 border border-border bg-surface", radius.swatch]} aria-hidden="true" />
                <span class="font-mono text-xs text-heading">{radius.name}</span>
              </li>
            ))}
          </ul>
        </div>
      </Band>

      <Band headingId="components-heading" heading="Components × states">
        <div class="flex flex-col gap-8">
          <div class="flex flex-col gap-3">
            <dl class="grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2">
              {stateContract.map((entry) => (
                <div class="flex min-w-0 flex-wrap gap-x-2">
                  <dt class="font-mono font-semibold text-heading">{entry.state}</dt>
                  <dd class="text-muted-foreground">{entry.where}</dd>
                </div>
              ))}
            </dl>
            <p class:list={blockNote}>
              Skeletons: N/A for /gear. It is server-rendered and has no loading state besides form submission.
            </p>
          </div>

          <div class="flex flex-col gap-10">
            <!-- Button -->
            <section class:list={block} aria-labelledby="c-button">
              <h3 id="c-button" class:list={blockTitle}>
                Button
              </h3>
              <div class:list={grid}>
                <div class:list={wideCell}>
                  <p class:list={stateLabel}>default · live</p>
                  <div class:list={row}>
                    {variants.map((v) => (
                      <Button type="button" variant={v.variant}>
                        {v.label}
                      </Button>
                    ))}
                  </div>
                </div>
                <div class:list={wideCell}>
                  <p class:list={stateLabel}>hover · specimen</p>
                  <div class:list={row}>
                    {variants.map((v) => (
                      <Button type="button" variant={v.variant} className={v.hover} tabIndex={-1}>
                        {v.label}
                      </Button>
                    ))}
                  </div>
                </div>
                <div class:list={wideCell}>
                  <p class:list={stateLabel}>focus-visible · specimen</p>
                  <div class:list={row}>
                    {variants.map((v) => (
