---
import AuthShell from "@/components/AuthShell.astro";

const { user } = Astro.locals;
---

<AuthShell title="Dashboard" centered>
  <p class="break-words text-foreground">
    Welcome, <span class="font-semibold text-heading">{user?.email}</span>
  </p>
  <p class="mt-2 text-sm text-muted-foreground">This page is only for authenticated users.</p>
  <form method="POST" action="/api/auth/signout" class="mt-6">
    <button
      type="submit"
      class="cursor-pointer rounded-lg border border-border px-4 py-2 text-sm font-semibold text-heading transition-colors hover:bg-accent"
    >
      Sign out
    </button>
  </form>
</AuthShell>
