---
import DatabaseMissing from "@/components/gear/DatabaseMissing.astro";
import GearShell from "@/components/gear/GearShell.astro";
import { ServerError } from "@/components/forms/ServerError";
import SkyAnswerForm from "@/components/sky-checks/SkyAnswerForm.astro";
import SkyTally from "@/components/sky-checks/SkyTally.astro";
import { VERDICT_TONES } from "@/components/tonight/verdict-tones";
import BackLink from "@/components/ui/BackLink.astro";
import Band from "@/components/ui/Band.astro";
import Notice from "@/components/ui/Notice.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import Pager from "@/components/ui/Pager.astro";
import { buttonVariants } from "@/components/ui/button";
import { getMessages, translateKey, type MessageKey } from "@/i18n";
import { LOG_LIST, parseLogPage } from "@/lib/observations/redirect";
import { claimOf, outcomeOf, tallyOf, type Outcome, type Tally } from "@/lib/sky-checks/claim";
import { answerLabel, headlineLevel } from "@/lib/sky-checks/labels";
import { hasSkyCheckedNotice, SKY_CHECKS_PAGE } from "@/lib/sky-checks/redirect";
import { skyCheckStore, type SkyCheckRecord } from "@/lib/sky-checks/store";
import { createFormatter, SKY_HEADLINE_KEYS } from "@/lib/tonight/format";
import { cn } from "@/lib/utils";

// The sky checks page (verdict-check): the tally, then every recorded night whose dark window has started, newest
// first, one page at a time, each answerable or changeable in place. Answers come back here with `?skyChecked=1`, a
// failed one with `?error=<message key>`.
const { supabase, locale } = Astro.locals;
const m = getMessages(locale);
const t = m.skyChecks.page;
const params = Astro.url.searchParams;
const page = parseLogPage(params.get("page"));
const error = params.get("error");
const saved = hasSkyCheckedNotice(params);

let entries: SkyCheckRecord[] = [];
let hasOlder = false;
let tally: Tally | null = null;
let loadError: MessageKey | null = null;
if (supabase) {
  try {
    const now = new Date();
    const [list, rows] = await Promise.all([
      skyCheckStore.list(supabase, { page, now }),
      skyCheckStore.tally(supabase),
    ]);
    ({ entries, hasOlder } = list);
    tally = tallyOf(rows);
  } catch {
    loadError = "errors.load.skyChecks";
  }
}

const format = createFormatter(locale);
// The tone rides on a dot, never on the word: the words keep text contrast in every theme (impl review F1).
const OUTCOME_DOTS: Record<Outcome, string> = {
  match: "bg-go",
  optimistic: "bg-no-go",
  pessimistic: "bg-marginal",
};
const outcomeOfCheck = (check: SkyCheckRecord): Outcome | null => {
  const claim = claimOf(check.headline);
  return claim && check.answer ? outcomeOf(claim, check.answer) : null;
};
const siteName = (check: SkyCheckRecord) =>
  check.siteId ? check.siteName : m.log.list.deletedGear({ name: check.siteName });
const pageHref = (n: number) => (n === 1 ? SKY_CHECKS_PAGE : `${SKY_CHECKS_PAGE}?page=${n}`);
const actionLink = cn(buttonVariants(), "mt-4");
---

<GearShell title={t.title}>
  <Fragment slot="header">
    <BackLink href={LOG_LIST} label={m.nav.log} />
    <div class="mt-2">
      <PageHeader title={t.title} subtitle={t.intro} />
    </div>
  </Fragment>

  {saved && (
    <Notice tone="success" toast param="skyChecked">
      {m.skyChecks.saved}
    </Notice>
  )}

  <div class="mb-6 empty:hidden">
    <ServerError message={error ? translateKey(m, error, "errors.generic") : null} />
  </div>

  {!supabase ? (
    <DatabaseMissing />
  ) : loadError ? (
    <ServerError message={translateKey(m, loadError, "errors.generic")} />
  ) : entries.length === 0 && page > 1 ? (
    // Past the last page (a stale or edited link): there are nights, so say so and lead back to the newest.
    <div>
      <p class="text-body text-foreground">{t.pageEmpty}</p>
      <a href={SKY_CHECKS_PAGE} class:list={actionLink}>
        {t.toNewest}
      </a>
    </div>
  ) : entries.length === 0 ? (
    <div>
      <p class="text-body text-foreground">{t.empty}</p>
      <a href="/tonight" class:list={actionLink}>
        {t.toTonight}
      </a>
    </div>
  ) : (
    <>
      <div>
        {tally && <SkyTally tally={tally} />}

        <Band headingId="sky-nights-heading" heading={t.nightsHeading}>
          <ul class="divide-y divide-border">
            {entries.map((check) => {
              const outcome = outcomeOfCheck(check);
              return (
                <li class="py-4 first:pt-0 last:pb-0" data-sky-check-row={check.night}>
                  <p class="text-body font-semibold break-words text-heading">
                    {format.formatNightDate(check.night)}
                    <span class="font-normal text-muted-foreground"> · {siteName(check)}</span>
                  </p>
                  <p class="mt-1 flex items-center gap-2 text-label text-foreground">
                    <span
                      class:list={["size-2 shrink-0 rounded-full", VERDICT_TONES[headlineLevel(check.headline)].dot]}
                      aria-hidden="true"
                    />
                    {t.weSaid({ headline: translateKey(m, SKY_HEADLINE_KEYS[check.headline], "errors.generic") })}
                  </p>
                  <p class="mt-1 mb-3 text-label text-foreground">
                    {check.answer ? (
                      <>
                        {t.youSaw({ answer: answerLabel(m, check.answer) })}
                        {outcome && (
                          <>
                            {" · "}
                            <span class="inline-flex items-center gap-1.5 font-semibold text-heading">
                              <span
                                class:list={["size-2 shrink-0 rounded-full", OUTCOME_DOTS[outcome]]}
                                aria-hidden="true"
                              />
                              {m.skyChecks.outcome[outcome]}
                            </span>
                          </>
                        )}
                      </>
                    ) : (
                      <span class="text-muted-foreground">{t.notAnswered}</span>
                    )}
                  </p>
                  <SkyAnswerForm
                    id={check.id}
                    from="sky"
                    current={check.answer}
                    label={t.answersFor({ night: format.formatNightDate(check.night), site: siteName(check) })}
                  />
                </li>
              );
            })}
          </ul>
        </Band>
      </div>

      <Pager
        class="mt-8"
        label={t.pages}
        newerHref={page > 1 ? pageHref(page - 1) : undefined}
        newerLabel={t.newer}
        olderHref={hasOlder ? pageHref(page + 1) : undefined}
        olderLabel={t.older}
      />
    </>
  )}
</GearShell>
