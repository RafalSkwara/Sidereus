---
import DatabaseMissing from "@/components/gear/DatabaseMissing.astro";
import GearShell from "@/components/gear/GearShell.astro";
import { ServerError } from "@/components/forms/ServerError";
import { CircleCheck } from "lucide-react";
import { getMessages, translateKey, type MessageKey } from "@/i18n";
import { LOG_LIST, parseLogPage, readLogNotice } from "@/lib/observations/redirect";
import { observationStore, type ObservationRecord } from "@/lib/observations/store";
import { targetLabel } from "@/lib/targets/labels";
import { createFormatter } from "@/lib/tonight/format";

// The observation log (roadmap S-07, FR-017 / FR-021): the user's entries grouped by observing night, newest first,
// one page at a time. Writes elsewhere come back here with `?saved=`, `?updated=` or `?deleted=<target key>` (a bare
// Messier number from an older link still reads); a failed delete with `?error=<message key>`.
const { supabase, locale } = Astro.locals;
const m = getMessages(locale);
const t = m.log.list;
const params = Astro.url.searchParams;
const page = parseLogPage(params.get("page"));
const error = params.get("error");

const logNotice = readLogNotice(params);
const notice = logNotice ? t[logNotice.kind]({ object: targetLabel(logNotice.target, locale).id }) : null;

let entries: ObservationRecord[] = [];
let hasOlder = false;
let loadError: MessageKey | null = null;
if (supabase) {
  try {
    ({ entries, hasOlder } = await observationStore.list(supabase, { page }));
  } catch {
    loadError = "errors.load.observations";
  }
}

// Consecutive entries of one night form a group; the order is newest night first, so each night appears once
// per page (a night split across pages repeats its heading on the next one).
const nights: { night: string; entries: ObservationRecord[] }[] = [];
for (const entry of entries) {
  const last = nights.at(-1);
  if (last?.night === entry.night) {
    last.entries.push(entry);
  } else {
    nights.push({ night: entry.night, entries: [entry] });
  }
}

const format = createFormatter(locale);
const RATING_DOTS = [1, 2, 3, 4, 5] as const;
const gearName = (name: string, id: string | null) => (id ? name : t.deletedGear({ name }));
const pageHref = (n: number) => (n === 1 ? LOG_LIST : `${LOG_LIST}?page=${n}`);
const primaryLink =
  "inline-flex items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90";
const pageLink =
  "inline-flex min-h-11 items-center rounded-lg px-3 text-sm font-semibold text-primary-strong transition-colors hover:text-heading";
---

<GearShell title={t.title}>
  {notice && (
    <p
      role="status"
      class="mb-6 flex items-center gap-2 rounded-lg border border-go-border bg-go-surface px-3 py-2 text-sm text-foreground"
    >
      <CircleCheck className="size-4 shrink-0 text-go" aria-hidden="true" />
      {notice}
    </p>
  )}

  <div class="mb-2 flex flex-wrap items-end justify-between gap-3">
    <h1 class="font-display text-4xl font-semibold text-heading sm:text-5xl">{t.title}</h1>
    {supabase && (
      <a href={`/log/new?from=log`} class:list={[primaryLink]}>
        {t.add}
      </a>
    )}
  </div>
  <p class="mb-6 text-sm text-muted-foreground">{t.intro}</p>

  <div class="mb-6 empty:hidden">
    <ServerError message={error ? translateKey(m, error, "errors.generic") : null} />
  </div>

  {!supabase ? (
    <DatabaseMissing />
  ) : loadError ? (
    <ServerError message={translateKey(m, loadError, "errors.generic")} />
  ) : nights.length === 0 && page > 1 ? (
    // Past the last page (a stale or edited link): the log is not empty, so say so and lead back to its start.
    <div class="rounded-2xl border border-border bg-surface p-4 sm:p-6">
      <p class="mb-4 text-foreground">{t.pageEmpty}</p>
      <a href={LOG_LIST} class:list={[primaryLink]}>
        {t.toNewest}
      </a>
    </div>
  ) : nights.length === 0 ? (
    <div class="rounded-2xl border border-border bg-surface p-4 sm:p-6">
      <p class="mb-4 text-foreground">{t.empty}</p>
      <div class="flex flex-wrap gap-3">
        <a href="/tonight" class:list={[primaryLink]}>
          {t.toTonight}
        </a>
        <a
          href="/log/new?from=log"
          class="inline-flex items-center justify-center rounded-lg border border-border px-4 py-2 text-sm font-semibold text-heading transition-colors hover:bg-accent"
        >
          {t.add}
        </a>
      </div>
    </div>
  ) : (
    <>
      <div class="space-y-6">
        {nights.map((group, index) => (
          <section aria-labelledby={`night-${index}`} class="rounded-2xl border border-border bg-surface p-4 sm:p-6">
            <h2 id={`night-${index}`} class="mb-2 font-display text-xl font-semibold text-heading">
              {format.formatNightDate(group.night)}
            </h2>
            <ul class="divide-y divide-border">
              {group.entries.map((entry) => {
                const { id, name: commonName } = targetLabel(entry.target, locale);
                return (
                  <li>
                    <a
                      href={`${LOG_LIST}/${entry.id}`}
                      class="-mx-2 flex items-center justify-between gap-4 rounded-lg px-2 py-3 transition-colors hover:bg-accent"
                    >
                      <span class="min-w-0">
                        <span class="block font-semibold break-words text-heading">
                          {id}
                          {commonName && <span class="font-normal text-foreground"> · {commonName}</span>}
                        </span>
                        <span class="mt-1 block text-sm break-words text-muted-foreground">
                          {gearName(entry.siteName, entry.siteId)} · {gearName(entry.telescopeName, entry.telescopeId)}
                        </span>
                      </span>
                      <span class="flex shrink-0 items-center gap-3">
                        <span class="flex gap-1" aria-hidden="true">
                          {RATING_DOTS.map((dot) => (
                            <span
                              class:list={[
                                "size-2.5 rounded-full border",
                                dot <= entry.rating ? "border-primary bg-primary" : "border-muted-foreground/60",
                              ]}
                            />
                          ))}
                        </span>
                        <span class="sr-only">{t.rated({ rating: String(entry.rating) })}</span>
                        <span class="text-sm font-semibold text-primary-strong">{t.edit}</span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </div>

      {(page > 1 || hasOlder) && (
        <nav aria-label={t.pages} class="mt-6 flex justify-between gap-4">
          {page > 1 ? (
            <a href={pageHref(page - 1)} class:list={[pageLink]}>
              {t.newer}
            </a>
          ) : (
            <span />
          )}
          {hasOlder && (
            <a href={pageHref(page + 1)} class:list={[pageLink]}>
              {t.older}
            </a>
          )}
        </nav>
      )}
    </>
  )}
</GearShell>
