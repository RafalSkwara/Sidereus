---
import DatabaseMissing from "@/components/gear/DatabaseMissing.astro";
import DeleteButton from "@/components/gear/DeleteButton";
import GearShell from "@/components/gear/GearShell.astro";
import { ServerError } from "@/components/forms/ServerError";
import ObservationForm from "@/components/observations/ObservationForm";
import BackLink from "@/components/ui/BackLink.astro";
import Band from "@/components/ui/Band.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { buttonVariants } from "@/components/ui/button";
import { getMessages, translateKey, type MessageKey } from "@/i18n";
import { siteStore, telescopeStore, type SiteRecord, type TelescopeRecord } from "@/lib/gear/store";
import { LOG_LIST } from "@/lib/observations/redirect";
import { latestNightBound, observationStore, type ObservationRecord } from "@/lib/observations/store";
import { targetOptions } from "@/lib/observations/target-options";
import { targetLabel } from "@/lib/targets/labels";
import { cn } from "@/lib/utils";

// One log entry (roadmap S-07, FR-017): the form to edit every field and a delete button. An entry whose site or
// telescope was deleted since keeps it as a "(deleted)" option (FR-021). `POST /api/log/<id>` sends a failed
// save back here with `?error=<message key>`.
const id = Astro.params.id ?? "";
const { supabase, locale } = Astro.locals;
const m = getMessages(locale);
const t = m.log;
const error = Astro.url.searchParams.get("error");

let entry: ObservationRecord | null = null;
let sites: SiteRecord[] = [];
let telescopes: TelescopeRecord[] = [];
let loadError: MessageKey | null = null;
if (supabase) {
  // Loaded together, worded apart: a failed gear read is a setup problem, not a log one (as on /log/new).
  const [entryResult, gearResult] = await Promise.allSettled([
    observationStore.get(supabase, id),
    Promise.all([siteStore.list(supabase), telescopeStore.list(supabase)]),
  ]);
  if (entryResult.status === "rejected") {
    loadError = "errors.load.observations";
  } else if (gearResult.status === "rejected") {
    loadError = "errors.load.setup";
  } else {
    entry = entryResult.value;
    [sites, telescopes] = gearResult.value;
  }
  if (!entry && !loadError) {
    Astro.response.status = 404;
  }
}

const label = entry ? targetLabel(entry.target, locale) : null;
const objectId = label?.id ?? "";
const commonName = label?.name ?? null;
// Only a hint for the date picker; the store checks the chosen site's own night.
const maxNight = latestNightBound(sites, new Date());
// "Entry not found" only when the entry is really missing; a load error or a missing database keeps a neutral title.
const title = entry ? t.editTitle({ object: objectId }) : supabase && !loadError ? t.notFound : t.kicker;
---

<GearShell title={title}>
  <Fragment slot="header">
    <BackLink href={LOG_LIST} label={m.nav.log} />
    <div class="mt-4">
      <PageHeader title={title} subtitle={commonName ?? undefined} />
    </div>
  </Fragment>
  {!supabase ? (
    <DatabaseMissing />
  ) : loadError ? (
    <ServerError message={translateKey(m, loadError, "errors.generic")} />
  ) : entry ? (
    <div>
      <div class="pb-8">
        <p class="mb-6 text-body text-muted-foreground">{t.editIntro}</p>
        <ObservationForm
          action={`/api/log/${encodeURIComponent(entry.id)}`}
          mode="edit"
          initial={{
            target: entry.target,
            night: entry.night,
            siteId: entry.siteId ?? "",
            telescopeId: entry.telescopeId ?? "",
            rating: entry.rating,
          }}
          targetOptions={targetOptions(locale)}
          sites={sites.map(({ id, name }) => ({ id, name }))}
          telescopes={telescopes.map(({ id, name }) => ({ id, name }))}
          deletedSite={entry.siteId ? undefined : entry.siteName}
          deletedTelescope={entry.telescopeId ? undefined : entry.telescopeName}
          maxNight={maxNight}
          serverError={error}
          locale={locale}
          client:load
        />
      </div>
      <Band headingId="delete-heading" heading={t.deleteHeading}>
        <DeleteButton
          action={`/api/log/${encodeURIComponent(entry.id)}/delete`}
          label={t.delete}
          confirmMessage={t.confirmDelete({ object: objectId })}
          cancelLabel={m.common.cancel}
          client:load
        />
      </Band>
    </div>
  ) : (
    <div>
      <p class="text-body text-muted-foreground">{t.notFoundText}</p>
      <a href={LOG_LIST} class:list={cn(buttonVariants({ variant: "outline" }), "mt-4")}>
        {t.backToLogLink}
      </a>
    </div>
  )}
</GearShell>
