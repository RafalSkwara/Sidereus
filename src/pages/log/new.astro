---
import DatabaseMissing from "@/components/gear/DatabaseMissing.astro";
import GearShell from "@/components/gear/GearShell.astro";
import { ServerError } from "@/components/forms/ServerError";
import ObservationForm from "@/components/observations/ObservationForm";
import { getMessages, translateKey, type MessageKey } from "@/i18n";
import { findMessier } from "@/lib/catalogue";
import { localCommonName } from "@/lib/catalogue/common-names";
import { observingNightDateFor } from "@/lib/engine";
import { siteStore, telescopeStore, type SiteRecord, type TelescopeRecord } from "@/lib/gear/store";
import { isCalendarDate } from "@/lib/observations/schemas";

// Mark observed (roadmap S-06, FR-016). Tonight links here with the ranking's object, night, site and
// telescope; `POST /api/log` sends a failed save back with the same prefill and a `?error=` message key.
const { supabase, locale } = Astro.locals;
const m = getMessages(locale);
const t = m.log;
const params = Astro.url.searchParams;
const error = params.get("error");

const objectParam = params.get("object") ?? "";
const object = /^\d{1,3}$/.test(objectParam) ? findMessier(Number(objectParam)) : undefined;

let sites: SiteRecord[] = [];
let telescopes: TelescopeRecord[] = [];
let loadError: MessageKey | null = null;
if (supabase && object) {
  try {
    [sites, telescopes] = await Promise.all([siteStore.list(supabase), telescopeStore.list(supabase)]);
  } catch {
    loadError = "errors.load.setup";
  }
}

// An id that is not one of the user's falls back to the oldest, as the ranking itself does (S-02).
const site = sites.find((s) => s.id === params.get("site")) ?? sites.at(0);
const telescope = telescopes.find((s) => s.id === params.get("telescope")) ?? telescopes.at(0);

const now = new Date();
// ISO dates compare correctly as strings.
const maxNight = sites.map((s) => observingNightDateFor(now, s.timeZone)).reduce((a, b) => (b > a ? b : a), "");
const nightParam = params.get("night") ?? "";
const night = isCalendarDate(nightParam) ? nightParam : site ? observingNightDateFor(now, site.timeZone) : "";

const commonName = object ? localCommonName(object.messier, object.commonName, locale) : null;
const title = object ? t.title({ object: object.id }) : t.kicker;
const primaryLink =
  "inline-flex items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90";
---

<GearShell title={title}>
  <a href="/tonight" class="mb-4 inline-block text-sm text-muted-foreground transition-colors hover:text-heading">
    {t.back}
  </a>
  <p class="mb-2 text-xs font-semibold tracking-[0.18em] text-primary uppercase">{t.kicker}</p>
  <h1 class="mb-2 font-display text-3xl font-semibold text-heading sm:text-4xl">
    {title}
    {commonName && <span class="text-2xl text-foreground sm:text-3xl"> · {commonName}</span>}
  </h1>

  {!supabase ? (
    <DatabaseMissing />
  ) : !object ? (
    <p class="mt-6 text-foreground">{t.objectNotFound}</p>
  ) : loadError ? (
    <div class="mt-6">
      <ServerError message={translateKey(m, loadError, "errors.generic")} />
    </div>
  ) : !site || !telescope ? (
    <div class="mt-6 rounded-2xl border border-border bg-surface p-4 sm:p-6">
      <p class="mb-4 text-foreground">{t.needsGear}</p>
      <a href="/gear" class:list={[primaryLink]}>
        {t.addGear}
      </a>
    </div>
  ) : (
    <>
      <p class="mb-6 text-sm text-muted-foreground">{t.intro}</p>
      <div class="rounded-2xl border border-border bg-surface p-4 sm:p-6">
        <ObservationForm
          action="/api/log"
          messier={object.messier}
          initial={{ night, siteId: site.id, telescopeId: telescope.id }}
          sites={sites.map(({ id, name }) => ({ id, name }))}
          telescopes={telescopes.map(({ id, name }) => ({ id, name }))}
          maxNight={maxNight}
          serverError={error}
          locale={locale}
          client:load
        />
      </div>
    </>
  )}
</GearShell>
