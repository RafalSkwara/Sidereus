---
import GearShell from "@/components/gear/GearShell.astro";
import DatabaseMissing from "@/components/gear/DatabaseMissing.astro";
import OnboardingWizard from "@/components/onboarding/OnboardingWizard";
import PageHeader from "@/components/ui/PageHeader.astro";
import { getMessages } from "@/i18n";
import { safeNextPath, withNext } from "@/lib/auth-redirect";
import { hasAnyGear } from "@/lib/onboarding/store";
import { logReadFailure } from "@/lib/observability/read-failure";

// `?error=` carries a message key; the island translates it. `?next=` is the page to continue to once set up.
const error = Astro.url.searchParams.get("error");
const next = safeNextPath(Astro.url.searchParams.get("next"));
const { supabase, locale } = Astro.locals;
const t = getMessages(locale).onboarding;

if (supabase) {
  let onboarded = false;
  try {
    onboarded = await hasAnyGear(supabase);
  } catch (error) {
    // Unknown whether the user has gear: show the setup anyway. `complete_onboarding` refuses a
    // user who already has a site or telescope, so a second run cannot duplicate anything. The read
    // failure is traced (code and name only), so the setup showing to a user with gear is explained.
    logReadFailure("read.onboarding", error);
  }
  if (onboarded) {
    return Astro.redirect(next ?? "/tonight");
  }
}

// Inline links in a credit line (exempt from the 44 px target); they still take the shared focus ring (Attribution.astro).
const link =
  "rounded-sm underline decoration-border red:decoration-current underline-offset-2 transition-colors hover:text-heading focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring";
---

<GearShell title={t.title}>
  <PageHeader slot="header" title={t.title} subtitle={t.intro} />
  {supabase ? (
    <OnboardingWizard action={withNext("/api/onboarding", next)} serverError={error} locale={locale} client:load />
  ) : (
    <DatabaseMissing />
  )}

  <div class="mt-10 border-t border-border pt-4">
    <p class="text-xs text-muted-foreground">
      {t.credit.placeSearch}{" "}
      <a href="https://open-meteo.com/en/docs/geocoding-api" class:list={[link]} rel="noopener noreferrer">
        Open-Meteo Geocoding API
      </a>{" "}
      · {t.credit.locationData}{" "}
      <a href="https://www.geonames.org/" class:list={[link]} rel="noopener noreferrer">
        GeoNames
      </a>{" "}
      (
      <a href="https://creativecommons.org/licenses/by/4.0/" class:list={[link]} rel="noopener noreferrer">
        CC BY 4.0
      </a>
      )
    </p>
  </div>
</GearShell>
