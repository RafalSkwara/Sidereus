---
import GearShell from "@/components/gear/GearShell.astro";
import DatabaseMissing from "@/components/gear/DatabaseMissing.astro";
import SiteForm from "@/components/gear/SiteForm";
import DeleteButton from "@/components/gear/DeleteButton";
import { ServerError } from "@/components/forms/ServerError";
import BackLink from "@/components/ui/BackLink.astro";
import Band from "@/components/ui/Band.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { getMessages } from "@/i18n";
import { siteStore, type SiteRecord } from "@/lib/gear/store";

const id = Astro.params.id ?? "";
// `?error=` carries a message key; the form translates it.
const error = Astro.url.searchParams.get("error");
const { supabase, locale } = Astro.locals;
const m = getMessages(locale);
const t = m.gear.sites;

let site: SiteRecord | null = null;
let loadError: string | null = null;
if (supabase) {
  try {
    site = await siteStore.get(supabase, id);
  } catch {
    loadError = m.errors.load.site;
  }
  if (!site && !loadError) {
    Astro.response.status = 404;
  }
}
---

<GearShell title={site ? site.name : t.fallbackTitle}>
  <Fragment slot="header">
    <BackLink href="/gear" label={m.gear.backToGear} />
    <div class="mt-2">
      <PageHeader title={site ? t.editTitle : t.fallbackTitle} />
    </div>
  </Fragment>
  {!supabase ? (
    <DatabaseMissing />
  ) : loadError ? (
    <ServerError message={loadError} />
  ) : site ? (
    <div>
      <Band headingId="details-heading" heading={m.gear.detailsHeading}>
        <SiteForm
          action={`/api/gear/sites/${encodeURIComponent(site.id)}`}
          initial={{
            name: site.name,
            latitudeDeg: site.latitudeDeg,
            longitudeDeg: site.longitudeDeg,
            bortle: site.bortle,
            minAltitudeDeg: site.minAltitudeDeg,
            timeZone: site.timeZone,
            timeZoneSource: site.timeZoneSource,
          }}
          serverError={error}
          locale={locale}
          client:load
        />
      </Band>
      <Band headingId="delete-heading" heading={m.gear.deleteHeading}>
        <DeleteButton
          action={`/api/gear/sites/${encodeURIComponent(site.id)}/delete`}
          label={t.delete}
          confirmMessage={t.confirmDelete}
          cancelLabel={m.common.cancel}
          client:load
        />
      </Band>
    </div>
  ) : (
    <Band headingId="not-found-heading" heading={m.gear.notFound}>
      <p class="text-body text-muted-foreground">{t.notFoundText}</p>
    </Band>
  )}
</GearShell>
