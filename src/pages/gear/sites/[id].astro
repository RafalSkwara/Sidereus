---
import GearShell from "@/components/gear/GearShell.astro";
import DatabaseMissing from "@/components/gear/DatabaseMissing.astro";
import SiteForm from "@/components/gear/SiteForm";
import DeleteButton from "@/components/gear/DeleteButton";
import { ServerError } from "@/components/forms/ServerError";
import { siteStore, type SiteRecord } from "@/lib/gear/store";

const LOAD_FAILED = "Could not load the site. Please try again.";

const id = Astro.params.id ?? "";
const error = Astro.url.searchParams.get("error");
const { supabase } = Astro.locals;

let site: SiteRecord | null = null;
let loadError: string | null = null;
if (supabase) {
  try {
    site = await siteStore.get(supabase, id);
  } catch {
    loadError = LOAD_FAILED;
  }
  if (!site && !loadError) {
    Astro.response.status = 404;
  }
}
---

<GearShell title={site ? site.name : "Site"}>
  <a href="/gear" class="mb-4 inline-block text-sm text-amber-200/80 hover:text-amber-50">
    ← My gear
  </a>
  {!supabase ? (
    <DatabaseMissing />
  ) : loadError ? (
    <ServerError message={loadError} />
  ) : site ? (
    <>
      <h1 class="mb-6 font-serif text-3xl break-words text-amber-50 sm:text-4xl">Edit site</h1>
      <div class="rounded-2xl border border-white/10 bg-white/5 p-4 sm:p-6">
        <SiteForm
          action={`/api/gear/sites/${encodeURIComponent(site.id)}`}
          initial={{
            name: site.name,
            latitudeDeg: site.latitudeDeg,
            longitudeDeg: site.longitudeDeg,
            bortle: site.bortle,
            minAltitudeDeg: site.minAltitudeDeg,
            timeZone: site.timeZone,
            timeZoneSource: site.timeZoneSource,
          }}
          serverError={error}
          client:load
        />
      </div>
      <div class="mt-6">
        <DeleteButton
          action={`/api/gear/sites/${encodeURIComponent(site.id)}/delete`}
          label="Delete site"
          confirmMessage="Delete this site? This cannot be undone."
          client:load
        />
      </div>
    </>
  ) : (
    <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
      <h1 class="font-serif text-3xl text-amber-50">Not found</h1>
      <p class="mt-2 text-sm text-slate-300/80">This site does not exist, or it is not yours.</p>
      <a href="/gear" class="mt-4 inline-block text-sm text-amber-200 hover:text-amber-50">
        Back to My gear
      </a>
    </div>
  )}
</GearShell>
