---
import GearShell from "@/components/gear/GearShell.astro";
import DatabaseMissing from "@/components/gear/DatabaseMissing.astro";
import EyepieceForm from "@/components/gear/EyepieceForm";
import { getMessages } from "@/i18n";

// `?error=` carries a message key; the form translates it.
const error = Astro.url.searchParams.get("error");
const { supabase, locale } = Astro.locals;
const m = getMessages(locale);
const t = m.gear.eyepieces;
---

<GearShell title={t.newTitle}>
  <a href="/gear" class="mb-4 inline-block text-sm text-muted-foreground transition-colors hover:text-heading">
    {m.gear.back}
  </a>
  <h1 class="mb-6 font-display text-3xl font-semibold text-heading sm:text-4xl">{t.newTitle}</h1>
  {supabase ? (
    <div class="rounded-2xl border border-border bg-surface p-4 sm:p-6">
      <EyepieceForm action="/api/gear/eyepieces" serverError={error} locale={locale} client:load />
    </div>
  ) : (
    <DatabaseMissing />
  )}
</GearShell>
