---
import GearShell from "@/components/gear/GearShell.astro";
import DatabaseMissing from "@/components/gear/DatabaseMissing.astro";
import EyepieceForm from "@/components/gear/EyepieceForm";
import DeleteButton from "@/components/gear/DeleteButton";
import { ServerError } from "@/components/forms/ServerError";
import { getMessages } from "@/i18n";
import { eyepieceStore, type EyepieceRecord } from "@/lib/gear/store";

const id = Astro.params.id ?? "";
// `?error=` carries a message key; the form translates it.
const error = Astro.url.searchParams.get("error");
const { supabase, locale } = Astro.locals;
const m = getMessages(locale);
const t = m.gear.eyepieces;

let eyepiece: EyepieceRecord | null = null;
let loadError: string | null = null;
if (supabase) {
  try {
    eyepiece = await eyepieceStore.get(supabase, id);
  } catch {
    loadError = m.errors.load.eyepiece;
  }
  if (!eyepiece && !loadError) {
    Astro.response.status = 404;
  }
}
---

<GearShell title={eyepiece ? eyepiece.name : t.fallbackTitle}>
  <a href="/gear" class="mb-4 inline-block text-sm text-muted-foreground transition-colors hover:text-heading">
    {m.gear.back}
  </a>
  {!supabase ? (
    <DatabaseMissing />
  ) : loadError ? (
    <ServerError message={loadError} />
  ) : eyepiece ? (
    <>
      <h1 class="mb-6 font-display text-3xl font-semibold break-words text-heading sm:text-4xl">{t.editTitle}</h1>
      <div class="rounded-2xl border border-border bg-surface p-4 sm:p-6">
        <EyepieceForm
          action={`/api/gear/eyepieces/${encodeURIComponent(eyepiece.id)}`}
          initial={{
            name: eyepiece.name,
            focalLengthMm: eyepiece.focalLengthMm,
            afovDeg: eyepiece.afovDeg,
          }}
          serverError={error}
          locale={locale}
          client:load
        />
      </div>
      <div class="mt-6">
        <DeleteButton
          action={`/api/gear/eyepieces/${encodeURIComponent(eyepiece.id)}/delete`}
          label={t.delete}
          confirmMessage={t.confirmDelete}
          client:load
        />
      </div>
    </>
  ) : (
    <div class="rounded-2xl border border-border bg-surface p-6">
      <h1 class="font-display text-3xl font-semibold text-heading">{m.gear.notFound}</h1>
      <p class="mt-2 text-sm text-muted-foreground">{t.notFoundText}</p>
      <a href="/gear" class="mt-4 inline-block text-sm font-semibold text-primary hover:underline">
        {m.gear.backToGear}
      </a>
    </div>
  )}
</GearShell>
