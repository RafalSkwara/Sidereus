---
import GearShell from "@/components/gear/GearShell.astro";
import DatabaseMissing from "@/components/gear/DatabaseMissing.astro";
import EyepieceForm from "@/components/gear/EyepieceForm";
import DeleteButton from "@/components/gear/DeleteButton";
import { ServerError } from "@/components/forms/ServerError";
import BackLink from "@/components/ui/BackLink.astro";
import Band from "@/components/ui/Band.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { getMessages } from "@/i18n";
import { eyepieceStore, type EyepieceRecord } from "@/lib/gear/store";

const id = Astro.params.id ?? "";
// `?error=` carries a message key; the form translates it.
const error = Astro.url.searchParams.get("error");
const { supabase, locale } = Astro.locals;
const m = getMessages(locale);
const t = m.gear.eyepieces;

let eyepiece: EyepieceRecord | null = null;
let loadError: string | null = null;
if (supabase) {
  try {
    eyepiece = await eyepieceStore.get(supabase, id);
  } catch {
    loadError = m.errors.load.eyepiece;
  }
  if (!eyepiece && !loadError) {
    Astro.response.status = 404;
  }
}
---

<GearShell title={eyepiece ? eyepiece.name : t.fallbackTitle}>
  <Fragment slot="header">
    <BackLink href="/gear" label={m.gear.backToGear} />
    <div class="mt-2">
      <PageHeader title={eyepiece ? t.editTitle : t.fallbackTitle} />
    </div>
  </Fragment>
  {!supabase ? (
    <DatabaseMissing />
  ) : loadError ? (
    <ServerError message={loadError} />
  ) : eyepiece ? (
    <div>
      <Band headingId="details-heading" heading={m.gear.detailsHeading}>
        <EyepieceForm
          action={`/api/gear/eyepieces/${encodeURIComponent(eyepiece.id)}`}
          initial={{
            name: eyepiece.name,
            focalLengthMm: eyepiece.focalLengthMm,
            afovDeg: eyepiece.afovDeg,
          }}
          serverError={error}
          locale={locale}
          client:load
        />
      </Band>
      <Band headingId="delete-heading" heading={m.gear.deleteHeading}>
        <DeleteButton
          action={`/api/gear/eyepieces/${encodeURIComponent(eyepiece.id)}/delete`}
          label={t.delete}
          confirmMessage={t.confirmDelete}
          cancelLabel={m.common.cancel}
          client:load
        />
      </Band>
    </div>
  ) : (
    <Band headingId="not-found-heading" heading={m.gear.notFound}>
      <p class="text-body text-muted-foreground">{t.notFoundText}</p>
    </Band>
  )}
</GearShell>
