---
import GearShell from "@/components/gear/GearShell.astro";
import DatabaseMissing from "@/components/gear/DatabaseMissing.astro";
import TelescopeForm from "@/components/gear/TelescopeForm";
import DeleteButton from "@/components/gear/DeleteButton";
import { ServerError } from "@/components/forms/ServerError";
import { telescopeStore, type TelescopeRecord } from "@/lib/gear/store";

const LOAD_FAILED = "Could not load the telescope. Please try again.";

const id = Astro.params.id ?? "";
const error = Astro.url.searchParams.get("error");
const { supabase } = Astro.locals;

let telescope: TelescopeRecord | null = null;
let loadError: string | null = null;
if (supabase) {
  try {
    telescope = await telescopeStore.get(supabase, id);
  } catch {
    loadError = LOAD_FAILED;
  }
  if (!telescope && !loadError) {
    Astro.response.status = 404;
  }
}
---

<GearShell title={telescope ? telescope.name : "Telescope"}>
  <a href="/gear" class="mb-4 inline-block text-sm text-muted-foreground transition-colors hover:text-heading">
    ← My gear
  </a>
  {!supabase ? (
    <DatabaseMissing />
  ) : loadError ? (
    <ServerError message={loadError} />
  ) : telescope ? (
    <>
      <h1 class="mb-6 font-display text-3xl font-semibold break-words text-heading sm:text-4xl">Edit telescope</h1>
      <div class="rounded-2xl border border-border bg-surface p-4 sm:p-6">
        <TelescopeForm
          action={`/api/gear/telescopes/${encodeURIComponent(telescope.id)}`}
          initial={{
            name: telescope.name,
            apertureMm: telescope.apertureMm,
            focalLengthMm: telescope.focalLengthMm,
          }}
          serverError={error}
          client:load
        />
      </div>
      <div class="mt-6">
        <DeleteButton
          action={`/api/gear/telescopes/${encodeURIComponent(telescope.id)}/delete`}
          label="Delete telescope"
          confirmMessage="Delete this telescope? This cannot be undone."
          client:load
        />
      </div>
    </>
  ) : (
    <div class="rounded-2xl border border-border bg-surface p-6">
      <h1 class="font-display text-3xl font-semibold text-heading">Not found</h1>
      <p class="mt-2 text-sm text-muted-foreground">This telescope does not exist, or it is not yours.</p>
      <a href="/gear" class="mt-4 inline-block text-sm font-semibold text-primary hover:underline">
        Back to My gear
      </a>
    </div>
  )}
</GearShell>
