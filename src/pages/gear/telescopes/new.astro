---
import GearShell from "@/components/gear/GearShell.astro";
import DatabaseMissing from "@/components/gear/DatabaseMissing.astro";
import TelescopeForm from "@/components/gear/TelescopeForm";

const error = Astro.url.searchParams.get("error");
const { supabase } = Astro.locals;
---

<GearShell title="Add telescope">
  <a href="/gear" class="mb-4 inline-block text-sm text-amber-200/80 hover:text-amber-50">
    ← My gear
  </a>
  <h1 class="mb-6 font-serif text-3xl text-amber-50 sm:text-4xl">Add telescope</h1>
  {supabase ? (
    <div class="rounded-2xl border border-white/10 bg-white/5 p-4 sm:p-6">
      <TelescopeForm action="/api/gear/telescopes" serverError={error} client:load />
    </div>
  ) : (
    <DatabaseMissing />
  )}
</GearShell>
