---
import GearShell from "@/components/gear/GearShell.astro";
import DatabaseMissing from "@/components/gear/DatabaseMissing.astro";
import { ServerError } from "@/components/forms/ServerError";
import {
  eyepieceStore,
  siteStore,
  telescopeStore,
  type EyepieceRecord,
  type SiteRecord,
  type TelescopeRecord,
} from "@/lib/gear/store";
import { EYEPIECE_PRESETS, presetForAfov } from "@/lib/gear/eyepiece-presets";

const SITES_FAILED = "Could not load your sites. Please try again.";
const TELESCOPES_FAILED = "Could not load your telescopes. Please try again.";
const EYEPIECES_FAILED = "Could not load your eyepieces. Please try again.";

const error = Astro.url.searchParams.get("error");
const { supabase } = Astro.locals;

/** Loads one section; a failure only affects that section, never the whole hub. */
async function load<T>(list: () => Promise<T[]>, failed: string): Promise<{ items: T[]; error: string | null }> {
  try {
    return { items: await list(), error: null };
  } catch {
    return { items: [], error: failed };
  }
}

let sites: SiteRecord[] = [];
let telescopes: TelescopeRecord[] = [];
let eyepieces: EyepieceRecord[] = [];
let sitesError: string | null = null;
let telescopesError: string | null = null;
let eyepiecesError: string | null = null;
if (supabase) {
  const [siteResult, telescopeResult, eyepieceResult] = await Promise.all([
    load(() => siteStore.list(supabase), SITES_FAILED),
    load(() => telescopeStore.list(supabase), TELESCOPES_FAILED),
    load(() => eyepieceStore.list(supabase), EYEPIECES_FAILED),
  ]);
  ({ items: sites, error: sitesError } = siteResult);
  ({ items: telescopes, error: telescopesError } = telescopeResult);
  ({ items: eyepieces, error: eyepiecesError } = eyepieceResult);
}

/** f/ratio = focal length ÷ aperture, one decimal, trailing ".0" dropped (650 / 130 → "5"). */
function focalRatio(telescope: TelescopeRecord): string {
  return (telescope.focalLengthMm / telescope.apertureMm).toFixed(1).replace(/\.0$/, "");
}

/** The eyepiece type for a stored AFOV: the preset name without its "(~50°)" hint, or "Other". */
function eyepieceType(afovDeg: number): string {
  const preset = presetForAfov(afovDeg);
  return preset === "other" ? "Other" : EYEPIECE_PRESETS[preset].label.replace(/\s*\(.*\)$/, "");
}

const primaryLink =
  "inline-flex items-center justify-center rounded-lg bg-amber-300 px-4 py-2 text-sm font-medium text-slate-950 transition-colors hover:bg-amber-200";
---

<GearShell title="My gear">
  <p class="mb-2 text-xs tracking-[0.18em] text-amber-200/70 uppercase">Your sky, your kit</p>
  <h1 class="mb-6 font-serif text-4xl text-amber-50 sm:text-5xl">My gear</h1>

  <div class="mb-6 empty:hidden">
    <ServerError message={error} />
  </div>

  {supabase ? (
    <div class="space-y-6">
      <section aria-labelledby="sites-heading" class="rounded-2xl border border-white/10 bg-white/5 p-4 sm:p-6">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
          <h2 id="sites-heading" class="font-serif text-2xl text-amber-50">
            Sites
          </h2>
          <a href="/gear/sites/new" class:list={[primaryLink]}>
            Add site
          </a>
        </div>

        {sitesError ? (
          <ServerError message={sitesError} />
        ) : sites.length === 0 ? (
          <p class="text-sm text-slate-300/70">
            No sites yet. Add the place you observe from, so tonight's verdict uses your sky.
          </p>
        ) : (
          <ul class="divide-y divide-white/10">
            {sites.map((site) => (
              <li>
                <a
                  href={`/gear/sites/${site.id}`}
                  class="-mx-2 block rounded-lg px-2 py-3 transition-colors hover:bg-white/5"
                >
                  <span class="block font-medium break-words text-amber-50">{site.name}</span>
                  <span class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-sm text-slate-300/80">
                    <span>
                      {site.latitudeDeg.toFixed(2)}, {site.longitudeDeg.toFixed(2)}
                    </span>
                    <span>Bortle {site.bortle}</span>
                    <span>Min {site.minAltitudeDeg}°</span>
                    <span class="break-all">
                      {site.timeZone} ({site.timeZoneSource === "manual" ? "pinned" : "auto"})
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section aria-labelledby="telescopes-heading" class="rounded-2xl border border-white/10 bg-white/5 p-4 sm:p-6">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
          <h2 id="telescopes-heading" class="font-serif text-2xl text-amber-50">
            Telescopes
          </h2>
          <a href="/gear/telescopes/new" class:list={[primaryLink]}>
            Add telescope
          </a>
        </div>

        {telescopesError ? (
          <ServerError message={telescopesError} />
        ) : telescopes.length === 0 ? (
          <p class="text-sm text-slate-300/70">
            No telescopes yet. Add yours, so the suggested magnifications fit your scope.
          </p>
        ) : (
          <ul class="divide-y divide-white/10">
            {telescopes.map((telescope) => (
              <li>
                <a
                  href={`/gear/telescopes/${telescope.id}`}
                  class="-mx-2 block rounded-lg px-2 py-3 transition-colors hover:bg-white/5"
                >
                  <span class="block font-medium break-words text-amber-50">{telescope.name}</span>
                  <span class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-sm text-slate-300/80">
                    <span>{telescope.apertureMm} mm aperture</span>
                    <span>{telescope.focalLengthMm} mm focal length</span>
                    <span>f/{focalRatio(telescope)}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section aria-labelledby="eyepieces-heading" class="rounded-2xl border border-white/10 bg-white/5 p-4 sm:p-6">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
          <h2 id="eyepieces-heading" class="font-serif text-2xl text-amber-50">
            Eyepieces
          </h2>
          <a href="/gear/eyepieces/new" class:list={[primaryLink]}>
            Add eyepiece
          </a>
        </div>

        {eyepiecesError ? (
          <ServerError message={eyepiecesError} />
        ) : eyepieces.length === 0 ? (
          <p class="text-sm text-slate-300/70">
            No eyepieces yet. Add the ones in your case, so each object gets a pair you actually own.
          </p>
        ) : (
          <ul class="divide-y divide-white/10">
            {eyepieces.map((eyepiece) => (
              <li>
                <a
                  href={`/gear/eyepieces/${eyepiece.id}`}
                  class="-mx-2 block rounded-lg px-2 py-3 transition-colors hover:bg-white/5"
                >
                  <span class="block font-medium break-words text-amber-50">{eyepiece.name}</span>
                  <span class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-sm text-slate-300/80">
                    <span>{eyepiece.focalLengthMm} mm</span>
                    <span>
                      {eyepiece.afovDeg}° AFOV · {eyepieceType(eyepiece.afovDeg)}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>
    </div>
  ) : (
    <DatabaseMissing />
  )}
</GearShell>
