---
import { Plus } from "lucide-react";
import GearShell from "@/components/gear/GearShell.astro";
import DatabaseMissing from "@/components/gear/DatabaseMissing.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import Band from "@/components/ui/Band.astro";
import Notice from "@/components/ui/Notice.astro";
import { buttonVariants } from "@/components/ui/button";
import { ServerError } from "@/components/forms/ServerError";
import {
  eyepieceStore,
  siteStore,
  telescopeStore,
  type EyepieceRecord,
  type SiteRecord,
  type TelescopeRecord,
} from "@/lib/gear/store";
import { presetForAfov } from "@/lib/gear/eyepiece-presets";
import { getMessages, translateKey, type MessageKey } from "@/i18n";
import { formatLocaleTag } from "@/lib/tonight/format";

const SITES_FAILED: MessageKey = "errors.load.sites";
const TELESCOPES_FAILED: MessageKey = "errors.load.telescopes";
const EYEPIECES_FAILED: MessageKey = "errors.load.eyepieces";

/** The kinds a `?saved=` / `?deleted=` value may name; the gear routes redirect with exactly these. */
const GEAR_KINDS = ["site", "telescope", "eyepiece"] as const;
type GearKind = (typeof GEAR_KINDS)[number];
const asGearKind = (value: string | null): GearKind | null => GEAR_KINDS.find((kind) => kind === value) ?? null;

const { supabase, locale } = Astro.locals;
const m = getMessages(locale);
// Stored gear values carry at most one decimal; coordinates are stored rounded to two. No grouping, so 1000 mm stays "1000".
const decimal = new Intl.NumberFormat(formatLocaleTag(locale), { useGrouping: false, maximumFractionDigits: 1 });
const coordinate = new Intl.NumberFormat(formatLocaleTag(locale), {
  useGrouping: false,
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});
const num = (n: number) => decimal.format(n);
// Polish uses decimal commas, so "52,23, 21,01" would be ambiguous there.
const coordinateSeparator = locale === "pl" ? "; " : ", ";
const coordinates = (site: { latitudeDeg: number; longitudeDeg: number }) =>
  `${coordinate.format(site.latitudeDeg)}${coordinateSeparator}${coordinate.format(site.longitudeDeg)}`;
const t = m.gear;
const params = Astro.url.searchParams;
const translate = (key: string | null) => (key ? translateKey(m, key, "errors.generic") : null);
// `?error=` carries a message key; anything else reads as the generic message.
const error = translate(params.get("error"));
// `?saved=` / `?deleted=` name a gear kind from the fixed set; any other value shows nothing.
const savedKind = asGearKind(params.get("saved"));
const deletedKind = asGearKind(params.get("deleted"));
const notice = savedKind ? t.notice.saved[savedKind] : deletedKind ? t.notice.deleted[deletedKind] : null;

/** Loads one section; a failure only affects that section, never the whole hub. */
async function load<T>(
  list: () => Promise<T[]>,
  failed: MessageKey,
): Promise<{ items: T[]; error: MessageKey | null }> {
  try {
    return { items: await list(), error: null };
  } catch {
    return { items: [], error: failed };
  }
}

let sites: SiteRecord[] = [];
let telescopes: TelescopeRecord[] = [];
let eyepieces: EyepieceRecord[] = [];
let sitesError: MessageKey | null = null;
let telescopesError: MessageKey | null = null;
let eyepiecesError: MessageKey | null = null;
if (supabase) {
  const [siteResult, telescopeResult, eyepieceResult] = await Promise.all([
    load(() => siteStore.list(supabase), SITES_FAILED),
    load(() => telescopeStore.list(supabase), TELESCOPES_FAILED),
    load(() => eyepieceStore.list(supabase), EYEPIECES_FAILED),
  ]);
  ({ items: sites, error: sitesError } = siteResult);
  ({ items: telescopes, error: telescopesError } = telescopeResult);
  ({ items: eyepieces, error: eyepiecesError } = eyepieceResult);
}

/*
 * One primary action at most: the first kind Tonight needs that is missing (a site, then a telescope; eyepieces are
 * optional). A band that failed to load is not "missing". Other empty bands get an outline action, filled ones a
 * action one (border, tinted surface and the Plus icon).
 */
const missingSites = !sitesError && sites.length === 0;
const missingTelescopes = !telescopesError && telescopes.length === 0;
const primaryKind: GearKind | null = missingSites ? "site" : missingTelescopes ? "telescope" : null;
const addClass = (kind: GearKind, empty: boolean) =>
  kind === primaryKind
    ? buttonVariants({ variant: "default" })
    : empty
      ? buttonVariants({ variant: "outline" })
      : buttonVariants({ variant: "action", size: "sm" });

const rowLink =
  "-mx-2 flex min-h-11 flex-col justify-center rounded-lg px-2 py-3 transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring";
const rowName = "text-body font-semibold break-words text-heading";
const rowMeta = "mt-1 flex flex-wrap gap-x-4 gap-y-1 text-label text-muted-foreground";

/** f/ratio = focal length ÷ aperture, one decimal, trailing ".0" dropped (650 / 130 → "5"). */
function focalRatio(telescope: TelescopeRecord): string {
  return num(telescope.focalLengthMm / telescope.apertureMm);
}

/** The eyepiece type for a stored AFOV: the preset's short name, or "Other". */
function eyepieceType(afovDeg: number): string {
  const preset = presetForAfov(afovDeg);
  return preset === "other" ? t.eyepieces.otherType : m.eyepiecePresets[preset].short;
}
---

<GearShell title={t.title}>
  <PageHeader slot="header" title={t.title} subtitle={t.subtitle} />

  {notice && (
    <Notice tone="success" toast param={savedKind ? "saved" : "deleted"}>
      {notice}
    </Notice>
  )}

  <div class="mb-6 empty:hidden">
    <ServerError message={error} />
  </div>

  {supabase ? (
    <div>
      <Band headingId="sites-heading" heading={t.sites.heading}>
        <a slot="action" href="/gear/sites/new" class:list={addClass("site", sites.length === 0)}>
          <Plus aria-hidden="true" />
          {t.sites.add}
        </a>
        {sitesError ? (
          <ServerError message={translate(sitesError)} />
        ) : sites.length === 0 ? (
          <div>
            <p class="text-body font-semibold text-heading">{t.sites.emptyTitle}</p>
            <p class="mt-1 text-body text-muted-foreground">{t.sites.emptyWhy}</p>
          </div>
        ) : (
          <ul class="divide-y divide-border">
            {sites.map((site) => (
              <li>
                <a href={`/gear/sites/${site.id}`} class:list={rowLink}>
                  <span data-item-name class:list={rowName}>
                    {site.name}
                  </span>
                  <span class:list={rowMeta}>
                    <span>{coordinates(site)}</span>
                    <span>{t.sites.bortle({ bortle: num(site.bortle) })}</span>
                    <span>{t.sites.minAltitude({ degrees: num(site.minAltitudeDeg) })}</span>
                    <span class="break-all">
                      {site.timeZone} ({site.timeZoneSource === "manual" ? t.sites.zonePinned : t.sites.zoneAuto})
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </Band>

      <Band headingId="telescopes-heading" heading={t.telescopes.heading}>
        <a slot="action" href="/gear/telescopes/new" class:list={addClass("telescope", telescopes.length === 0)}>
          <Plus aria-hidden="true" />
          {t.telescopes.add}
        </a>
        {telescopesError ? (
          <ServerError message={translate(telescopesError)} />
        ) : telescopes.length === 0 ? (
          <div>
            <p class="text-body font-semibold text-heading">{t.telescopes.emptyTitle}</p>
            <p class="mt-1 text-body text-muted-foreground">{t.telescopes.emptyWhy}</p>
          </div>
        ) : (
          <ul class="divide-y divide-border">
            {telescopes.map((telescope) => (
              <li>
                <a href={`/gear/telescopes/${telescope.id}`} class:list={rowLink}>
                  <span data-item-name class:list={rowName}>
                    {telescope.name}
                  </span>
                  <span class:list={rowMeta}>
                    <span>{t.telescopes.aperture({ mm: num(telescope.apertureMm) })}</span>
                    <span>{t.telescopes.focalLength({ mm: num(telescope.focalLengthMm) })}</span>
                    <span>f/{focalRatio(telescope)}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </Band>

      <Band headingId="eyepieces-heading" heading={t.eyepieces.heading}>
        <a slot="action" href="/gear/eyepieces/new" class:list={addClass("eyepiece", eyepieces.length === 0)}>
          <Plus aria-hidden="true" />
          {t.eyepieces.add}
        </a>
        {eyepiecesError ? (
          <ServerError message={translate(eyepiecesError)} />
        ) : eyepieces.length === 0 ? (
          <div>
            <p class="text-body font-semibold text-heading">{t.eyepieces.emptyTitle}</p>
            <p class="mt-1 text-body text-muted-foreground">{t.eyepieces.emptyWhy}</p>
          </div>
        ) : (
          <ul class="divide-y divide-border">
            {eyepieces.map((eyepiece) => (
              <li>
                <a href={`/gear/eyepieces/${eyepiece.id}`} class:list={rowLink}>
                  <span data-item-name class:list={rowName}>
                    {eyepiece.name}
                  </span>
                  <span class:list={rowMeta}>
                    <span>{t.eyepieces.focalLength({ mm: num(eyepiece.focalLengthMm) })}</span>
                    <span>
                      {t.eyepieces.afov({ degrees: num(eyepiece.afovDeg), type: eyepieceType(eyepiece.afovDeg) })}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </Band>
    </div>
  ) : (
    <DatabaseMissing />
  )}
</GearShell>
