---
// Every object that cleared tonight's bar (tonight-all-objects), for the same site and telescope as Tonight. The
// shell resolves the gear and the order and paints at once; AllObjectsContent streams the list in.
import GearShell from "@/components/gear/GearShell.astro";
import DatabaseMissing from "@/components/gear/DatabaseMissing.astro";
import AllObjectsContent from "@/components/tonight/AllObjectsContent.astro";
import Attribution from "@/components/tonight/Attribution.astro";
import { getMessages } from "@/i18n";
import { parseSort } from "@/lib/tonight/all-objects";
import { requestedGear } from "@/lib/tonight/requested-gear";

const { supabase, locale } = Astro.locals;
const t = getMessages(locale).tonight;
const { siteId, telescopeId } = requestedGear(Astro.url, Astro.cookies);
const sort = parseSort(Astro.url.searchParams.get("sort"));
// bg-border, not bg-muted: --muted is the surface colour, so muted bars vanish inside the rows.
const bar = "rounded bg-border motion-safe:animate-pulse";
---

<GearShell title={t.all.title}>
  {supabase ? (
    <AllObjectsContent server:defer siteId={siteId} telescopeId={telescopeId} sort={sort}>
      <div slot="fallback" role="status" aria-busy="true">
        <span class="sr-only">{t.loading}</span>
        <div class:list={[bar, "mb-6 h-4 w-20"]}></div>
        <div class:list={[bar, "mb-3 h-3 w-40"]}></div>
        <div class:list={[bar, "mb-3 h-9 w-72"]}></div>
        <div class:list={[bar, "mb-6 h-3 w-48"]}></div>
        <ul class="grid gap-2" aria-hidden="true">
          {Array.from({ length: 8 }, () => (
            <li class="flex h-14 items-center gap-3 rounded-xl border border-border bg-surface px-4">
              <div class:list={[bar, "h-4 w-6"]}></div>
              <div class:list={[bar, "h-4 flex-1"]}></div>
              <div class:list={[bar, "h-4 w-12"]}></div>
            </li>
          ))}
        </ul>
      </div>
    </AllObjectsContent>
  ) : (
    <>
      <h1 class="mb-2 font-display text-4xl font-semibold text-heading">{t.all.title}</h1>
      <DatabaseMissing />
    </>
  )}

  <div class="mt-10 border-t border-border pt-4">
    <Attribution />
  </div>
</GearShell>
