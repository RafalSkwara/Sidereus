---
// The Session plan focused page (session-plan-timeline): tonight's targets on one night axis, for the site and
// telescope picked on Tonight. The shell reads the gear, the save toast and the refusal (`?saved=`, `?error=`, which
// POST /api/tonight/plan and /reset redirect with, adjustable-session-plan) and paints at once; PlanPageContent streams
// the timeline in under the slim page sky. The page has no "Mark observed", so it has no log notice. The page itself
// stays free (FR-031): only editing, the editor and the edited rows are gated, inside the island.
import GearShell from "@/components/gear/GearShell.astro";
import DatabaseMissing from "@/components/gear/DatabaseMissing.astro";
import Attribution from "@/components/tonight/Attribution.astro";
import PlanPageContent from "@/components/tonight/PlanPageContent.astro";
import TonightPageSkeleton from "@/components/tonight/TonightPageSkeleton.astro";
import TonightPageSky from "@/components/tonight/TonightPageSky.astro";
import TonightSubNav from "@/components/tonight/TonightSubNav.astro";
import Notice from "@/components/ui/Notice.astro";
import { getMessages, isMessageKey, translateKey } from "@/i18n";
import { parsePlanSaved } from "@/lib/session-plans/redirect";
import { requestedGear, requestedNight } from "@/lib/tonight/requested-gear";

const { supabase, locale } = Astro.locals;
const m = getMessages(locale);
const title = m.tonight.summary.plan;
// The refusal of a save or reset: a catalogue key only (never a sentence or a value), translated here and shown by the
// island above the plan (the `planets.astro` pattern). `?saved=plan|plan-reset` is the toast, a fixed pair.
const errorParam = Astro.url.searchParams.get("error");
const error = errorParam && isMessageKey(errorParam) ? translateKey(m, errorParam, "errors.generic") : null;
const saved = parsePlanSaved(Astro.url.searchParams.get("saved"));

// The site and telescope picked on Tonight (or remembered on this device); see requested-gear.ts.
const { siteId, telescopeId } = requestedGear(Astro.url, Astro.cookies);
// `?night=next` is the evening after tonight, the copy the service worker stores for offline use.
const night = requestedNight(Astro.url);
---

<GearShell title={title} skyFlow>
  <TonightSubNav slot="subnav" />

  {saved && (
    <>
      <Notice tone="success" toast param="saved">
        {saved === "plan" ? m.tonight.pages.plan.saved : m.tonight.pages.plan.resetDone}
      </Notice>
      {/* The page script asks the service worker to store this page's clean URL once (D7 b); nothing is shown. */}
      <span hidden data-store-after-save></span>
    </>
  )}

  {supabase ? (
    <PlanPageContent server:defer siteId={siteId} telescopeId={telescopeId} night={night} error={error}>
      <TonightPageSkeleton slot="fallback" title={title} reloadHref="/tonight/plan" rows={4} layout="plan" />
    </PlanPageContent>
  ) : (
    <>
      <TonightPageSky title={title} view={null} />
      <div class="mx-auto w-full max-w-3xl px-4 pt-8">
        <DatabaseMissing />
      </div>
    </>
  )}

  <div class="mx-auto w-full max-w-3xl px-4">
    <div class="mt-10 border-t border-border pt-4">
      <Attribution />
    </div>
  </div>
</GearShell>

<script>
  import { storeAfterSave } from "@/lib/offline/page-state";

  storeAfterSave();
</script>
