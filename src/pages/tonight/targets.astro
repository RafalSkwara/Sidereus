---
// The Targets focused page (tonight-dashboard, taking over tonight-all-objects' /tonight/all): tonight's best objects
// for the site and telescope picked on Tonight, then the rest of what cleared the bar behind a button (by rank or by
// best time), then the ones the Moon washes out. The shell reads the gear, the order and the notice and paints at
// once; TargetsPageContent streams the list in under the slim page sky.
import GearShell from "@/components/gear/GearShell.astro";
import DatabaseMissing from "@/components/gear/DatabaseMissing.astro";
import Attribution from "@/components/tonight/Attribution.astro";
import TargetsPageContent from "@/components/tonight/TargetsPageContent.astro";
import TonightPageSkeleton from "@/components/tonight/TonightPageSkeleton.astro";
import TonightPageSky from "@/components/tonight/TonightPageSky.astro";
import { getMessages, isMessageKey, translateKey } from "@/i18n";
import { parseTargetParam } from "@/lib/targets";
import { targetLabel } from "@/lib/targets/labels";
import { parseSort } from "@/lib/tonight/all-objects";
import { pickTonightNotice } from "@/lib/tonight/notice";
import { requestedGear, requestedNight } from "@/lib/tonight/requested-gear";

const { supabase, locale } = Astro.locals;
const m = getMessages(locale);
const t = m.tonight;
const title = t.pages.targets;
// After "Mark observed" here, POST /api/log returns with `?logged=<target key>` (`from=targets`). Read in the shell:
// the island's own Astro.url carries no page query. Only catalogue keys are shown for `?error`.
const loggedTarget = parseTargetParam(Astro.url.searchParams.get("logged"));
const logged = loggedTarget ? targetLabel(loggedTarget, locale) : null;
const errorParam = Astro.url.searchParams.get("error");
const error = errorParam && isMessageKey(errorParam) ? translateKey(m, errorParam, "errors.generic") : null;
const notice = pickTonightNotice({
  error,
  logged: logged ? t.logged({ object: logged.id }) : null,
  skyChecked: null,
});

// The site and telescope picked on Tonight (or remembered on this device); see requested-gear.ts.
const { siteId, telescopeId } = requestedGear(Astro.url, Astro.cookies);
// `?night=next` is the evening after tonight, the copy the service worker stores for offline use.
const night = requestedNight(Astro.url);
// A fixed enum ("rank" | "time"), so it travels to the island as is.
const sort = parseSort(Astro.url.searchParams.get("sort"));
// A sort link sits inside the rest of the list, so a page that came with one opens it again.
const restOpen = Astro.url.searchParams.has("sort");
---

<GearShell title={title} skyFlow>
  {supabase ? (
    <TargetsPageContent
      server:defer
      siteId={siteId}
      telescopeId={telescopeId}
      night={night}
      sort={sort}
      notice={notice}
      restOpen={restOpen}
      logged={loggedTarget}
    >
      <TonightPageSkeleton slot="fallback" title={title} reloadHref="/tonight/targets" rows={8} />
    </TargetsPageContent>
  ) : (
    <>
      <TonightPageSky title={title} view={null} />
      <div class="mx-auto w-full max-w-3xl px-4 pt-8">
        <DatabaseMissing />
      </div>
    </>
  )}

  <div class="mx-auto w-full max-w-3xl px-4">
    <div class="mt-10 border-t border-border pt-4">
      <Attribution />
    </div>
  </div>
</GearShell>

<script>
  import { fragmentTarget, scrollToWhenRendered } from "@/lib/tonight/hash-scroll";

  // The list streams in through the server island after the browser has already tried the URL's fragment (the Moon
  // page's washed-out link and old /tonight/all#washed-out bookmarks land on #washed-out, a sort link on #more, the
  // live sky's markers on #object-<id>), so scroll to the target once the island has inserted it. A target that is a
  // closed <details> (#more) opens first. Without a fragment, a return from "Mark observed" on one of the rest brings
  // that row into view instead (TargetsPageContent opens the list for it and names it in `data-logged-row`).
  if (location.hash || new URLSearchParams(location.search).has("logged")) {
    scrollToWhenRendered(() => {
      if (location.hash) {
        const target = fragmentTarget();
        return target ? { target, block: "start" } : null;
      }
      const list = document.querySelector<HTMLElement>("[data-logged-row]");
      const key = list?.dataset.loggedRow;
      const row = key ? list.querySelector(`[data-object="${CSS.escape(key)}"]`) : null;
      return row ? { target: row, block: "center" } : null;
    });
  }
</script>
