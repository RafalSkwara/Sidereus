---
import { ArrowLeft, CircleCheck, MailCheck } from "lucide-react";
import AuthShell from "@/components/AuthShell.astro";
import { buttonVariants } from "@/components/ui/button";
import { getMessages } from "@/i18n";
import { cn } from "@/lib/utils";

const isAutoConfirmed = import.meta.env.DEV;
const t = getMessages(Astro.locals.locale).auth.confirmEmail;

// Icons, not emoji: an emoji keeps its own colours, which red night mode cannot reach.
const content = isAutoConfirmed
  ? { Icon: CircleCheck, tone: "text-go", ...t.registered }
  : { Icon: MailCheck, tone: "text-primary-strong", ...t.checkEmail };
const { Icon } = content;
---

<AuthShell title={content.heading}>
  <div slot="icon" class="mb-4">
    <Icon className={cn("size-10", content.tone)} aria-hidden="true" />
  </div>
  <p class="text-body text-foreground">{content.description}</p>
  <a href="/auth/signin" class:list={cn(buttonVariants({ variant: "action", size: "sm" }), "mt-4")}>
    <ArrowLeft aria-hidden="true" />
    {content.link}
  </a>
</AuthShell>
