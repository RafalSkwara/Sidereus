---
import AuthShell from "@/components/AuthShell.astro";
import { getMessages } from "@/i18n";

const isAutoConfirmed = import.meta.env.DEV;
const t = getMessages(Astro.locals.locale).auth.confirmEmail;

const content = isAutoConfirmed
  ? { emoji: "✅", heading: t.registered.heading, description: t.registered.description, linkText: t.registered.link }
  : { emoji: "📧", heading: t.checkEmail.heading, description: t.checkEmail.description, linkText: t.checkEmail.link };
---

<AuthShell title={content.heading} centered>
  <div slot="icon" class="mb-4 text-5xl">
    {content.emoji}
  </div>
  <p class="mb-6 text-foreground">{content.description}</p>
  <a href="/auth/signin" class="text-sm font-semibold text-primary hover:underline">
    {content.linkText}
  </a>
</AuthShell>
