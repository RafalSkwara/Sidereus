---
import AuthShell from "@/components/AuthShell.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import { getMessages } from "@/i18n";

// `?error=` carries a message key; the form translates it.
const error = Astro.url.searchParams.get("error");
const { locale } = Astro.locals;
const t = getMessages(locale).auth.signUp;
---

<AuthShell title={t.title}>
  <SignUpForm serverError={error} locale={locale} client:load />
  <p class="mt-4 text-center text-sm text-muted-foreground">
    {t.haveAccount}{" "}
    <a href="/auth/signin" class="font-semibold text-primary hover:underline">
      {t.signInLink}
    </a>
  </p>
</AuthShell>
