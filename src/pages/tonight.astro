---
import GearShell from "@/components/gear/GearShell.astro";
import DatabaseMissing from "@/components/gear/DatabaseMissing.astro";
import Attribution from "@/components/tonight/Attribution.astro";
import TonightContent from "@/components/tonight/TonightContent.astro";
import TonightSkeleton from "@/components/tonight/TonightSkeleton.astro";
import { CircleCheck } from "lucide-react";
import { getMessages } from "@/i18n";
import { findMessier } from "@/lib/catalogue";
import { PREFERENCE_COOKIE_MAX_AGE } from "@/lib/preferences";
import { isTelescopeId, TELESCOPE_COOKIE } from "@/lib/tonight/telescope-choice";

const { supabase, locale } = Astro.locals;
const t = getMessages(locale).tonight;
// After a save, POST /api/log returns here with `?logged=<Messier number>`. Read in the shell: inside the
// server island below, Astro.url is the island's own request and carries no page query.
const loggedParam = Astro.url.searchParams.get("logged") ?? "";
const logged = /^\d{1,3}$/.test(loggedParam) ? findMessier(Number(loggedParam)) : undefined;

// FR-019: a telescope picked in the selector (`?telescope=<id>`) is remembered on this device, so plain /tonight
// (the post-log redirect included) keeps it. Only the shape is checked here; the island resolves the id
// against the user's own telescopes and falls back to the oldest. Set here, not in the island: the island's
// request carries no page query, so the requested id reaches it as a prop.
const telescopeParam = Astro.url.searchParams.get("telescope");
if (isTelescopeId(telescopeParam)) {
  Astro.cookies.set(TELESCOPE_COOKIE, telescopeParam, {
    path: "/",
    maxAge: PREFERENCE_COOKIE_MAX_AGE,
    sameSite: "lax",
    httpOnly: true,
    secure: Astro.url.protocol === "https:",
  });
}
const telescopeCookie = Astro.cookies.get(TELESCOPE_COOKIE)?.value;
const requestedTelescope = isTelescopeId(telescopeParam)
  ? telescopeParam
  : isTelescopeId(telescopeCookie)
    ? telescopeCookie
    : undefined;
---

<GearShell title={t.title}>
  {logged && (
    <p
      role="status"
      class="mb-6 flex items-center gap-2 rounded-lg border border-go-border bg-go-surface px-3 py-2 text-sm text-foreground"
    >
      <CircleCheck className="size-4 shrink-0 text-go" aria-hidden="true" />
      {t.logged({ object: logged.id })}
    </p>
  )}
  {supabase ? (
    // The shell responds without waiting on Supabase, KV or Open-Meteo; the island streams the data in.
    <TonightContent server:defer telescopeId={requestedTelescope}>
      <TonightSkeleton slot="fallback" />
    </TonightContent>
  ) : (
    <>
      <p class="mb-2 text-xs font-semibold tracking-[0.18em] text-primary uppercase">{t.kicker}</p>
      <h1 class="mb-2 font-display text-4xl font-semibold text-heading sm:text-5xl">{t.title}</h1>
      <DatabaseMissing />
    </>
  )}

  <div class="mt-10 border-t border-border pt-4">
    <Attribution />
  </div>
</GearShell>
