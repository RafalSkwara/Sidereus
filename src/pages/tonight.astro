---
import GearShell from "@/components/gear/GearShell.astro";
import DatabaseMissing from "@/components/gear/DatabaseMissing.astro";
import Attribution from "@/components/tonight/Attribution.astro";
import TonightContent from "@/components/tonight/TonightContent.astro";
import TonightSkeleton from "@/components/tonight/TonightSkeleton.astro";
import TonightSky from "@/components/tonight/TonightSky.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { getMessages, isMessageKey, translateKey } from "@/i18n";
import { hasSkyCheckedNotice } from "@/lib/sky-checks/redirect";
import { parseTargetParam } from "@/lib/targets";
import { targetLabel } from "@/lib/targets/labels";
import { pickTonightNotice } from "@/lib/tonight/notice";
import { requestedGear } from "@/lib/tonight/requested-gear";

const { supabase, locale } = Astro.locals;
const m = getMessages(locale);
const t = m.tonight;
// After a save, POST /api/log returns here with `?logged=<target key>` (a bare Messier number from an older link
// still reads). Read in the shell: inside the server island below, Astro.url is the island's own request and
// carries no page query.
const loggedTarget = parseTargetParam(Astro.url.searchParams.get("logged"));
const logged = loggedTarget ? targetLabel(loggedTarget, locale) : null;
// After the sky question (verdict-check), POST /api/log/sky/[id] returns here with `?skyChecked=1`, or with
// `?error=<message key>` when the answer could not be saved. Only catalogue keys are shown.
const skyChecked = hasSkyCheckedNotice(Astro.url.searchParams);
const errorParam = Astro.url.searchParams.get("error");
const error = errorParam && isMessageKey(errorParam) ? translateKey(m, errorParam, "errors.generic") : null;
// Resolved here to catalogue text and handed to the island, which shows it under the sky (tonight-nightfall).
const notice = pickTonightNotice({
  error,
  logged: logged ? t.logged({ object: logged.id }) : null,
  skyChecked: skyChecked ? m.skyChecks.saved : null,
});

// The site and telescope picked in a selector (or remembered on this device); see requested-gear.ts.
const { siteId: requestedSite, telescopeId: requestedTelescope } = requestedGear(Astro.url, Astro.cookies);
---

<GearShell title={t.title} skyFlow>
  {supabase ? (
    // The shell responds without waiting on Supabase, KV or Open-Meteo; the island streams the data in, sky first.
    <TonightContent server:defer siteId={requestedSite} telescopeId={requestedTelescope} notice={notice}>
      <TonightSkeleton slot="fallback" />
    </TonightContent>
  ) : (
    <>
      <TonightSky>
        <PageHeader title={t.title} />
      </TonightSky>
      <div class="mx-auto w-full max-w-3xl px-4 pt-8">
        <DatabaseMissing />
      </div>
    </>
  )}

  <div class="mx-auto w-full max-w-3xl px-4">
    <div class="mt-10 border-t border-border pt-4">
      <Attribution />
    </div>
  </div>
</GearShell>
