---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { getMessages, translateKey } from "@/i18n";
import { missingConfigs } from "@/lib/config-status";

interface Props {
  title?: string;
}

const { theme, locale } = Astro.locals;
const m = getMessages(locale);
const { title = m.common.appName } = Astro.props;
---

<!doctype html>
<html lang={locale} data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    {missingConfigs.map((cfg) => (
      <Banner variant="error">
        <strong>{m.config.warning}</strong> {translateKey(m, cfg.message, "errors.generic")}
        {cfg.docsUrl && (
          <>
            {" "}
            <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
              {cfg.docsLabel ? translateKey(m, cfg.docsLabel, "config.docs") : m.config.docs}
            </a>
            .
          </>
        )}
      </Banner>
    ))}
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
