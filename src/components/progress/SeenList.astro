---
// The seen objects of one checklist, in catalogue order (observing-progress, M-3 S-05): "M31 · Andromeda Galaxy" (a Caldwell
// row leads with its number, "C20 · NGC 7000 · North America Nebula") and the night it was first logged with a rating
// of 3 or above. It is the only place the first night shows. Since ui-progress-rewards (owner P8 A) it sits in a native
// `<details>`, closed on load, whose summary reads "Seen so far · 5"; no script, and the rows stay in the DOM. Renders
// nothing while none is seen. The row wraps, so a long Polish name stays inside a 320 px column.
import { ChevronDown } from "lucide-react";

import { getMessages } from "@/i18n";
import { localCommonName } from "@/lib/catalogue/common-names";
import type { ChecklistItem } from "@/lib/progress/progress";
import { createFormatter } from "@/lib/tonight/format";

interface Props {
  /** The checklist's items; only the seen ones are listed. */
  items: readonly ChecklistItem[];
  /** "C" puts the Caldwell number first ("C20 · NGC 7000"), so a row matches its chip; "M" (default) adds nothing. */
  prefix?: "M" | "C";
  /** The list's accessible name ("Seen so far"). */
  label: string;
}

const { items, prefix = "M", label } = Astro.props;
const { locale } = Astro.locals;
const t = getMessages(locale).progress;
const format = createFormatter(locale);
const seen = items.flatMap((item) => (item.seen ? [{ item, seen: item.seen }] : []));
---

{seen.length > 0 && (
  <details class="group mt-group" data-seen-details>
    {/* At least 44 px. Closed on load (owner P8 A): the tiles above already name every seen object. */}
    <summary
      class:list={[
        "-mx-2 flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-lg px-2 [&::-webkit-details-marker]:hidden",
        "text-label font-semibold text-heading transition-colors hover:bg-accent motion-reduce:transition-none",
        "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring",
      ]}
    >
      <span class="min-w-0 flex-1 break-words">{`${t.seenHeading} · ${String(seen.length)}`}</span>
      <ChevronDown
        className="size-5 shrink-0 text-muted-foreground transition-transform duration-150 group-open:rotate-180 motion-reduce:transition-none"
        aria-hidden="true"
      />
    </summary>
    <ul aria-label={label} class="mt-line divide-y divide-border" data-seen-list>
      {seen.map(({ item, seen: summary }) => {
        const name = localCommonName(item.id, item.commonName, locale);
        return (
          <li class="py-item first:pt-0 last:pb-0" data-seen-item={item.id}>
            <p class="text-body font-semibold break-words text-heading">
              {prefix === "C" && `${prefix}${item.number} · `}
              {item.label}
              {name && <span class="font-normal text-foreground"> · {name}</span>}
              <span class="font-normal text-muted-foreground">
                {" · "}
                {t.firstSeen({ date: format.formatShortDate(summary.firstNight) })}
              </span>
            </p>
          </li>
        );
      })}
    </ul>
  </details>
)}
