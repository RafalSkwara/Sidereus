---
// The progress page's "Milestones" band (observing-milestones, M-3 S-06, FR-041, US-06): every milestone of the fixed
// set in `MILESTONES` order, the reached ones with a check, the name and the night they were reached ("Reached 12 Sep
// 2026"), the ones still ahead muted with "Not yet" or, for a count milestone, how far along ("7 / 10"). A reached
// row is a check plus a heavier name in the heading ink, a row still ahead is an empty slot plus a regular muted name,
// so red mode tells them apart by icon and weight, not hue. `data-milestone` (the key) and `data-reached` (present
// only when reached) are the e2e hooks. The row wraps, so a long Polish name stays inside a 320 px column.
import { Check } from "lucide-react";

import Band from "@/components/ui/Band.astro";
import { getMessages } from "@/i18n";
import type { MilestoneState } from "@/lib/progress/milestones";
import { createFormatter } from "@/lib/tonight/format";

interface Props {
  /** One state per milestone in `MILESTONES` order (`withStored(milestonesOf(progress), stored)`). */
  states: readonly MilestoneState[];
  /** The heading's id, so `/design` can show the band more than once. */
  headingId?: string;
}

const { states, headingId = "progress-milestones-heading" } = Astro.props;
const { locale } = Astro.locals;
const t = getMessages(locale).progress.milestones;
const format = createFormatter(locale);
---

<Band headingId={headingId} heading={t.title}>
  <ul class="divide-y divide-border" data-milestone-list>
    {states.map((state) => {
      const reached = state.reachedNight !== null;
      return (
        <li
          class="flex items-baseline gap-x-3 py-3 first:pt-0 last:pb-0"
          data-milestone={state.key}
          data-reached={reached ? "" : undefined}
        >
          <span class="flex size-4 shrink-0 translate-y-0.5 items-center justify-center">
            {reached && <Check className="size-4 text-heading" aria-hidden="true" />}
          </span>
          <span class="flex min-w-0 flex-1 flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <span
              class:list={[
                "text-body break-words",
                reached ? "font-semibold text-heading" : "font-normal text-muted-foreground",
              ]}
            >
              {t.name[state.key]}
            </span>
            <span class="text-label text-muted-foreground">
              {state.reachedNight !== null
                ? t.reachedOn({ date: format.formatShortDate(state.reachedNight) })
                : state.progress
                  ? t.progress({ seen: String(state.progress.seen), total: String(state.progress.total) })
                  : t.notYet}
            </span>
          </span>
        </li>
      );
    })}
  </ul>
</Band>
