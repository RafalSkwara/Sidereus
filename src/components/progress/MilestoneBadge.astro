---
// One milestone's badge (ui-progress-rewards, owner P1 C / P2 B): a decorative medallion shared by the Milestones band
// (`md`, 112 px) and the celebration dialog (`lg`, 128 px). One SVG in the 120-unit badge space: the disc, the
// milestone's own illustration (`badge-art/`, picked by an exhaustive `switch`) clipped inside it, the ring, the
// progress arc and the check pip.
// Reached: the sky-gradient disc, the art in full, a solid `action-border` ring and the pip. Ahead: a `surface` disc, the
// art dimmed per theme (light 0.3, dark 0.4, red 0.6: owner call (b), 2026-10-17), a dashed `control-border` ring and,
// when the milestone has progress above 0, a solid, wider `primary-strong` arc proportional to it. Red mode has one hue,
// so the states differ by shape: solid vs. dashed ring, the pip, the arc's width. It sits in a `night-sky` scope, so in
// the light theme it stays a navy night window (owner, 2026-10-17). `aria-hidden`: the list item's name and status
// line, or the dialog's names, carry the meaning. `data-milestone-badge` (the key) is the e2e hook.
import AllPlanetsArt from "@/components/progress/badge-art/AllPlanetsArt.astro";
import CaldwellAllArt from "@/components/progress/badge-art/CaldwellAllArt.astro";
import FirstGalaxyArt from "@/components/progress/badge-art/FirstGalaxyArt.astro";
import FirstGlobularArt from "@/components/progress/badge-art/FirstGlobularArt.astro";
import FirstMoonArt from "@/components/progress/badge-art/FirstMoonArt.astro";
import FirstNebulaArt from "@/components/progress/badge-art/FirstNebulaArt.astro";
import FirstPlanetArt from "@/components/progress/badge-art/FirstPlanetArt.astro";
import Messier10Art from "@/components/progress/badge-art/Messier10Art.astro";
import Messier110Art from "@/components/progress/badge-art/Messier110Art.astro";
import Messier25Art from "@/components/progress/badge-art/Messier25Art.astro";
import Messier50Art from "@/components/progress/badge-art/Messier50Art.astro";
import type { MilestoneKey } from "@/lib/progress/milestones";

interface Props {
  milestone: MilestoneKey;
  reached: boolean;
  /** How far along an ahead count or all-of-a-set milestone is; draws the arc when `seen` is above 0. */
  progress?: { seen: number; total: number };
  size?: "md" | "lg";
  /** Prefix for the badge's ids, unique on the page (several badges render side by side). */
  idBase?: string;
}

const { milestone, reached, progress, size = "md", idBase = `badge-${milestone}` } = Astro.props;
const share =
  !reached && progress && progress.seen > 0 && progress.total > 0
    ? Math.round((Math.min(progress.seen, progress.total) / progress.total) * 10000) / 100
    : 0;
---

<svg
  data-milestone-badge={milestone}
  viewBox="0 0 120 120"
  aria-hidden="true"
  focusable="false"
  class:list={["night-sky shrink-0", size === "lg" ? "size-32" : "size-28"]}
>
  <defs>
    <radialGradient id={`${idBase}-sky`} cx="50%" cy="38%" r="70%">
      <stop offset="0" stop-color="var(--horizon)"></stop>
      <stop offset="1" stop-color="var(--zenith)"></stop>
    </radialGradient>
    <clipPath id={`${idBase}-clip`}>
      <circle cx="60" cy="60" r="51.5"></circle>
    </clipPath>
  </defs>
  <circle cx="60" cy="60" r="58" fill={reached ? `url(#${idBase}-sky)` : "var(--surface)"}></circle>
  <g clip-path={`url(#${idBase}-clip)`} class:list={[!reached && "opacity-30 dark:opacity-40 red:opacity-60"]}>
    {
      // Each milestone's illustration (`badge-art/`, generated by `scripts/badge-art/port.mjs`). The `never` default makes
      // a milestone without art fail `astro check`. A switch, not the plan's `MILESTONE_ART` record: the type-aware lint
      // types an .astro component used as a value as `error` (`no-unsafe-assignment`), so a record cannot pass lint.
      (() => {
        switch (milestone) {
          case "first-moon":
            return <FirstMoonArt idBase={idBase} />;
          case "first-planet":
            return <FirstPlanetArt idBase={idBase} />;
          case "all-planets":
            return <AllPlanetsArt idBase={idBase} />;
          case "first-galaxy":
            return <FirstGalaxyArt idBase={idBase} />;
          case "first-globular":
            return <FirstGlobularArt idBase={idBase} />;
          case "first-nebula":
            return <FirstNebulaArt idBase={idBase} />;
          case "messier-10":
            return <Messier10Art idBase={idBase} />;
          case "messier-25":
            return <Messier25Art idBase={idBase} />;
          case "messier-50":
            return <Messier50Art idBase={idBase} />;
          case "messier-110":
            return <Messier110Art idBase={idBase} />;
          case "caldwell-all":
            return <CaldwellAllArt idBase={idBase} />;
          default: {
            const missing: never = milestone;
            return missing;
          }
        }
      })()
    }
  </g>
  {reached ? (
    <>
      <circle cx="60" cy="60" r="54" fill="none" stroke="var(--action-border)" stroke-width="4.5" />
      <circle cx="60" cy="60" r="50.6" fill="none" stroke="var(--primary-strong)" stroke-width="0.8" opacity="0.35" />
      <circle cx="99" cy="99" r="12.5" fill="var(--primary)" stroke="var(--zenith)" stroke-width="3" />
      <path
        d="M93.5 99.2l3.8 3.8 7.2-7.6"
        fill="none"
        stroke="var(--primary-foreground)"
        stroke-width="3.4"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </>
  ) : (
    <>
      <circle
        cx="60"
        cy="60"
        r="54"
        fill="none"
        stroke="var(--control-border)"
        stroke-width="2.4"
        stroke-dasharray="5 4.4"
      />
      {share > 0 && (
        <circle
          data-milestone-arc
          cx="60"
          cy="60"
          r="54"
          fill="none"
          stroke="var(--primary-strong)"
          stroke-width="6.5"
          stroke-linecap="round"
          pathLength="100"
          stroke-dasharray={`${share} 100`}
          transform="rotate(-90 60 60)"
        />
      )}
    </>
  )}
</svg>
