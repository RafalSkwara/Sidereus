---
// The progress page's checklist (observing-progress, M-3 S-05; tiles since ui-progress-rewards, owner P4 B / P5 B): one
// tile per catalogue object in catalogue order, two per row on a phone and four from `sm`, each with its family's icon
// (`ObjectTypeSprite`, one `<use>`), the number ("M31" / "C14") and the name (the localised common name, else a Caldwell
// object's designation, else the family's name). Seen is told by shape and weight, never hue alone, so red mode reads
// it: a 2 px `action-border` on the `action-surface` fill, the icon in `primary-strong`, a semibold number and a check
// in the top-right corner (the text column keeps clear of it); not seen is a 1 px `border` with muted icon and text.
// Not interactive. The visible parts are `aria-hidden`; one `sr-only` sentence (`data-tile-sr`) reads "[C20, ]label[,
// common name], type, seen | not seen". `data-checklist-item` / `data-seen` (present only when seen) / `data-family`
// are the e2e hooks. Needs `ObjectTypeSprite` once in the document.
import { getMessages } from "@/i18n";
import { localCommonName } from "@/lib/catalogue/common-names";
import { FAMILY_OF } from "@/lib/progress/object-family";
import type { ChecklistItem } from "@/lib/progress/progress";

interface Props {
  items: readonly ChecklistItem[];
  /** The number's prefix: "M" for the Messier list, "C" for Caldwell's own numbers. */
  prefix: "M" | "C";
  /** The list's accessible name ("Messier"). */
  label: string;
}

const { items, prefix, label } = Astro.props;
const { locale } = Astro.locals;
const t = getMessages(locale).progress;
---

<ul aria-label={label} class="grid grid-cols-2 gap-line sm:grid-cols-4" data-checklist-grid>
  {items.map((item) => {
    const seen = item.seen !== null;
    const family = FAMILY_OF[item.type];
    const common = localCommonName(item.id, item.commonName, locale);
    const name = common ?? (prefix === "C" ? item.label : t.types[family].one);
    return (
      <li
        data-checklist-item={item.id}
        data-seen={seen ? "" : undefined}
        data-family={family}
        class:list={[
          "relative flex min-h-16 min-w-0 items-center gap-2 rounded-lg px-2",
          seen ? "border-2 border-action-border bg-action-surface" : "border border-border",
        ]}
      >
        <svg
          aria-hidden="true"
          focusable="false"
          class:list={["size-7 shrink-0", seen ? "text-primary-strong" : "text-muted-foreground"]}
        >
          <use href={`#progress-type-${family}`} />
        </svg>
        <span aria-hidden="true" class:list={["flex min-w-0 flex-col", seen && "pr-3"]}>
          <span class:list={["text-label", seen ? "font-semibold text-heading" : "text-muted-foreground"]}>
            {prefix}
            {item.number}
          </span>
          <span
            class:list={["line-clamp-2 text-caption break-words", seen ? "text-foreground" : "text-muted-foreground"]}
          >
            {name}
          </span>
        </span>
        {seen && (
          <svg aria-hidden="true" focusable="false" class="absolute top-1 right-1 size-3.5 text-primary-strong">
            <use href="#progress-check" />
          </svg>
        )}
        <span class="sr-only" data-tile-sr>
          {[
            prefix === "C" ? `${prefix}${item.number}` : null,
            item.label,
            common,
            t.types[family].one,
            seen ? t.seen : t.notSeen,
          ]
            .filter(Boolean)
            .join(", ")}
        </span>
      </li>
    );
  })}
</ul>
