---
// The "all-planets" badge's illustration (ui-progress-rewards), in the 120-unit badge space; MilestoneBadge clips it and
// draws the disc, ring, arc and pip. Generated from the owner-approved art (round 1b) by scripts/badge-art/port.mjs
// (`npm run badge-art:port`): change the art in scripts/badge-art/render.mjs and re-run, never by hand.
// Tokens only (var(--…)); value steps by opacity; red mode reads by shape and value.
export interface Props {
  /** Prefix for this badge's gradient and clip ids, unique on the page. */
  idBase: string;
}

const { idBase } = Astro.props;
---

<g fill="var(--star-accent)">
  <circle cx="40.4" cy="23.1" r="0.87" />
  <circle cx="41.1" cy="50.7" r="0.85" />
  <circle cx="91.6" cy="51.3" r="0.79" />
</g>
<g fill="var(--star)">
  <circle cx="45" cy="68.6" r="0.4" />
  <circle cx="72.7" cy="29.3" r="0.57" />
  <circle cx="51.5" cy="23" r="0.94" />
  <circle cx="90.3" cy="31.4" r="0.89" />
  <circle cx="64.2" cy="67.9" r="0.84" />
  <circle cx="54.2" cy="93.2" r="0.8" />
  <circle cx="77.4" cy="22.1" r="0.97" />
  <circle cx="46.1" cy="72.5" r="0.4" />
  <circle cx="80.3" cy="61" r="0.38" />
  <circle cx="96.9" cy="28.3" r="0.81" />
  <circle cx="41.3" cy="55.4" r="0.45" />
</g>
<defs>
  <clipPath id={`${idBase}-p0`}>
    <circle cx="22" cy="79" r="2.64" />
  </clipPath>
  <clipPath id={`${idBase}-p1`}>
    <circle cx="29.32" cy="75.78" r="3.96" />
  </clipPath>
  <clipPath id={`${idBase}-p2`}>
    <circle cx="37.19" cy="72.2" r="3.3" />
  </clipPath>
  <clipPath id={`${idBase}-p3`}>
    <circle cx="51.2" cy="65.14" r="11" />
  </clipPath>
  <clipPath id={`${idBase}-p4`}>
    <circle cx="71.86" cy="52.08" r="7.7" />
  </clipPath>
  <clipPath id={`${idBase}-p5`}>
    <circle cx="86.52" cy="40.64" r="5.06" />
  </clipPath>
  <clipPath id={`${idBase}-p6`}>
    <circle cx="95.2" cy="33.36" r="4.84" />
  </clipPath>
  <radialGradient id={`${idBase}-sun`} cx="50%" cy="50%" r="50%">
    <stop offset="0" stop-color="var(--moon-lit)" />
    <stop offset="0.45" stop-color="var(--moon-lit)" stop-opacity="0.9" />
    <stop offset="0.6" stop-color="var(--primary-strong)" stop-opacity="0.35" />
    <stop offset="1" stop-color="var(--primary-strong)" stop-opacity="0" />
  </radialGradient>
</defs>
<circle cx="2" cy="116" r="40" fill={`url(#${idBase}-sun)`} />
<path
  d="M10 98Q62 70 110 26"
  fill="none"
  stroke="var(--primary-strong)"
  stroke-width="0.8"
  stroke-dasharray="1.5 2.5"
  opacity="0.6"
/>
<g clip-path={`url(#${idBase}-p0)`}>
  <circle cx="22" cy="79" r="2.64" fill="var(--moon-mare)" opacity="1" />
  <circle cx="23" cy="77.14" r="2.64" fill="var(--moon-dark)" opacity="0.62" />
</g>
<circle cx="22" cy="79" r="2.64" fill="none" stroke="var(--moon-limb)" stroke-width="0.5" />
<g clip-path={`url(#${idBase}-p1)`}>
  <circle cx="29.32" cy="75.78" r="3.96" fill="var(--moon-lit)" opacity="0.95" />
  <circle cx="31.1" cy="73.16" r="3.96" fill="var(--moon-dark)" opacity="0.62" />
</g>
<circle cx="29.32" cy="75.78" r="3.96" fill="none" stroke="var(--moon-limb)" stroke-width="0.5" />
<g clip-path={`url(#${idBase}-p2)`}>
  <circle cx="37.19" cy="72.2" r="3.3" fill="var(--primary-strong)" opacity="0.95" />
  <circle cx="38.84" cy="70.14" r="3.3" fill="var(--moon-dark)" opacity="0.62" />
</g>
<circle cx="37.19" cy="72.2" r="3.3" fill="none" stroke="var(--moon-limb)" stroke-width="0.5" />
<g clip-path={`url(#${idBase}-p3)`}>
  <circle cx="51.2" cy="65.14" r="11" fill="var(--moon-lit)" opacity="1" />
  <rect x="40.2" y="58.94" width="22" height="1.3" fill="var(--moon-mare)" opacity="0.9" />
  <rect x="40.2" y="62.34" width="22" height="2" fill="var(--moon-mare)" opacity="0.9" />
  <rect x="40.2" y="66.14" width="22" height="1.3" fill="var(--primary-strong)" opacity="0.9" />
  <rect x="40.2" y="69.74" width="22" height="2" fill="var(--moon-mare)" opacity="0.9" />
  <rect x="40.2" y="72.54" width="22" height="1.3" fill="var(--moon-mare)" opacity="0.9" />
  <ellipse cx="54.2" cy="68.54" rx="2" ry="1.2" fill="var(--moon-dark)" opacity="0.55" />
  <circle cx="57.32" cy="58.82" r="11" fill="var(--moon-dark)" opacity="0.62" />
</g>
<circle cx="51.2" cy="65.14" r="11" fill="none" stroke="var(--moon-limb)" stroke-width="0.5" />
<path
  d="M56.46 52.08A15.4 4.235 0 0 1 87.26 52.08"
  transform="rotate(-25 71.86 52.08)"
  fill="none"
  stroke="var(--moon-lit)"
  stroke-width="1.6"
  opacity="0.8"
/>
<g clip-path={`url(#${idBase}-p4)`}>
  <circle cx="71.86" cy="52.08" r="7.7" fill="var(--moon-lit)" opacity="0.92" />
  <circle cx="76.4" cy="47.92" r="7.7" fill="var(--moon-dark)" opacity="0.62" />
</g>
<circle cx="71.86" cy="52.08" r="7.7" fill="none" stroke="var(--moon-limb)" stroke-width="0.5" />
<path
  d="M56.46 52.08A15.4 4.235 0 0 0 87.26 52.08"
  transform="rotate(-25 71.86 52.08)"
  fill="none"
  stroke="var(--moon-lit)"
  stroke-width="1.6"
/>
<g clip-path={`url(#${idBase}-p5)`}>
  <circle cx="86.52" cy="40.64" r="5.06" fill="var(--primary-strong)" opacity="0.8" />
  <circle cx="89.54" cy="37.95" r="5.06" fill="var(--moon-dark)" opacity="0.62" />
</g>
<circle cx="86.52" cy="40.64" r="5.06" fill="none" stroke="var(--moon-limb)" stroke-width="0.5" />
<g clip-path={`url(#${idBase}-p6)`}>
  <circle cx="95.2" cy="33.36" r="4.84" fill="var(--primary-strong)" opacity="0.6" />
  <circle cx="98.1" cy="30.79" r="4.84" fill="var(--moon-dark)" opacity="0.62" />
</g>
<circle cx="95.2" cy="33.36" r="4.84" fill="none" stroke="var(--moon-limb)" stroke-width="0.5" />
