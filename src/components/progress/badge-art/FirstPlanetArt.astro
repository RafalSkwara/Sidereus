---
// The "first-planet" badge's illustration (ui-progress-rewards), in the 120-unit badge space; MilestoneBadge clips it and
// draws the disc, ring, arc and pip. Generated from the owner-approved art (round 1b) by scripts/badge-art/port.mjs
// (`npm run badge-art:port`): change the art in scripts/badge-art/render.mjs and re-run, never by hand.
// Tokens only (var(--…)); value steps by opacity; red mode reads by shape and value.
export interface Props {
  /** Prefix for this badge's gradient and clip ids, unique on the page. */
  idBase: string;
}

const { idBase } = Astro.props;
---

<g fill="var(--star)">
  <circle cx="39.6" cy="69.2" r="0.55" />
  <circle cx="15.9" cy="66.5" r="0.96" />
  <circle cx="23.7" cy="73.6" r="0.48" />
  <circle cx="47.1" cy="48.9" r="0.42" />
  <circle cx="48.5" cy="60.8" r="0.73" />
  <circle cx="87.3" cy="79.3" r="0.91" />
  <circle cx="42.5" cy="36.3" r="0.48" />
  <circle cx="48.5" cy="70.5" r="0.79" />
  <circle cx="24.5" cy="89.9" r="0.76" />
  <circle cx="43" cy="99.7" r="1" />
</g>
<g fill="var(--star-accent)">
  <circle cx="67.5" cy="86.7" r="0.93" />
  <circle cx="55.9" cy="55.1" r="0.68" />
</g>
<defs>
  <clipPath id={`${idBase}-planet`}>
    <circle cx="60" cy="60" r="21" />
  </clipPath>
</defs>
<circle cx="101" cy="34" r="1.6" fill="var(--moon-lit)" />
<circle cx="22" cy="84" r="1.1" fill="var(--moon-mare)" />
<g transform="rotate(-22 60 60)">
  <path d="M15 60A45 12.5 0 0 1 105 60" fill="none" stroke="var(--moon-lit)" stroke-width="2.6" opacity="0.75" />
  <path d="M20.5 60A39.5 11 0 0 1 99.5 60" fill="none" stroke="var(--moon-lit)" stroke-width="5.5" opacity="0.95" />
  <path d="M26.5 60A33.5 9.3 0 0 1 93.5 60" fill="none" stroke="var(--moon-mare)" stroke-width="2.4" opacity="0.7" />
  <path d="M30.5 60A29.5 8.2 0 0 1 89.5 60" fill="none" stroke="var(--moon-mare)" stroke-width="1.2" opacity="0.4" />
  <g clip-path={`url(#${idBase}-planet)`}>
    <rect x="35" y="36" width="50" height="50" fill="var(--moon-mare)" />
    <rect x="35" y="36" width="50" height="6" fill="var(--moon-lit)" opacity="0.95" />
    <rect x="35" y="42" width="50" height="3" fill="var(--moon-mare)" opacity="0.9" />
    <rect x="35" y="45" width="50" height="4" fill="var(--moon-lit)" opacity="0.85" />
    <rect x="35" y="49" width="50" height="2.5" fill="var(--primary-strong)" opacity="0.7" />
    <rect x="35" y="51.5" width="50" height="5" fill="var(--moon-lit)" opacity="0.9" />
    <rect x="35" y="56.5" width="50" height="2" fill="var(--moon-mare)" opacity="0.8" />
    <rect x="35" y="58.5" width="50" height="6" fill="var(--moon-lit)" opacity="0.95" />
    <rect x="35" y="64.5" width="50" height="3" fill="var(--moon-mare)" opacity="0.85" />
    <rect x="35" y="67.5" width="50" height="4" fill="var(--moon-lit)" opacity="0.8" />
    <rect x="35" y="71.5" width="50" height="3" fill="var(--primary-strong)" opacity="0.6" />
    <rect x="35" y="74.5" width="50" height="10" fill="var(--moon-mare)" opacity="0.85" />
    <ellipse cx="60" cy="55" rx="3.2" ry="1.8" fill="var(--moon-dark)" opacity="0.35" />
    <path d="M39 64A39.5 11 0 0 0 81 64" fill="none" stroke="var(--moon-dark)" stroke-width="3" opacity="0.55" />
    <circle cx="68" cy="66" r="21" fill="var(--moon-dark)" opacity="0.5" />
  </g>
  <circle cx="60" cy="60" r="21" fill="none" stroke="var(--moon-limb)" stroke-width="0.8" />
  <path d="M15 60A45 12.5 0 0 0 105 60" fill="none" stroke="var(--moon-lit)" stroke-width="2.6" opacity="0.75" />
  <path d="M20.5 60A39.5 11 0 0 0 99.5 60" fill="none" stroke="var(--moon-lit)" stroke-width="5.5" opacity="0.95" />
  <path d="M26.5 60A33.5 9.3 0 0 0 93.5 60" fill="none" stroke="var(--moon-mare)" stroke-width="2.4" opacity="0.7" />
  <path d="M30.5 60A29.5 8.2 0 0 0 89.5 60" fill="none" stroke="var(--moon-mare)" stroke-width="1.2" opacity="0.4" />
</g>
