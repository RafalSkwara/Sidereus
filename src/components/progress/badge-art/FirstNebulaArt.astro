</g>
<defs>
  <radialGradient id={`${idBase}-glow`} cx="55%" cy="50%" r="55%">
    <stop offset="0" stop-color="var(--primary-strong)" stop-opacity="0.45" />
    <stop offset="1" stop-color="var(--primary-strong)" stop-opacity="0" />
  </radialGradient>
  <radialGradient id={`${idBase}-dusk`} cx="50%" cy="50%" r="50%">
    <stop offset="0" stop-color="var(--dusk-glow)" stop-opacity="1" />
    <stop offset="1" stop-color="var(--dusk-glow)" stop-opacity="0" />
  </radialGradient>
  <radialGradient id={`${idBase}-warm`} cx="50%" cy="50%" r="50%">
    <stop offset="0" stop-color="var(--dusk-glow-horizon)" stop-opacity="0.9" />
    <stop offset="1" stop-color="var(--dusk-glow-horizon)" stop-opacity="0" />
  </radialGradient>
</defs>
<ellipse cx="60" cy="58" rx="50" ry="40" transform="rotate(-28 60 58)" fill={`url(#${idBase}-dusk)`} />
