---
/*
 * The finder chart for an account without the full plan (finder-chart O-5): what the chart does in three lines, the
 * plan it needs (an informational notice, never error styling, and no way to get the plan: no payments in M-3), and a
 * fixed, precomputed example drawn by `FinderChart` and labelled as one. Nothing of the user's is in it: no site, no
 * gear, no star file read. The root marks the state (`data-finder-state="locked"`) and, when a host passes `plan`,
 * carries it as `data-plan` (the offline copies' plan metadata, Phase 5); the example brings the data credits, so the
 * chart itself draws none.
 */
import { getMessages } from "@/i18n";
import type { FinderChartData } from "@/lib/engine";
import type { FinderChartLabels } from "@/lib/finder/steps";
import type { Locale } from "@/lib/preferences";
import Attribution from "@/components/tonight/Attribution.astro";
import Notice from "@/components/ui/Notice.astro";
import FinderChart from "./FinderChart.astro";

interface Props {
  /** The committed example chart (`example-chart.ts`) and its labels. */
  example: FinderChartData;
  exampleLabels: FinderChartLabels;
  locale: Locale;
  /** `full` | `free` | `unknown`; rendered as `data-plan` when given (default: omitted). */
  plan?: string;
}

const { example, exampleLabels, locale, plan } = Astro.props;
const t = getMessages(locale).tonight.finder.locked;
---

<section class="space-y-6" data-finder-state="locked" data-plan={plan} aria-labelledby="finder-locked-heading">
  <div>
    <h2 id="finder-locked-heading" class="font-display text-title font-semibold text-heading">
      {t.heading}
    </h2>
    <ul class="mt-3 list-disc space-y-2 pl-6 text-body">
      <li>{t.lineStar}</li>
      <li>{t.lineHop}</li>
      <li>{t.lineScale}</li>
    </ul>
  </div>

  <Notice tone="info">{t.needsFull}</Notice>

  <div class="space-y-3" data-finder-example>
    <p class="text-label text-muted-foreground">
      <span class="mr-2 inline-block rounded-md border border-border bg-surface px-2 py-0.5 font-semibold text-heading">
        {t.exampleLabel}
      </span>
      {t.exampleCaption({ target: exampleLabels.target, eyepiece: exampleLabels.eyepiece?.name ?? "" })}
    </p>
    <FinderChart chart={example} labels={exampleLabels} locale={locale} attribution={false} />
  </div>

  <Attribution />
</section>
