---
import MilestoneCelebration from "@/components/progress/MilestoneCelebration.astro";
import Layout from "@/layouts/Layout.astro";
import TabBar from "@/components/TabBar.astro";
import Topbar from "@/components/Topbar.astro";
import { getMessages } from "@/i18n";
import { readMilestoneParam } from "@/lib/observations/redirect";

interface Props {
  title: string;
  /**
   * Sky-flow mode (tonight-nightfall): for a page whose sky depends on island data. The Topbar sits on a zenith strip
   * with no rule and `<main>` is full width with no top padding, so the sky band the page draws first (TonightSky)
   * continues the strip as one sky. The page then puts its own content in the `max-w-3xl px-4` container. The strip
   * sits in the `night-sky` scope (ui-sky-light), so in the light theme it stays the navy night the band continues.
   * A page that fills the `subnav` slot (the six focused Tonight pages, ui-tonight-nav) gets it under the Topbar in
   * that strip, in the page title's column, rendered once outside the island; with the slot empty the strip is as
   * before.
   */
  skyFlow?: boolean;
  /** The Tonight dashboard (ui-sky-modes): renders the live sky's `data-sky-mode` scope on `<html>` (Layout). */
  skyModeScope?: boolean;
}

const { title, skyFlow = false, skyModeScope = false } = Astro.props;
const m = getMessages(Astro.locals.locale);
// The milestone celebration (observing-milestones Phase 6): a modal dialog, so it is position-independent and lives in
// the shell. Signed in only, with the `milestone` keys validated against the fixed set, so a crafted link shows a
// visitor nothing. Its script opens it once and takes the param out of the URL (a reload never replays it).
const celebrationKeys = readMilestoneParam(Astro.url, Boolean(Astro.locals.user));
// A page that fills the `header` slot gets the sky header: a full-bleed zenith-to-horizon band behind the Topbar
// and that slot, ending in the horizon rule. Every other page renders as before.
const skyHeader = Astro.slots.has("header");
// The Tonight sub-nav (ui-tonight-nav): sky-flow pages only; nothing is added to the strip without it.
const subnav = Astro.slots.has("subnav");
---

<Layout title={m.common.pageTitle({ title })} skyModeScope={skyModeScope}>
  <div class="flex min-h-screen w-full flex-col bg-background text-foreground">
    {skyFlow ? (
      <div class="night-sky bg-zenith">
        {/* The strip's height (`pt-2 sm:pt-6` + the Topbar's `h-16`) is `--topbar-strip-height` in global.css. */}
        <div class="mx-auto w-full max-w-5xl px-4 pt-2 sm:px-8 sm:pt-6">
          <Topbar />
        </div>
        {subnav && (
          <div class="mx-auto w-full max-w-3xl">
            <slot name="subnav" />
          </div>
        )}
      </div>
    ) : skyHeader ? (
      <div class="border-b border-border bg-linear-to-b from-zenith to-horizon">
        <div class="mx-auto w-full max-w-5xl px-4 pt-2 sm:px-8 sm:pt-6">
          <Topbar />
        </div>
        <div class="mx-auto w-full max-w-3xl px-4 pt-4 pb-6 sm:pt-10 sm:pb-12">
          <slot name="header" />
        </div>
      </div>
    ) : (
      <div class="mx-auto w-full max-w-5xl px-4 pt-2 sm:px-8 sm:pt-6">
        <Topbar />
      </div>
    )}
    <main class:list={[skyFlow ? "w-full flex-1 pb-8 sm:pb-12" : "mx-auto w-full max-w-3xl flex-1 px-4 py-6 sm:py-12"]}>
      <slot />
    </main>
    <TabBar />
    {celebrationKeys.length > 0 && <MilestoneCelebration keys={celebrationKeys} locale={Astro.locals.locale} />}
  </div>
</Layout>
