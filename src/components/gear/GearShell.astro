---
import Layout from "@/layouts/Layout.astro";
import TabBar from "@/components/TabBar.astro";
import Topbar from "@/components/Topbar.astro";
import { getMessages } from "@/i18n";

interface Props {
  title: string;
}

const { title } = Astro.props;
const m = getMessages(Astro.locals.locale);
// A page that fills the `header` slot gets the sky header: a full-bleed zenith-to-horizon band behind the Topbar
// and that slot, ending in the horizon rule. Every other page renders as before.
const skyHeader = Astro.slots.has("header");
---

<Layout title={m.common.pageTitle({ title })}>
  <div class="flex min-h-screen w-full flex-col bg-background text-foreground">
    {skyHeader ? (
      <div class="border-b border-border bg-linear-to-b from-zenith to-horizon">
        <div class="mx-auto w-full max-w-5xl px-4 pt-4 sm:px-8 sm:pt-6">
          <Topbar />
        </div>
        <div class="mx-auto w-full max-w-3xl px-4 pt-6 pb-8 sm:pt-10 sm:pb-12">
          <slot name="header" />
        </div>
      </div>
    ) : (
      <div class="mx-auto w-full max-w-5xl px-4 pt-4 sm:px-8 sm:pt-6">
        <Topbar />
      </div>
    )}
    <main class="mx-auto w-full max-w-3xl flex-1 px-4 py-8 sm:py-12">
      <slot />
    </main>
    <TabBar />
  </div>
</Layout>
