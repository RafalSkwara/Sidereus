---
/** Shown instead of gear content when `locals.supabase` is null (Supabase env vars unset). */
import Notice from "@/components/ui/Notice.astro";
import { getMessages } from "@/i18n";

const t = getMessages(Astro.locals.locale).databaseMissing;
---

<Notice tone="warning" dismissible>
  <p class="font-semibold text-heading">{t.title}</p>
  <p class="mt-1 text-muted-foreground">
    {t.bodyPrefix}
    <code class="font-mono break-all text-heading">SUPABASE_URL</code>
    {t.and} <code class="font-mono break-all text-heading">SUPABASE_KEY</code>
    {t.bodySuffix}
  </p>
</Notice>
