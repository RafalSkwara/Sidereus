---
import NavIcon from "@/components/NavIcon.astro";
import { getMessages } from "@/i18n";
import { NAV_ITEMS, isCurrentPage } from "@/lib/navigation";

// Phone and small-tablet navigation (top-nav-redesign, board direction A): below `md` the three destinations sit in
// a bottom tab bar, in thumb reach at the telescope; from `md` the top bar's segmented pill takes over. Signed in
// only, and not during onboarding, where there is one way forward. The in-flow spacer keeps page content clear of
// the fixed bar.
const { user, locale } = Astro.locals;
const m = getMessages(locale);
const { pathname } = Astro.url;
const show = user !== null && !isCurrentPage(pathname, "/onboarding");
const tabs = NAV_ITEMS.map((item) => ({
  ...item,
  text: m.nav[item.label],
  current: isCurrentPage(pathname, item.href),
}));
---

{show && (
  <>
    <div class="h-[calc(4rem+env(safe-area-inset-bottom))] md:hidden" aria-hidden="true"></div>
    <nav
      aria-label={m.nav.primary}
      class="fixed inset-x-0 bottom-0 z-40 border-t border-border bg-surface pb-[env(safe-area-inset-bottom)] md:hidden"
    >
      <ul class="mx-auto grid h-16 max-w-md grid-cols-3">
        {tabs.map((tab) => (
          <li>
            <a
              href={tab.href}
              aria-current={tab.current ? "page" : undefined}
              class:list={[
                "relative flex h-full flex-col items-center justify-center gap-1 text-xs",
                "transition-[color,scale] duration-150 ease-out active:scale-[0.96] motion-reduce:transition-none",
                "outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50",
                tab.current ? "font-semibold text-heading" : "text-muted-foreground hover:text-heading",
              ]}
            >
              {/* The current tab's top bar glides to the next page's tab; its icon bounces in (global.css). */}
              {tab.current && (
                <span
                  class="absolute top-0 left-1/2 h-0.5 w-8 -translate-x-1/2 rounded-full bg-primary [view-transition-name:tab-current]"
                  aria-hidden="true"
                ></span>
              )}
              <span
                class="inline-flex"
                style={
                  tab.current
                    ? `view-transition-name: tab-icon-${tab.icon}; view-transition-class: tab-icon`
                    : undefined
                }
              >
                <NavIcon name={tab.icon} class:list={["size-5", tab.current && "text-primary"]} />
              </span>
              {tab.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </>
)}
