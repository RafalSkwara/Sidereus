---
import Layout from "@/layouts/Layout.astro";
import TabBar from "@/components/TabBar.astro";
import Topbar from "@/components/Topbar.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { getMessages } from "@/i18n";

/*
 * The auth pages' shell (Nightfall, ui-auth): the sky header GearShell draws (Topbar and the page's PageHeader on the
 * zenith-to-horizon band, ending in the horizon rule), then the page's content unboxed on the ground. The header and
 * the content share one narrow column, so the title lines up with the form. The optional `icon` slot sits above the
 * title (confirm-email's status icon).
 */
interface Props {
  /** The page heading; also the document title. */
  title: string;
  /** One sentence under the heading. */
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
const m = getMessages(Astro.locals.locale);
const column = "mx-auto w-full max-w-md px-4";
---

<Layout title={m.common.pageTitle({ title })}>
  <div class="flex min-h-screen w-full flex-col bg-background text-foreground">
    <div class="border-b border-border bg-linear-to-b from-zenith to-horizon">
      <div class="mx-auto w-full max-w-5xl px-4 pt-4 sm:px-8 sm:pt-6">
        <Topbar />
      </div>
      <div class:list={[column, "pt-6 pb-8 sm:pt-10 sm:pb-12"]}>
        <slot name="icon" />
        <PageHeader title={title} subtitle={subtitle} />
      </div>
    </div>
    <main class:list={[column, "flex-1 py-8 sm:py-12"]}>
      <slot />
    </main>
    <TabBar />
  </div>
</Layout>
