---
/*
 * Window and Best (ui-fact-rhythm): a `<dl>` of two `StatCard`s in one column at every width, Best under Window, each
 * card as wide as its column, with the line role between them (owner change of 2026-10-15, replacing side by side and
 * the `sm` cap). `class` is merged last: the caller's spacing (`mt-group` in a row).
 */
import { cn } from "@/lib/utils";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<dl class:list={cn("grid gap-line", className)}>
  <slot />
</dl>
