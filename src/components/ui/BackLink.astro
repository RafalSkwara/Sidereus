---
import { ChevronLeft } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

/*
 * The way back to a parent page, an `action` button-link (border, tinted surface and the chevron) with a 44 px target. `href` is a fixed app path chosen by the page (ids at most,
 * encoded by the caller), never user text. `class` is merged last; `/design` uses it to pin the hover and focus
 * looks as specimens.
 */
interface Props {
  href: string;
  label: string;
  class?: string;
}

const { href, label, class: className } = Astro.props;
---

<a href={href} class:list={cn(buttonVariants({ variant: "action", size: "sm" }), className)}>
  <ChevronLeft aria-hidden="true" />
  {label}
</a>
