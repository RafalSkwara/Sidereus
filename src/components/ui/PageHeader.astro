---
/*
 * The page header (Nightfall): the title in the `text-display` role, an optional sentence-case subtitle and an
 * optional `actions` slot (link-buttons through `buttonVariants`). No uppercase kicker. On `/gear` it sits in
 * GearShell's `header` slot, on the sky band.
 */
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
const hasActions = Astro.slots.has("actions");
---

<div class="flex flex-wrap items-end justify-between gap-3 sm:gap-4">
  <div class="min-w-0">
    <h1 class="font-display text-display font-semibold break-words text-heading">{title}</h1>
    {subtitle && <p class="mt-2 text-body text-muted-foreground">{subtitle}</p>}
  </div>
  {hasActions && (
    <div class="flex flex-wrap gap-3">
      <slot name="actions" />
    </div>
  )}
</div>
