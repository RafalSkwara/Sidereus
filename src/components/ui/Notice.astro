---
import { CircleCheck, Info, TriangleAlert } from "lucide-react";
import { cn } from "@/lib/utils";

/*
 * A status notice. `success` reuses the go verdict surface, `warning` the marginal one, `info` the plain surface.
 * The text comes from the slot (catalogue copy); the notice never builds a URL.
 * A live region announces changes, not the text it loads with, so after load the script below takes the text out
 * and puts it back, which makes screen readers read it once. Notices that arrive later (a server island's) get the
 * same once-over when they are added, and a notice inside a hidden element gets it when it is shown (the `hidden`
 * attribute is watched); a data attribute marks each one done. Without JavaScript the text is simply there.
 */
interface Props {
  tone: "success" | "info" | "warning";
}

const { tone } = Astro.props;

const TONES = {
  success: { box: "border-go-border bg-go-surface", icon: "text-go", Icon: CircleCheck },
  warning: { box: "border-marginal-border bg-marginal-surface", icon: "text-marginal", Icon: TriangleAlert },
  info: { box: "border-border bg-surface", icon: "text-primary-strong", Icon: Info },
} as const;
const { box, icon, Icon } = TONES[tone];
---

<div role="status" class:list={["flex items-start gap-2 rounded-lg border px-3 py-2 text-body text-foreground", box]}>
  <Icon className={cn("mt-1 size-4 shrink-0", icon)} aria-hidden="true" />
  <div class="min-w-0" data-notice-text>
    <slot />
  </div>
</div>

<script>
  const SELECTOR = "[data-notice-text]:not([data-notice-announced])";

  const announce = (text: HTMLElement) => {
    text.dataset.noticeAnnounced = "";
    const nodes = [...text.childNodes];
    text.replaceChildren();
    setTimeout(() => text.replaceChildren(...nodes), 150);
  };

  // A notice inside a hidden element (a stored page's offline notice, offline-night-plan) is announced when it shows.
  const announceShown = (root: Document | HTMLElement) => {
    if (root instanceof HTMLElement && root.matches(SELECTOR) && !root.closest("[hidden]")) announce(root);
    for (const text of root.querySelectorAll<HTMLElement>(SELECTOR)) {
      if (!text.closest("[hidden]")) announce(text);
    }
  };

  announceShown(document);

  new MutationObserver((records) => {
    for (const record of records) {
      if (record.type === "attributes") {
        if (record.target instanceof HTMLElement && !record.target.hidden) announceShown(record.target);
        continue;
      }
      for (const node of record.addedNodes) {
        if (node instanceof HTMLElement) announceShown(node);
      }
    }
  }).observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ["hidden"] });
</script>
