---
/*
 * The landing page's shell (ui-landing), signed-out visitors only (`src/pages/index.astro` redirects a signed-in user
 * to Tonight). Nightfall composition, as GearShell's sky-flow mode: the Topbar on a zenith strip that Tonight's sky
 * band (`TonightSky`) continues, holding the question as the page title, the two calls to action and the verdict
 * legend; then the ruled bands in the shared `max-w-3xl px-4` column.
 */
import Band from "@/components/ui/Band.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { buttonVariants } from "@/components/ui/button";
import TonightSky from "@/components/tonight/TonightSky.astro";
import Topbar from "@/components/Topbar.astro";
import { VERDICT_TONES } from "@/components/tonight/verdict-tones";
import { getMessages } from "@/i18n";
import type { Verdict } from "@/lib/engine";
import { createFormatter } from "@/lib/tonight/format";

const { locale } = Astro.locals;
const m = getMessages(locale);
const t = m.landing;
const { skyHeadline } = createFormatter(locale);

// The legend: one cloud verdict per level, worded by the same headline function as Tonight.
const examples: Verdict[] = [
  { level: "go", reason: { kind: "clear-run", runHours: 3, cloudPct: 0 } },
  { level: "marginal", reason: { kind: "clear-run", runHours: 1, cloudPct: 30 } },
  { level: "no-go", reason: { kind: "cloudy", bestRunHours: 0, minCloudPct: 100 } },
];
const verdicts = examples.map((verdict) => ({ headline: skyHeadline(verdict), dot: VERDICT_TONES[verdict.level].dot }));

const steps = [t.steps.where, t.steps.kit, t.steps.tonight];

/** Intrinsic size of `public/landing/tonight.png` (captured by `tests/e2e/landing-screenshot.spec.ts`). */
const SCREENSHOT = { width: 1280, height: 1160 };
---

<div class="flex min-h-screen w-full flex-col bg-background text-foreground">
  <div class="bg-zenith">
    <div class="mx-auto w-full max-w-5xl px-4 pt-4 sm:px-8 sm:pt-6">
      <Topbar />
    </div>
  </div>

  <main class="w-full flex-1">
    <TonightSky>
      <p class="mb-3 text-label break-words text-muted-foreground">{t.kicker}</p>
      <PageHeader title={t.tagline} subtitle={t.lead}>
        <Fragment slot="actions">
          <a href="/auth/signup" class:list={buttonVariants({ size: "lg" })}>
            {t.getStarted}
          </a>
          <a href="/auth/signin" class:list={buttonVariants({ variant: "outline", size: "lg" })}>
            {t.signIn}
          </a>
        </Fragment>
      </PageHeader>
      <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2" aria-label={t.verdictsLabel}>
        {verdicts.map((v) => (
          <li
            class="inline-flex items-center gap-2 text-label text-muted-foreground"
            data-sky-headline={v.headline.key}
          >
            <span class:list={["size-2.5 shrink-0 rounded-full", v.dot]} aria-hidden="true" />
            {v.headline.text}
          </li>
        ))}
      </ul>
    </TonightSky>

    <div class="mx-auto w-full max-w-3xl px-4 py-8 sm:py-12">
      <Band headingId="how-it-works" heading={t.howItWorks}>
        <ol class="divide-y divide-border">
          {steps.map((step, i) => (
            <li class="flex items-baseline gap-4 py-3">
              <span class="w-5 shrink-0 font-mono text-label font-semibold text-muted-foreground" aria-hidden="true">
                {i + 1}
              </span>
              <span class="text-body break-words text-foreground">{step}</span>
            </li>
          ))}
        </ol>
      </Band>

      <Band headingId="preview-heading" heading={t.previewHeading}>
        <figure class="overflow-hidden rounded-lg border border-border bg-surface">
          <img
            src="/landing/tonight.png"
            alt={t.screenshotAlt}
            width={SCREENSHOT.width}
            height={SCREENSHOT.height}
            loading="lazy"
            decoding="async"
            class="block h-auto w-full"
          />
        </figure>
      </Band>
    </div>
  </main>

  <footer class="mx-auto w-full max-w-3xl px-4 pb-8">
    <p class="border-t border-border pt-6 text-label text-muted-foreground">
      {t.footerPrefix} <em>{t.footerWork}</em>
      {t.footerSuffix}
    </p>
  </footer>
</div>
