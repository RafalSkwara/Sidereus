---
// Stand-in for TonightContent while its server island loads: the same sky (TonightSky, with the live sky's panorama
// strip and slider row reserved, interactive-sky) with bars where the date, the display-size headline and its reason
// go, the two gear cards, then six ruled rows standing for the dashboard's tiles (TonightTiles), so
// nothing jumps when the real content swaps in. Bars that stand for text take that text's type role and hold a
// non-breaking space, so they have its line height. The tile rows mirror TonightTiles offset by offset on the rhythm
// roles (ui-dashboard-tiles): the row from `TILE_ROW_CLASS`, the first bar under each heading at `TILE_CONTENT_CLASS`,
// a group's lines on `line` and an explanatory caption at `mt-group`. The Events line's kind icon sits inside its
// `text-body` line, so its bar needs no extra room. The verdict's bars follow VerdictCard's answer group (D6): the
// headline and the forecast line at `line`, the reason at the display line's own `mt-1`.
import {
  SKY_FRAME_CLASS,
  SLIDER_LAYOUT_CLASS,
  SLIDER_LEGEND_CLASS,
  SLIDER_NOW_CLASS,
  SLIDER_ROW_CLASS,
  SLIDER_TIME_CLASS,
  SLIDER_TRACK_CLASS,
  GEAR_CARD_MIN_HEIGHT_CLASS,
  GEAR_ROW_GAP_CLASS,
  GEAR_ROW_GRID_CLASS,
  TILES_GAP_CLASS,
} from "@/components/tonight/sky-band";
import TonightSky from "@/components/tonight/TonightSky.astro";
import { getMessages } from "@/i18n";
import { buttonVariants } from "@/components/ui/button";
import { TILE_CONTENT_CLASS, TILE_ROW_CLASS } from "@/components/ui/tile";
import { OUTLOOK_NIGHTS } from "@/lib/engine/parameters";

const t = getMessages(Astro.locals.locale).tonight;
// bg-border, not bg-muted: --muted is the surface colour, so muted bars vanish on the ground.
const bar = "rounded bg-border motion-safe:animate-pulse";
// A tile row as TonightTiles draws it, from the same class source as `Tile`.
const tile = TILE_ROW_CLASS;
---

<!-- Only the loading line is the status: the back and reload links stay outside it, so a screen reader still
     reaches them if the island never arrives (tonight-dashboard review F8). -->
<div>
  <h1 class="sr-only">{t.title}</h1>
  <span role="status" class="sr-only">
    {t.loading}
  </span>
  <!-- The band and the slider row in the sky-mode frame (ui-sky-modes): the reserved height follows the chosen mode. -->
  <div class:list={[SKY_FRAME_CLASS]} data-sky-mode-frame="skeleton">
    <TonightSky night verdict strip>
      <div aria-hidden="true">
        <div class:list={[bar, "w-40 text-label"]}>&nbsp;</div>
        <!-- HIDDEN shows the verdict's dark-window line (the slider is gone): its bar, in the line's place. -->
        <div class:list={[bar, "hidden w-48 text-label sky-hidden:block"]}>&nbsp;</div>
        <div class:list={[bar, "mt-line w-2/3 font-display text-display"]}>&nbsp;</div>
        <div class:list={[bar, "mt-1 w-3/4 text-body"]}>&nbsp;</div>
        <div class:list={[bar, "mt-line w-40 text-label max-sm:hidden"]}>&nbsp;</div>
      </div>
    </TonightSky>
    <!-- The live sky's slider row (interactive-sky) at its fixed height, so the tiles don't jump when it swaps in. -->
    <div class:list={[SLIDER_ROW_CLASS]} aria-hidden="true">
      <div class:list={[SLIDER_LAYOUT_CLASS]}>
        <div class:list={[bar, SLIDER_TIME_CLASS, "w-28 text-title"]}>&nbsp;</div>
        <div class:list={[SLIDER_TRACK_CLASS, "flex h-11 items-center"]}>
          <div class:list={[bar, "h-1.5 w-full"]}></div>
        </div>
        <div class:list={[bar, SLIDER_NOW_CLASS, "h-11 w-20"]}></div>
        <div class:list={[SLIDER_LEGEND_CLASS]}>
          <div class:list={[bar, "w-1/2 text-label"]}>&nbsp;</div>
        </div>
      </div>
    </div>
  </div>

  <!-- The gear row (ui-user-adjustments): the two cards under the slider, side by side from `sm`, at the cards' height. -->
  <div class:list={["mx-auto w-full max-w-3xl px-4", GEAR_ROW_GAP_CLASS]} aria-hidden="true">
    <div class:list={[GEAR_ROW_GRID_CLASS]}>
      <div class:list={[bar, "rounded-lg", GEAR_CARD_MIN_HEIGHT_CLASS]}></div>
      <div class:list={[bar, "rounded-lg", GEAR_CARD_MIN_HEIGHT_CLASS]}></div>
    </div>
  </div>

  <div class:list={["mx-auto w-full max-w-3xl", TILES_GAP_CLASS]}>
    <div aria-hidden="true">
      <div class:list={[tile]}>
        <div class:list={[bar, "w-40 text-label"]}>&nbsp;</div>
        <div class:list={[TILE_CONTENT_CLASS, "space-y-line"]}>
          {[1, 2, 3].map(() => (
            <div class:list={[bar, "w-2/3 text-title"]}>&nbsp;</div>
          ))}
        </div>
        <!-- The legend line for the "not seen yet" icons (observing-progress), then the tile's caption. -->
        <div class:list={[bar, "mt-group w-1/2 text-label"]}>&nbsp;</div>
        <!-- The tile's caption ("Each at the time it stands highest. N targets tonight."). -->
        <div class:list={[bar, "mt-line w-3/4 text-label"]}>&nbsp;</div>
      </div>

      <!-- The sky events tile (sky-events), straight after the targets: its heading and one line. -->
      <div class:list={[tile]}>
        <div class:list={[bar, "w-28 text-label"]}>&nbsp;</div>
        <div class:list={[bar, TILE_CONTENT_CLASS, "w-3/4 text-body"]}>&nbsp;</div>
      </div>

      <div class:list={[tile]}>
        <div class:list={[bar, "w-28 text-label"]}>&nbsp;</div>
        <div class:list={[bar, TILE_CONTENT_CLASS, "w-2/3 text-body"]}>&nbsp;</div>
      </div>

      <div class:list={[tile]}>
        <div class:list={[bar, "w-28 text-label"]}>&nbsp;</div>
        <div class:list={[TILE_CONTENT_CLASS, "flex items-center gap-4"]}>
          <div class="size-6 shrink-0 rounded-full bg-border motion-safe:animate-pulse"></div>
          <div class:list={[bar, "w-3/4 text-body"]}>&nbsp;</div>
        </div>
      </div>

      <div class:list={[tile]}>
        <div class:list={[bar, "w-24 text-label"]}>&nbsp;</div>
        <div class:list={[bar, TILE_CONTENT_CLASS, "w-1/2 text-body"]}>&nbsp;</div>
        <!-- The best planet's reason, a "why" Fact on the names' group. -->
        <div class:list={[bar, "mt-line w-2/3 text-label"]}>&nbsp;</div>
      </div>

      <div class:list={[tile]}>
        <div class:list={[bar, "w-36 text-label"]}>&nbsp;</div>
        <div class:list={[TILE_CONTENT_CLASS, "grid grid-cols-7 items-end gap-x-2"]}>
          {Array.from({ length: OUTLOOK_NIGHTS }, () => (
            /* A bar, its verdict mark's room and the day under it, as in TonightTiles. */
            <div class="flex flex-col items-center gap-line">
              <div class="h-10 w-full rounded bg-border motion-safe:animate-pulse sm:h-18" />
              <div class="size-3" />
              <div class:list={[bar, "w-6 text-label"]}>&nbsp;</div>
            </div>
          ))}
        </div>
        <!-- The caption, its own group, two lines on a phone. -->
        <div class:list={[bar, "mt-group w-3/4 text-label"]}>&nbsp;</div>
        <div class:list={[bar, "mt-0 w-1/3 text-label sm:hidden"]}>&nbsp;</div>
      </div>
    </div>

    <!-- Astro leaves this fallback in place when the island request fails, so a reload link appears after ~10 s. -->
    <p class="slow-hint mt-6 px-4 text-label text-muted-foreground">
      {t.loadingSlow}{" "}
      <a href="/tonight" class:list={[buttonVariants({ variant: "link", size: "sm" })]}>
        {t.reload}
      </a>
    </p>
  </div>
</div>

<style>
  /* visibility (not opacity) keeps the hint out of the accessibility tree and unclickable until it shows. */
  .slow-hint {
    visibility: hidden;
    animation: slow-hint-reveal 0s linear 10s forwards;
  }

  @keyframes slow-hint-reveal {
    to {
      visibility: visible;
    }
  }
</style>
