---
// Stand-in for TonightContent while its server island loads: the same sky (TonightSky, with the live sky's panorama
// strip and slider row reserved, interactive-sky) with bars where the date, the giant word and the headline lines go,
// then five ruled rows standing for the dashboard's tiles (TonightTiles), so
// nothing jumps when the real content swaps in. Bars that stand for text take that text's type role and hold a
// non-breaking space, so they have its line height.
import { SLIDER_ROW_CLASS } from "@/components/tonight/sky-band";
import TonightSky from "@/components/tonight/TonightSky.astro";
import { getMessages } from "@/i18n";
import { buttonVariants } from "@/components/ui/button";
import { TILE_ROW_CLASS } from "@/components/ui/tile";
import { OUTLOOK_NIGHTS } from "@/lib/engine/parameters";

const t = getMessages(Astro.locals.locale).tonight;
// bg-border, not bg-muted: --muted is the surface colour, so muted bars vanish on the ground.
const bar = "rounded bg-border motion-safe:animate-pulse";
// A tile row as TonightTiles draws it, from the same class source as `Tile`.
const tile = TILE_ROW_CLASS;
---

<!-- Only the loading line is the status: the back and reload links stay outside it, so a screen reader still
     reaches them if the island never arrives (tonight-dashboard review F8). -->
<div>
  <h1 class="sr-only">{t.title}</h1>
  <span role="status" class="sr-only">
    {t.loading}
  </span>
  <TonightSky night verdict strip>
    <div aria-hidden="true">
      <div class:list={[bar, "w-64 max-w-full text-label"]}>&nbsp;</div>
      <div class="mt-2 font-display text-verdict-lg font-extrabold sm:text-verdict-xl">
        <div class:list={[bar, "w-1/2"]}>&nbsp;</div>
      </div>
      <div class:list={[bar, "mt-5 w-3/4 text-title sm:mt-6"]}>&nbsp;</div>
      <div class:list={[bar, "mt-3 w-40 text-label"]}>&nbsp;</div>
    </div>
  </TonightSky>
  <!-- The live sky's slider row (interactive-sky) at its fixed height, so the tiles don't jump when it swaps in. -->
  <div class:list={[SLIDER_ROW_CLASS]} aria-hidden="true">
    <div class="flex items-center justify-between gap-3">
      <div class:list={[bar, "w-16 text-title"]}>&nbsp;</div>
      <div class:list={[bar, "h-11 w-20"]}></div>
    </div>
    <div class="flex h-11 items-center">
      <div class:list={[bar, "mt-1 h-1.5 w-full"]}></div>
    </div>
  </div>

  <div class="mx-auto w-full max-w-3xl pt-8">
    <div aria-hidden="true">
      <div class:list={[tile]}>
        <div class:list={[bar, "w-40 text-label"]}>&nbsp;</div>
        <div class="mt-3 space-y-2">
          {[1, 2, 3].map(() => (
            <div class:list={[bar, "w-2/3 text-title"]}>&nbsp;</div>
          ))}
        </div>
      </div>

      <div class:list={[tile]}>
        <div class:list={[bar, "w-28 text-label"]}>&nbsp;</div>
        <div class:list={[bar, "mt-2 w-2/3 text-body"]}>&nbsp;</div>
      </div>

      <div class:list={[tile]}>
        <div class:list={[bar, "w-28 text-label"]}>&nbsp;</div>
        <div class="mt-2 flex items-center gap-3">
          <div class="size-6 shrink-0 rounded-full bg-border motion-safe:animate-pulse"></div>
          <div class:list={[bar, "w-3/4 text-body"]}>&nbsp;</div>
        </div>
      </div>

      <div class:list={[tile]}>
        <div class:list={[bar, "w-24 text-label"]}>&nbsp;</div>
        <div class:list={[bar, "mt-2 w-1/2 text-body"]}>&nbsp;</div>
        <div class:list={[bar, "mt-1 w-2/3 text-label"]}>&nbsp;</div>
      </div>

      <div class:list={[tile]}>
        <div class:list={[bar, "w-36 text-label"]}>&nbsp;</div>
        <div class="mt-4 grid grid-cols-7 items-end gap-2">
          {Array.from({ length: OUTLOOK_NIGHTS }, () => (
            <div class="h-10 rounded bg-border motion-safe:animate-pulse sm:h-18" />
          ))}
        </div>
      </div>
    </div>

    <!-- Astro leaves this fallback in place when the island request fails, so a reload link appears after ~10 s. -->
    <p class="slow-hint mt-6 px-4 text-label text-muted-foreground">
      {t.loadingSlow}{" "}
      <a href="/tonight" class:list={[buttonVariants({ variant: "link", size: "sm" })]}>
        {t.reload}
      </a>
    </p>
  </div>
</div>

<style>
  /* visibility (not opacity) keeps the hint out of the accessibility tree and unclickable until it shows. */
  .slow-hint {
    visibility: hidden;
    animation: slow-hint-reveal 0s linear 10s forwards;
  }

  @keyframes slow-hint-reveal {
    to {
      visibility: visible;
    }
  }
</style>
