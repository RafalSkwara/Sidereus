---
/*
 * The slim sky at the top of a focused Tonight page (tonight-dashboard): TonightSky in its title-only mode with the
 * way back to Tonight, the page title and a context line (verdict dot · date · site · telescope). The dot's meaning
 * is in screen-reader text beside it (the sky headline), so it never rests on colour alone. Without a view (setup
 * missing or a failure) the context line is left out. The island renders it, since the line needs the view;
 * TonightPageSkeleton draws the same sky while it loads.
 */
import BackLink from "@/components/ui/BackLink.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import TonightSky from "@/components/tonight/TonightSky.astro";
import { VERDICT_TONES } from "@/components/tonight/verdict-tones";
import { getMessages } from "@/i18n";
import type { TonightView } from "@/lib/tonight/build";

interface Props {
  title: string;
  view: TonightView | null;
}

const { title, view } = Astro.props;
const m = getMessages(Astro.locals.locale);
const context = view ? [view.dateLabel, view.siteName, view.telescopeName].join(" · ") : null;
---

<TonightSky>
  <BackLink href="/tonight" label={m.nav.tonight} />
  <div class="mt-2">
    <PageHeader title={title} />
  </div>
  {view && (
    <p class="mt-3 text-label break-words text-muted-foreground">
      <span
        class:list={["mr-2 inline-block size-2.5 rounded-full align-middle", VERDICT_TONES[view.verdict.level].dot]}
        aria-hidden="true"
      ></span>
      <span class="sr-only">{m.tonight.pages.skyVerdict({ headline: view.headline.text })}</span>
      {context}
    </p>
  )}
</TonightSky>
