---
// The tooltip of `NotSeenMark`'s `tip` button (observing-progress): the legend, full width under the card's heading.
// It is placed against the card's `li` (`relative`, with `data-not-seen-scope`), not against the icon, so a name that
// wraps at 320 px never pushes it off screen; with no `top`, an absolutely placed box sits where it would have been in
// the flow, right under the heading. Closed is `hidden` (display: none), never `invisible`, so it cannot widen the
// page's scrollWidth. Its top edge meets the 24 px button with no gap a pointer can land in, so moving from the icon
// onto the tooltip keeps it open (WCAG 1.4.13 "hoverable", pinned by observing-progress.spec.ts); only the icon opens
// it, never the name.
// `data-open` (click, `not-seen-tip.ts`) shows it; hover and keyboard focus show it through the
// rule in `global.css`, under `@media (hover: hover)`. `open` renders it open, for `/design` and screenshots.
import { getMessages } from "@/i18n";

interface Props {
  /** Matches the button's `aria-describedby`. */
  id: string;
  open?: boolean;
}

const { id, open = false } = Astro.props;
const legend = getMessages(Astro.locals.locale).tonight.object.notSeen.legend;
---

<p
  id={id}
  role="tooltip"
  data-not-seen-tooltip
  data-open={open ? "" : undefined}
  class="absolute inset-x-0 z-10 hidden rounded-lg border border-border bg-surface px-3 py-2 text-label text-foreground data-open:block"
>
  {legend}
</p>
