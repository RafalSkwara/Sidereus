---
/*
 * The verdict over Tonight's sky (tonight-nightfall), rendered in TonightSky's slot: the date, the dark window and the
 * time zone on three lines of their own, the giant Go / Marginal / No-go word, the sky headline with its reason on one
 * flowing line, the next step, and how fresh the forecast is (a fresh forecast shows from `sm` only, ui-mobile-pass).
 * All text is heading or muted ink, the pair the contrast test pins on zenith and horizon; the verdict's colour is
 * only the small dot before the headline.
 */
import type { VerdictLevel } from "@/lib/engine";
import type { TonightDarkWindow, TonightExplanation, TonightForecastStatus } from "@/lib/tonight/build";
import type { SkyHeadline } from "@/lib/tonight/format";
import { VERDICT_TONES } from "@/components/tonight/verdict-tones";
import { getMessages } from "@/i18n";

interface Props {
  /** Picks the giant word and the dot's tone; the headline's words come from `headline`. */
  level: VerdictLevel;
  /** The night's date, e.g. "Saturday 4 October". */
  dateLabel: string;
  /** The sky headline from the verdict's level and reason (`skyHeadline`), e.g. "No forecast". */
  headline: SkyHeadline;
  /** The reason phrase, e.g. "no weather data". */
  text: string;
  darkWindow: TonightDarkWindow;
  timeZone: string;
  forecastStatus: TonightForecastStatus;
  /** What to do next on a weather no-go or a no-darkness night; `null` otherwise. */
  explanation: TonightExplanation | null;
  /** The heading's id, `verdict-heading` by default; /design gives each specimen its own so ids stay unique. */
  headingId?: string;
}

const {
  level,
  dateLabel,
  headline,
  text,
  darkWindow,
  timeZone,
  forecastStatus,
  explanation,
  headingId = "verdict-heading",
} = Astro.props;

const m = getMessages(Astro.locals.locale);
const t = m.tonight.card;
// The giant word (widths in global.css's verdict roles): below `sm` always verdict-sm (60 px, so the first screen has
// room for the gear and the targets), from `sm` as large as its length allows: Go, Tak, Nie at verdict-lg; Może,
// No-go at verdict-md; Marginal at verdict-sm.
const verdictSize = (word: string) =>
  word.length <= 3
    ? "text-verdict-sm sm:text-verdict-lg"
    : word.length <= 5
      ? "text-verdict-sm sm:text-verdict-md"
      : "text-verdict-sm";
// A saved copy or no forecast at all stands out from the routine "Forecast updated … ago", which phones skip.
const FORECAST_TONES: Record<TonightForecastStatus["kind"], string> = {
  fresh: "text-muted-foreground max-sm:hidden",
  fallback: "font-semibold text-heading",
  none: "font-semibold text-heading",
};
---

<section aria-labelledby={headingId}>
  <div class="text-label font-medium text-muted-foreground">
    <p>{dateLabel}</p>
    <p>
      {darkWindow.kind === "window" ? (
        <>
          {t.darkFrom} <span class="font-mono text-heading">{darkWindow.start}</span> {t.darkTo}{" "}
          <span class="font-mono text-heading">{darkWindow.end}</span>
        </>
      ) : explanation?.kind === "no-darkness" ? (
        explanation.returnText
      ) : (
        t.noDarkWindow
      )}
    </p>
    <p>{t.timesIn({ zone: timeZone })}</p>
  </div>
  <h2 id={headingId} class="mt-2 text-heading">
    <span class:list={["block font-display font-extrabold", verdictSize(m.tonight.verdict.word[level])]}>
      {m.tonight.verdict.word[level]}
    </span>{" "}
    <span class="mt-3 block text-title sm:mt-6">
      <span class="inline-flex items-center gap-2 font-display font-semibold" data-sky-headline={headline.key}>
        <span class:list={["size-2.5 shrink-0 rounded-full", VERDICT_TONES[level].dot]} aria-hidden="true"></span>
        {headline.text}
      </span>
      <span class="text-body font-normal text-muted-foreground">
        {t.separator}
        {text}
      </span>
    </span>
  </h2>
  {explanation?.kind === "weather-no-go" && <p class="mt-3 text-body text-heading">{explanation.nextText}</p>}
  {explanation?.kind === "no-darkness" && <p class="mt-3 text-body text-heading">{explanation.causeText}</p>}
  <p class:list={["mt-3 text-label", FORECAST_TONES[forecastStatus.kind]]}>{forecastStatus.text}</p>
</section>
