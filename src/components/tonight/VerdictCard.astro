---
import type { VerdictLevel } from "@/lib/engine";
import type { TonightDarkWindow } from "@/lib/tonight/build";

interface Props {
  level: VerdictLevel;
  /** The reason phrase, e.g. "no weather data". */
  text: string;
  darkWindow: TonightDarkWindow;
  timeZone: string;
}

const { level, text, darkWindow, timeZone } = Astro.props;

const LABELS: Record<VerdictLevel, string> = { go: "Go", marginal: "Marginal", "no-go": "No-go" };
const TONES: Record<VerdictLevel, string> = {
  go: "border-emerald-300/30 bg-emerald-300/10",
  marginal: "border-amber-300/30 bg-amber-300/10",
  "no-go": "border-red-400/30 bg-red-900/20",
};
const DOTS: Record<VerdictLevel, string> = {
  go: "bg-emerald-300",
  marginal: "bg-amber-300",
  "no-go": "bg-red-400",
};
---

<section aria-labelledby="verdict-heading" class:list={["rounded-2xl border p-4 sm:p-6", TONES[level]]}>
  <p class="mb-2 text-xs tracking-[0.18em] text-amber-200/70 uppercase">Tonight's verdict</p>
  <h2 id="verdict-heading" class="flex flex-wrap items-baseline gap-x-3 gap-y-1 font-serif text-3xl text-amber-50">
    <span class="inline-flex items-center gap-2">
      <span class:list={["size-2.5 rounded-full", DOTS[level]]} aria-hidden="true"></span>
      {LABELS[level]}
    </span>
    <span class="text-lg text-slate-200/90">— {text}</span>
  </h2>
  <p class="mt-3 text-sm text-slate-300/80">
    {darkWindow.kind === "window" ? (
      <>
        Dark from <span class="text-amber-100">{darkWindow.start}</span> to{" "}
        <span class="text-amber-100">{darkWindow.end}</span>
      </>
    ) : (
      "No dark window tonight"
    )}
    <span class="text-slate-400/80"> · times in {timeZone}</span>
  </p>
</section>
