---
/*
 * The verdict over Tonight's sky (tonight-nightfall, reshaped by ui-user-adjustments), rendered in TonightSky's slot:
 * the date, then the sky headline as the answer ("● Cloudy", at the display role with a larger tone dot), the reason
 * on its own line, the next step, and how fresh the forecast is (a fresh forecast shows from `sm` only,
 * ui-mobile-pass). With the live sky (`withSlider`) its slider shows the dark window and the zone, but its edge labels
 * are `aria-hidden`, so the same dark line stays as a screen-reader-only line; without the slider (the static fallback
 * when the sky view fails) that line is visible and muted, so the information is never lost.
 * On a night with a notable visible sky event (sky-events, M-3 S-07) one more line names it under the reason ("Tonight:
 * Perseids peak", `data-verdict-event` on its root): a muted `Fact` led by its event kind's icon, a solar eclipse's
 * `Eclipse` included (ui-dashboard-tiles D4, D7), so it reads as its own fact rather than the end of the reason. No
 * link (the dashboard's events tile carries it) and no reserved room, so the verdict grows by one line on those nights
 * only (plan review F3 still holds).
 * The rhythm (ui-dashboard-tiles D6): the answer is one group on the `line` role, date → headline, the event line, the
 * no-darkness lines that explain the headline and the forecast line; the weather no-go "Next clear night" advice is a
 * group of its own (`mt-group`). The headline → reason `mt-1` and the dot's nudge are the display line's own leading.
 * All text is heading or muted ink, the pair the contrast test pins on zenith and horizon; the verdict's colour is
 * only the dot before the headline, and besides it the verdict carries one muted icon, the event line's.
 */
import type { VerdictLevel } from "@/lib/engine";
import type { TonightDarkWindow, TonightExplanation, TonightForecastStatus } from "@/lib/tonight/build";
import type { SkyHeadline } from "@/lib/tonight/format";
import type { WordedEvent } from "@/lib/tonight/sky-events";
import { VERDICT_TONES } from "@/components/tonight/verdict-tones";
import Fact from "@/components/ui/Fact.astro";
import { getMessages } from "@/i18n";

interface Props {
  /** Picks the dot's tone; the headline's words come from `headline`. */
  level: VerdictLevel;
  /** The night's date, e.g. "Saturday 4 October". */
  dateLabel: string;
  /** The sky headline from the verdict's level and reason (`skyHeadline`), e.g. "No forecast". */
  headline: SkyHeadline;
  /** The reason phrase, e.g. "no weather data". */
  text: string;
  darkWindow: TonightDarkWindow;
  /** The zone's short name ("CEST"), for the static fallback's dark line. */
  zoneLabel: string;
  /**
   * The live sky is drawn (its slider shows the dark window and the zone): only the date sits above the headline, and
   * the dark line is `sr-only`. `false` is the static fallback, which shows one muted dark-window line.
   */
  withSlider: boolean;
  forecastStatus: TonightForecastStatus;
  /** What to do next on a weather no-go or a no-darkness night; `null` otherwise. */
  explanation: TonightExplanation | null;
  /**
   * The night's notable sky event, worded with its kind (`eventsVerdict`: "Tonight: Perseids peak", `meteor-shower`);
   * `null` or left out on every other night.
   */
  event?: WordedEvent | null;
  /** The heading's id, `verdict-heading` by default; /design gives each specimen its own so ids stay unique. */
  headingId?: string;
}

const {
  level,
  dateLabel,
  headline,
  text,
  darkWindow,
  zoneLabel,
  withSlider,
  forecastStatus,
  explanation,
  event = null,
  headingId = "verdict-heading",
} = Astro.props;

const m = getMessages(Astro.locals.locale);
const t = m.tonight.card;
// A saved copy or no forecast at all stands out from the routine "Forecast updated … ago", which phones skip.
const FORECAST_TONES: Record<TonightForecastStatus["kind"], string> = {
  fresh: "text-muted-foreground max-sm:hidden",
  fallback: "font-semibold text-heading",
  none: "font-semibold text-heading",
};
// The dark line: the window and the zone, or the no-window wording (a no-darkness night says it in the headline and
// under it, so the line is left out there). Visible in the static fallback, `sr-only` beside the live slider.
const darkLine =
  darkWindow.kind === "window"
    ? t.darkLine({ start: darkWindow.start, end: darkWindow.end, zone: zoneLabel })
    : explanation?.kind === "no-darkness"
      ? null
      : t.noDarkWindow;
---

<section aria-labelledby={headingId}>
  <p class="text-label font-medium text-muted-foreground">{dateLabel}</p>
  {/* Beside the live slider the line is for screen readers; in HIDDEN (no slider, ui-sky-modes) it shows. */}
  {darkLine && (
    <p
      class:list={["text-label font-medium text-muted-foreground", withSlider && "sr-only sky-hidden:not-sr-only"]}
      data-verdict-dark-line
    >
      {darkLine}
    </p>
  )}
  <h2 id={headingId} class="mt-line text-heading">
    <span class="flex items-start gap-3 font-display text-display font-semibold" data-sky-headline={headline.key}>
      <span
        class:list={["mt-2.5 size-4 shrink-0 rounded-full sm:mt-3.5", VERDICT_TONES[level].dot]}
        aria-hidden="true"
      ></span>
      {headline.text}
    </span>
    <span class="mt-1 block text-body font-normal text-muted-foreground first-letter:uppercase">{text}</span>
  </h2>
  {event && (
    <div class="mt-line">
      <Fact kind={event.kind} tone="muted" data-verdict-event>
        <p class="font-medium">{event.line}</p>
      </Fact>
    </div>
  )}
  {explanation?.kind === "weather-no-go" && <p class="mt-group text-body text-heading">{explanation.nextText}</p>}
  {explanation?.kind === "no-darkness" && (
    <>
      <p class="mt-line text-body text-heading">{explanation.returnText}</p>
      <p class="mt-line text-body text-heading">{explanation.causeText}</p>
    </>
  )}
  <p class:list={["mt-line text-label", FORECAST_TONES[forecastStatus.kind]]}>{forecastStatus.text}</p>
</section>
