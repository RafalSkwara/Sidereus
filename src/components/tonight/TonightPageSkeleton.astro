---
/*
 * Stand-in for a focused Tonight page's island while it loads (tonight-dashboard): the same slim sky as
 * TonightPageSky, with the real back link and title (both known in the shell) and a bar for the context line, then
 * ruled placeholder rows at the focused pages' rhythm (ui-fact-rhythm: the item role around each row, the stacked
 * Window and Best cards, the facts under a hairline), so nothing jumps when the island
 * swaps in. Bars that stand for text take that text's type role and hold a non-breaking space, so they have its line
 * height. `layout="plan"` stands in for the Session plan
 * instead (ui-user-adjustments): one 44 px bar for the edit row above the plan (adjustable-session-plan: "Edit plan", or
 * the free account's lock line), then its night lines, the legend and rows as tall as SessionTimeline's (name, line,
 * curve, hours).
 */
import BackLink from "@/components/ui/BackLink.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import TonightSky from "@/components/tonight/TonightSky.astro";
import { buttonVariants } from "@/components/ui/button";
import { getMessages } from "@/i18n";

interface Props {
  title: string;
  /** The page's own path, which the slow hint's reload link opens (never `/tonight`). */
  reloadHref: string;
  /** How many placeholder rows stand for the page's content. */
  rows?: number;
  /** `plan`: the Session plan's shape (SessionTimeline) instead of the generic rows. */
  layout?: "rows" | "plan";
  /** The back link, as `TonightPageSky` draws it (Tonight by default). */
  backHref?: string;
  backLabel?: string;
}

const { title, reloadHref, rows = 5, layout = "rows", backHref = "/tonight", backLabel } = Astro.props;
const m = getMessages(Astro.locals.locale);
const t = m.tonight;
// bg-border, not bg-muted: --muted is the surface colour, so muted bars vanish on the ground.
const bar = "rounded bg-border motion-safe:animate-pulse";
---

<!-- Only the loading line is the status: the back and reload links stay outside it, so a screen reader still
     reaches them if the island never arrives (tonight-dashboard review F8). -->
<div>
  <span role="status" class="sr-only">
    {t.loading}
  </span>
  <TonightSky night quiet>
    <BackLink href={backHref} label={backLabel ?? m.nav.tonight} />
    <div class="mt-1 sm:mt-2">
      <PageHeader title={title} />
    </div>
    <!-- The context line: date, then "site · telescope" on the next line on a phone (TonightPageSky). -->
    <div aria-hidden="true" class:list={[bar, "mt-2 w-40 max-w-full text-label sm:mt-3 sm:w-72"]}>
      &nbsp;
    </div>
    <div aria-hidden="true" class:list={[bar, "mt-1 w-56 max-w-full text-label sm:hidden"]}>
      &nbsp;
    </div>
  </TonightSky>

  <div class="mx-auto w-full max-w-3xl px-4 pt-8">
    {layout === "plan" ? (
      <div aria-hidden="true">
        {/* The edit row (PlanEditRow's collapsed "Edit plan"), 44 px, with the band's 32 px gap under it. */}
        <div class:list={[bar, "h-11 w-32"]} />
        <div class="mt-8 space-y-1.5">
          {["w-32", "w-44", "w-36", "w-32"].map((width) => (
            <div class:list={[bar, width, "text-label"]}>&nbsp;</div>
          ))}
        </div>
        <div class="mt-5 grid gap-x-6 gap-y-2 sm:grid-cols-2">
          {/* Five entries, one of them two lines long on a phone. */}
          {["w-64", "w-48", "w-72", "w-60", "w-56", "w-32"].map((width) => (
            <div class:list={[bar, width, "max-w-full text-label"]}>&nbsp;</div>
          ))}
        </div>
        <div class="mt-6 divide-y divide-border border-t border-border">
          {Array.from({ length: rows }, () => (
            <div class="py-6 sm:py-5">
              <div class:list={[bar, "w-1/2 text-title"]}>&nbsp;</div>
              <div class:list={[bar, "mt-1.5 w-2/3 text-label"]}>&nbsp;</div>
              <div class:list={[bar, "mt-3 h-12"]} />
              <div class="mt-1 h-4" />
            </div>
          ))}
        </div>
      </div>
    ) : (
      <div aria-hidden="true">
        <div class:list={[bar, "mb-4 w-56 max-w-full text-title"]}>&nbsp;</div>
        <div class="divide-y divide-border">
          {Array.from({ length: rows }, () => (
            <div class="py-item">
              <div class:list={[bar, "h-6 w-1/2"]} />
              <div class:list={[bar, "mt-line h-4 w-2/3"]} />
              {/* Window and Best: two cards stacked, each the full width of the column. */}
              <div class="mt-group grid gap-line">
                <div class:list={[bar, "h-14"]} />
                <div class:list={[bar, "h-14"]} />
              </div>
              <div class="mt-group space-y-line border-t border-border pt-group">
                <div class:list={[bar, "h-4 w-5/6"]} />
                <div class:list={[bar, "h-4 w-3/4"]} />
                <div class:list={[bar, "h-4 w-2/3"]} />
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Astro leaves this fallback in place when the island request fails, so a reload link appears after ~10 s. -->
    <p class="slow-hint mt-6 text-label text-muted-foreground">
      {t.loadingSlow}{" "}
      <a href={reloadHref} class:list={[buttonVariants({ variant: "link", size: "sm" })]}>
        {t.reload}
      </a>
    </p>
  </div>
</div>

<style>
  /* visibility (not opacity) keeps the hint out of the accessibility tree and unclickable until it shows. */
  .slow-hint {
    visibility: hidden;
    animation: slow-hint-reveal 0s linear 10s forwards;
  }

  @keyframes slow-hint-reveal {
    to {
      visibility: visible;
    }
  }
</style>
