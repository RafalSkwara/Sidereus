---
/*
 * Stand-in for a focused Tonight page's island while it loads (tonight-dashboard): the same slim sky as
 * TonightPageSky, with the real title (known in the shell), the finder's back link when `backHref` is given (the
 * focused pages have none: their sub-nav is the shell's, ui-tonight-nav) and a bar for the context line, then
 * ruled placeholder rows with a ranked target's geometry (ui-fact-rhythm: the item role around each row, the heading
 * and detail lines, the stacked Window and Best cards as StatCard boxes, the facts under a hairline, the actions), so
 * nothing jumps when the island swaps in. Bars that stand for text take that text's type role and hold a non-breaking
 * space, so they have its line height; a sentence that wraps on a phone gets a second line there (`sm:hidden` break).
 * `layout="plan"` stands in for the Session plan instead (ui-user-adjustments): one 44 px bar for the edit row above the
 * plan (adjustable-session-plan: "Edit plan", or the free account's lock line), then its night lines, the legend and
 * rows as tall as SessionTimeline's (name, line, curve, hours). `layout="nights"` and `layout="events"` stand in for
 * the two lighter list pages (ui-fact-rhythm), each sized to its real rows, since one shared row would be too tall for
 * a night or too short for an event: the Nights strip's "Times in" line, the verdict nights (date and dark window
 * beside the headline and two fact lines), then under the dashed rule the outlook nights (two fact lines); the events'
 * "Times in" line, then one night per row (its overline heading over an event: the kind icon beside the name and
 * "kind · when" lines, two facts at the group step). `layout="moon"` stands in for the Moon page (MoonCard): the phase
 * line, the disc beside its facts and the time slider (MoonTimeSlider's own geometry, see the branch), then one target
 * block under its rule, the default rows' Window, Best, facts and actions with the Moon's longer note. It is sized to a
 * night when the Moon is a target: nothing above the target block moves on a night when it is not, the block only
 * goes.
 */
import BackLink from "@/components/ui/BackLink.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import TonightSky from "@/components/tonight/TonightSky.astro";
import { buttonVariants } from "@/components/ui/button";
import { getMessages } from "@/i18n";
import { VERDICT_NIGHTS } from "@/lib/engine/parameters";

interface Props {
  title: string;
  /** The page's own path, which the slow hint's reload link opens (never `/tonight`). */
  reloadHref: string;
  /** How many placeholder rows stand for the page's content. */
  rows?: number;
  /**
   * The rows' shape: `rows` (default) a ranked target (Targets, Planets, the Moon); `plan` the Session plan's
   * (SessionTimeline); `nights` NightStrip's rows (the first `VERDICT_NIGHTS` with a verdict, the rest an outlook under
   * the dashed rule); `events` one night heading and one event row per row (SkyEventList); `moon` the Moon page's band
   * with the Moon as a target (MoonCard), which ignores `rows`.
   */
  layout?: "rows" | "plan" | "nights" | "events" | "moon";
  /** The back link, as `TonightPageSky` draws it: the finder chart's only; without it, no back link. */
  backHref?: string;
  backLabel?: string;
}

const { title, reloadHref, rows = 5, layout = "rows", backHref, backLabel } = Astro.props;
const m = getMessages(Astro.locals.locale);
const t = m.tonight;
// bg-border, not bg-muted: --muted is the surface colour, so muted bars vanish on the ground.
const bar = "rounded bg-border motion-safe:animate-pulse";
// The Nights layout: the strip's verdict nights first, the outlook nights under the dashed rule.
const verdictRows = Math.min(rows, VERDICT_NIGHTS);
const outlookRows = rows - verdictRows;
// NightStrip's left column and main column (the same classes, so the bars line up as the rows will).
const nightLeftCell = "flex w-26 shrink-0 flex-col gap-y-line sm:w-28";
const nightMainCell = "flex min-w-0 flex-1 flex-col gap-y-line";
// StatCard's box (its border and 8 px padding, here the line role) holding bars at its caption, value and sub lines:
// about 58 px for Window and 78 px for Best, as measured (StatCard's 2 px value nudge is left out).
const statCard = "rounded-lg border border-border bg-surface px-3 py-line";
// The rows and the Moon share a ranked target's details: the Moon draws one target block under its band.
const moon = layout === "moon";
const targetRows = moon ? 1 : rows;
// A round placeholder (the Moon's disc, the not-seen mark).
const blob = "rounded-full bg-border motion-safe:animate-pulse";
---

<!-- Only the loading line is the status: the finder's back link and the reload link stay outside it, so a screen
     reader still reaches them if the island never arrives (tonight-dashboard review F8). -->
<div>
  <span role="status" class="sr-only">
    {t.loading}
  </span>
  <TonightSky night quiet>
    {backHref && <BackLink href={backHref} label={backLabel ?? m.nav.tonight} />}
    <div class:list={[backHref && "mt-1 sm:mt-2"]}>
      <PageHeader title={title} />
    </div>
    <!-- The context line: date, then "site · telescope" on the next line on a phone (TonightPageSky). -->
    <div aria-hidden="true" class:list={[bar, "mt-2 w-40 max-w-full text-label sm:mt-3 sm:w-72"]}>
      &nbsp;
    </div>
    <div aria-hidden="true" class:list={[bar, "mt-1 w-56 max-w-full text-label sm:hidden"]}>
      &nbsp;
    </div>
  </TonightSky>

  <div class="mx-auto w-full max-w-3xl px-4 pt-8" data-skeleton-content>
    {layout === "plan" ? (
      <div aria-hidden="true">
        {/* The edit row (PlanEditRow's collapsed "Edit plan"), 44 px, with the band's 32 px gap under it. */}
        <div class:list={[bar, "h-11 w-32"]} />
        <div class="mt-8 space-y-1.5">
          {["w-32", "w-44", "w-36", "w-32"].map((width) => (
            <div class:list={[bar, width, "text-label"]}>&nbsp;</div>
          ))}
        </div>
        <div class="mt-5 grid gap-x-6 gap-y-2 sm:grid-cols-2">
          {/* Five entries, one of them two lines long on a phone. */}
          {["w-64", "w-48", "w-72", "w-60", "w-56", "w-32"].map((width) => (
            <div class:list={[bar, width, "max-w-full text-label"]}>&nbsp;</div>
          ))}
        </div>
        <div class="mt-6 divide-y divide-border border-t border-border">
          {Array.from({ length: rows }, () => (
            <div class="py-6 sm:py-5">
              <div class:list={[bar, "w-1/2 text-title"]}>&nbsp;</div>
              <div class:list={[bar, "mt-1.5 w-2/3 text-label"]}>&nbsp;</div>
              <div class:list={[bar, "mt-3 h-12"]} />
              <div class="mt-1 h-4" />
            </div>
          ))}
        </div>
      </div>
    ) : layout === "nights" ? (
      <div aria-hidden="true">
        <div class:list={[bar, "mb-group w-40 max-w-full text-label"]}>&nbsp;</div>
        <div class:list={[bar, "w-16 text-overline"]}>&nbsp;</div>
        <div class="divide-y divide-border">
          {Array.from({ length: verdictRows }, () => (
            <div class="flex gap-x-4 py-item">
              <div class:list={[nightLeftCell]}>
                <div class:list={[bar, "w-20 text-label"]}>&nbsp;</div>
                <div class:list={[bar, "w-24 text-label"]}>&nbsp;</div>
              </div>
              <div class:list={[nightMainCell]}>
                <div class:list={[bar, "w-24 text-label"]}>&nbsp;</div>
                {/* The reason and the Moon line, each two lines in the narrow column on a phone. */}
                <div class:list={[bar, "w-5/6 text-label"]}>
                  &nbsp;
                  <br class="sm:hidden" />
                  &nbsp;
                </div>
                <div class:list={[bar, "w-2/3 text-label"]}>
                  &nbsp;
                  <br class="sm:hidden" />
                  &nbsp;
                </div>
              </div>
            </div>
          ))}
        </div>
        {outlookRows > 0 && (
          <>
            <div class="mt-line border-t-2 border-dashed border-border pt-group">
              <div class:list={[bar, "w-40 max-w-full text-overline"]}>&nbsp;</div>
            </div>
            <div class="divide-y divide-border">
              {Array.from({ length: outlookRows }, () => (
                <div class="flex gap-x-4 py-item">
                  <div class:list={[nightLeftCell]}>
                    <div class:list={[bar, "w-20 text-label"]}>&nbsp;</div>
                    <div class:list={[bar, "w-24 text-label"]}>&nbsp;</div>
                  </div>
                  <div class:list={[nightMainCell]}>
                    <div class:list={[bar, "w-32 max-w-full text-label"]}>&nbsp;</div>
                    <div class:list={[bar, "w-2/3 text-label"]}>&nbsp;</div>
                  </div>
                </div>
              ))}
            </div>
          </>
        )}
      </div>
    ) : layout === "events" ? (
      <div aria-hidden="true">
        <div class:list={[bar, "mb-group w-40 max-w-full text-label"]}>&nbsp;</div>
        <div class="space-y-item">
          {Array.from({ length: rows }, () => (
            <div>
              <div class:list={[bar, "w-56 max-w-full text-overline"]}>&nbsp;</div>
              {/* SkyEventList's first row after its heading: the group step above, the item step below. */}
              <div class="flex items-start gap-3 pt-group pb-item">
                <div class:list={[bar, "size-5 shrink-0"]} />
                <div class="min-w-0 flex-1">
                  <div class="space-y-line">
                    <div class:list={[bar, "w-1/2 text-body"]}>&nbsp;</div>
                    <div class:list={[bar, "w-2/3 text-label"]}>&nbsp;</div>
                  </div>
                  <div class="mt-group space-y-line">
                    <div class:list={[bar, "w-5/6 text-label"]}>&nbsp;</div>
                    <div class:list={[bar, "w-3/4 text-label"]}>&nbsp;</div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    ) : (
      <div aria-hidden="true" data-skeleton-layout={layout}>
        {moon ? (
          <>
            {/* MoonTimeSlider's own geometry (an island, not on the rhythm roles), drawn with sizes: the phase line
                (text-body) and the slider's 16 px step under it as one 40 px box. */}
            <div class="h-10">
              <div class:list={[bar, "w-52 max-w-full text-body"]}>&nbsp;</div>
            </div>
            {/* The disc (MoonDisc's size) beside its facts, centred as the slider's row: when the Moon is up, what it
                does to faint objects (two lines in the narrow column on a phone), then the 44 px washed-out link,
                which a night with the Moon as a target usually has. */}
            <div class="flex items-center gap-4 sm:gap-5">
              <div class:list={[blob, "size-24 shrink-0 sm:size-28"]} />
              <div class="min-w-0 flex-1 space-y-line">
                <div class:list={[bar, "w-32 text-label"]}>&nbsp;</div>
                <div class:list={[bar, "w-full text-label"]}>
                  &nbsp;
                  <br class="sm:hidden" />
                  &nbsp;
                </div>
                <div class="flex h-11 items-center">
                  <div class:list={[bar, "w-52 max-w-full text-label"]}>&nbsp;</div>
                </div>
              </div>
            </div>
            {/* The slider: its 16 px step and the 44 px row of the time (text-title) and "Now" as one 60 px box, the
                range's 4 px step and 44 px input as a 48 px box with the thin track in it, then the edge times. */}
            <div class="flex h-15 flex-col justify-end">
              <div class="flex h-11 items-center justify-between">
                <div class:list={[bar, "w-16 text-title"]}>&nbsp;</div>
                <div class:list={[bar, "h-11 w-16"]} />
              </div>
            </div>
            <div class="flex h-12 items-center">
              <div class:list={[bar, "h-1.5 w-full"]} />
            </div>
            <div class="flex justify-between">
              <div class:list={[bar, "w-12 text-label"]}>&nbsp;</div>
              <div class:list={[bar, "w-12 text-label"]}>&nbsp;</div>
            </div>
          </>
        ) : (
          <>
            {/* The band's opening lines: Targets' heading and count, a stand-in for Planets' window line. */}
            <div class:list={[bar, "w-56 max-w-full text-title"]}>&nbsp;</div>
            <div class:list={[bar, "mt-line w-64 max-w-full text-label"]}>&nbsp;</div>
          </>
        )}
        {/* The Moon's target block sits under a rule at the item role; ranked targets are ruled rows. */}
        <div class:list={[moon ? "mt-item border-t border-border pt-item" : "mt-group divide-y divide-border"]}>
          {Array.from({ length: targetRows }, () => (
            /* A ranked target as ObjectCard and TargetDetails draw it. */
            <div class="py-item first:pt-0 last:pb-0">
              {moon ? (
                /* The Moon has no visible name: the not-seen mark's 24 px button (or the seen tag) takes its line. */
                <p class="mt-line">
                  <span class:list={[blob, "inline-block size-6 align-middle"]} />
                </p>
              ) : (
                <>
                  <div class:list={[bar, "w-1/2 text-title"]}>&nbsp;</div>
                  <div class:list={[bar, "mt-line w-2/3 text-label"]}>&nbsp;</div>
                </>
              )}
              {/* Window over Best, each a StatCard box: a caption over a value, Best with its direction under it. */}
              <div class="mt-group grid gap-line">
                <div class:list={[statCard]}>
                  <div class:list={[bar, "w-16 text-caption"]}>&nbsp;</div>
                  <div class:list={[bar, "w-28 text-body"]}>&nbsp;</div>
                </div>
                <div class:list={[statCard]}>
                  <div class:list={[bar, "w-12 text-caption"]}>&nbsp;</div>
                  <div class:list={[bar, "w-14 text-body"]}>&nbsp;</div>
                  <div class:list={[bar, "w-20 text-label"]}>&nbsp;</div>
                </div>
              </div>
              {/* The facts under the hairline: what you'll see, the eyepiece pair (two lines), why. A sentence wraps
                  to a second line on a phone, so its bar does too; the Moon's phase note is longer, two lines on a
                  wide screen and four on a phone. */}
              <div class="mt-group space-y-line border-t border-border pt-group">
                <div class:list={[bar, "w-full text-label"]}>
                  &nbsp;
                  {moon && (
                    <>
                      <br />
                      &nbsp;
                      <br class="sm:hidden" />
                      &nbsp;
                    </>
                  )}
                  <br class="sm:hidden" />
                  &nbsp;
                </div>
                <div class="space-y-line">
                  <div class:list={[bar, "w-3/4 text-label"]}>&nbsp;</div>
                  <div class:list={[bar, "w-2/3 text-label"]}>&nbsp;</div>
                </div>
                <div class:list={[bar, "w-5/6 text-label"]}>
                  &nbsp;
                  <br class="sm:hidden" />
                  &nbsp;
                </div>
              </div>
              {/* The actions: the 44 px hairline "Mark observed" and, on a ranked target, the quiet "Finder chart". */}
              <div class="mt-group flex flex-wrap gap-x-5 gap-y-line">
                <div class:list={[bar, "h-11 w-36"]} />
                {!moon && <div class:list={[bar, "w-28 self-center text-label"]}>&nbsp;</div>}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Astro leaves this fallback in place when the island request fails, so a reload link appears after ~10 s. -->
    <p class="slow-hint mt-6 text-label text-muted-foreground">
      {t.loadingSlow}{" "}
      <a href={reloadHref} class:list={[buttonVariants({ variant: "link", size: "sm" })]}>
        {t.reload}
      </a>
    </p>
  </div>
</div>

<style>
  /* visibility (not opacity) keeps the hint out of the accessibility tree and unclickable until it shows. */
  .slow-hint {
    visibility: hidden;
    animation: slow-hint-reveal 0s linear 10s forwards;
  }

  @keyframes slow-hint-reveal {
    to {
      visibility: visible;
    }
  }
</style>
