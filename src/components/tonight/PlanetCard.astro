---
// One planet of the "Planets tonight" section (M-2 S-01): the same card, tokens and details layout as the deep-sky
// ObjectCard, with the planet's facts, one detail eyepiece and a fixed "what you'll see" note.
import { getMessages } from "@/i18n";
import type { TonightPlanetEntry } from "@/lib/tonight/build";

interface Props {
  entry: TonightPlanetEntry;
  /** The log form for this planet, prefilled with tonight's night, site and telescope (FR-016). */
  logHref: string;
}

const { entry, logHref } = Astro.props;
const t = getMessages(Astro.locals.locale).tonight;
const facts = [entry.magnitudeText, entry.sizeText, entry.phaseText, entry.ringText].filter(
  (text): text is string => text !== null,
);
---

<li class="rounded-2xl border border-border bg-surface p-4 sm:p-5">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="font-display text-2xl font-semibold text-heading">{entry.name}</h3>
    <span class="font-mono text-sm text-muted-foreground">{facts.join(" · ")}</span>
  </div>
  {entry.seenText && (
    <p class="mt-2">
      <span class="inline-flex items-center rounded-full border border-border bg-accent px-2.5 py-0.5 text-xs font-medium text-muted-foreground">
        {entry.seenText}
      </span>
    </p>
  )}

  <dl class="mt-3 grid gap-x-6 gap-y-1 text-sm sm:grid-cols-2">
    <div class="flex gap-2">
      <dt class="text-muted-foreground">{t.object.window}</dt>
      <dd class="font-mono text-heading">
        {entry.windowStart}–{entry.windowEnd}
      </dd>
    </div>
    <div class="flex gap-2">
      <dt class="text-muted-foreground">{t.object.best}</dt>
      <dd class="font-mono text-heading">
        {entry.bestTime}, {entry.bestDirection}
      </dd>
    </div>
  </dl>

  {entry.eyepiece && (
    <p class="mt-2 text-sm text-foreground">
      {t.planets.detailWith} <span class="font-semibold text-primary-strong">{entry.eyepiece.name}</span>{" "}
      {t.object.magnification({ magnification: String(entry.eyepiece.magnification) })}
    </p>
  )}

  <p class="mt-2 text-sm text-foreground">{entry.reason}</p>
  <p class="mt-2 text-sm text-muted-foreground">{entry.note}</p>

  <div class="mt-3 border-t border-border pt-3">
    <a
      href={logHref}
      aria-label={t.planets.markObserved({ planet: entry.name })}
      class="inline-flex min-h-11 items-center text-sm font-semibold text-primary-strong transition-colors hover:text-heading"
    >
      {t.object.markObserved}
    </a>
  </div>
</li>
