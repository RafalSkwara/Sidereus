---
// One planet of the "Planets tonight" band (M-2 S-01): a row in its ruled list, with the same tokens and details
// layout (TargetDetails) as the deep-sky rows, with the planet's facts, one detail eyepiece and a fixed "what you'll
// see" note. Its `planet-<key>` id is where the live sky's markers land (`/tonight/planets#planet-jupiter`,
// interactive-sky).
import NotSeenMark from "@/components/tonight/NotSeenMark.astro";
import NotSeenTip from "@/components/tonight/NotSeenTip.astro";
import SeenTag from "@/components/tonight/SeenTag.astro";
import TargetDetails from "@/components/tonight/TargetDetails.astro";
import { getMessages } from "@/i18n";
import type { TonightPlanetEntry } from "@/lib/tonight/build";

interface Props {
  entry: TonightPlanetEntry;
  /** The log form for this planet, prefilled with tonight's night, site and telescope (FR-016). */
  logHref: string;
}

const { entry, logHref } = Astro.props;
const t = getMessages(Astro.locals.locale).tonight;
const tipId = `not-seen-tip-planet-${entry.key}`;
const facts = [entry.magnitudeText, entry.sizeText, entry.phaseText, entry.ringText].filter(
  (text): text is string => text !== null,
);
---

<li id={`planet-${entry.key}`} data-not-seen-scope class="relative scroll-mt-4 py-5 first:pt-0 last:pb-0">
  {/* Only the mark's button sits in the heading; its tooltip follows the heading (it must not be heading text). */}
  <h3 class="font-display text-title font-semibold break-words text-heading">
    <span data-target-name>{entry.name}</span>
    {entry.notSeenYet && <NotSeenMark variant="tip" id={tipId} />}
  </h3>
  {entry.notSeenYet && <NotSeenTip id={tipId} />}
  {/* One fact per line under the name: magnitude, size, phase, rings. */}
  <div class="mt-1 space-y-1 font-mono text-label text-muted-foreground">
    {facts.map((fact) => (
      <p>{fact}</p>
    ))}
  </div>
  {entry.seenText && <SeenTag text={entry.seenText} />}

  <TargetDetails
    windowStart={entry.windowStart}
    windowEnd={entry.windowEnd}
    bestTime={entry.bestTime}
    bestDirection={entry.bestDirection}
    logHref={logHref}
    ariaLabel={t.planets.markObserved({ planet: entry.name })}
  >
    {entry.eyepiece && (
      <p class="text-label text-foreground">
        {t.planets.detailWith} <span class="font-semibold text-primary-strong">{entry.eyepiece.name}</span>{" "}
        {t.object.magnification({ magnification: String(entry.eyepiece.magnification) })}
      </p>
    )}

    <p class="text-label text-foreground">{entry.reason}</p>
    <p class="text-label text-muted-foreground">{entry.note}</p>
  </TargetDetails>
</li>
