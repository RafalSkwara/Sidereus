---
// One planet of the "Planets tonight" band (M-2 S-01): a row in its ruled list, with the same tokens and details
// layout (TargetDetails) as the deep-sky rows. Under the name, its labelled facts (brightness, apparent size, phase,
// rings; ui-fact-rhythm); under the hairline, in D5's order, the fixed "what you'll see" note (the accent Eye), one
// detail eyepiece and why (muted). Its `planet-<key>` id is where the live sky's markers land
// (`/tonight/planets#planet-jupiter`, interactive-sky). Facts are `div`s, never list items: the card is the list's
// `listitem`.
import NotSeenMark from "@/components/tonight/NotSeenMark.astro";
import NotSeenTip from "@/components/tonight/NotSeenTip.astro";
import SeenTag from "@/components/tonight/SeenTag.astro";
import TargetDetails from "@/components/tonight/TargetDetails.astro";
import Fact from "@/components/ui/Fact.astro";
import FactList from "@/components/ui/FactList.astro";
import { getMessages } from "@/i18n";
import type { TonightPlanetEntry } from "@/lib/tonight/build";

interface Props {
  entry: TonightPlanetEntry;
  /** The log form for this planet, prefilled with tonight's night, site and telescope (FR-016). */
  logHref: string;
  /** The finder chart for this planet (finder-chart). */
  finderHref: string;
}

const { entry, logHref, finderHref } = Astro.props;
const t = getMessages(Astro.locals.locale).tonight;
const tipId = `not-seen-tip-planet-${entry.key}`;
// A label, a space, then the value (the `Fact` label): "Brightness mag −1.9", "Jasność −1,9 mag". Null facts
// (phase off Mercury and Venus, rings off Saturn) are skipped.
type PlanetFact = "magnitude" | "size" | "phase" | "rings";
const allFacts: [PlanetFact, string | null][] = [
  ["magnitude", entry.magnitudeText],
  ["size", entry.sizeText],
  ["phase", entry.phaseText],
  ["rings", entry.ringText],
];
const facts = allFacts.filter((fact): fact is [PlanetFact, string] => fact[1] !== null);
---

<li id={`planet-${entry.key}`} data-not-seen-scope class="relative scroll-mt-4 py-item first:pt-0 last:pb-0">
  {/* Only the mark's button sits in the heading; its tooltip follows the heading (it must not be heading text). */}
  <h3 class="font-display text-title font-semibold break-words text-heading">
    <span data-target-name>{entry.name}</span>
    {entry.notSeenYet && <NotSeenMark variant="tip" id={tipId} />}
  </h3>
  {entry.notSeenYet && <NotSeenTip id={tipId} />}
  {/* One labelled fact per line under the name: brightness, apparent size, phase, rings. */}
  <FactList class="mt-line">
    {facts.map(([kind, value]) => (
      <Fact kind={kind} label={t.planets.factLabel[kind]}>
        <span class="font-mono text-heading">{value}</span>
      </Fact>
    ))}
  </FactList>
  {entry.seenText && <SeenTag text={entry.seenText} />}

  <TargetDetails
    windowStart={entry.windowStart}
    windowEnd={entry.windowEnd}
    bestTime={entry.bestTime}
    bestDirection={entry.bestDirection}
    logHref={logHref}
    finderHref={finderHref}
    finderLabel={t.finder.linkLabel({ target: entry.name })}
    ariaLabel={t.planets.markObserved({ planet: entry.name })}
  >
    <Fact kind="see" iconClass="text-primary-strong">
      <p>{entry.note}</p>
    </Fact>
    {entry.eyepiece && (
      <Fact kind="eyepiece">
        <p>
          {t.planets.detailWith} <span class="font-semibold text-heading">{entry.eyepiece.name}</span>{" "}
          {t.object.magnification({ magnification: String(entry.eyepiece.magnification) })}
        </p>
      </Fact>
    )}
    <Fact kind="why" tone="muted">
      <p>{entry.reason}</p>
    </Fact>
  </TargetDetails>
</li>
