---
// The details every Tonight target shares (S-01 review F10; ui-fact-rhythm): Window and Best as a stat pair, then,
// under a hairline, the caller's own facts (what you'll see, the eyepieces, why) in the default slot, then the "Mark
// observed" link. Used by ObjectDetails (ranked cards and the all-objects rows), PlanetCard and the Moon card. Window
// and Best are two cards stacked in one column, Best under Window, each the full width of its column at every width
// (owner change of 2026-10-15); every other fact sits on its own line. The spacing between the pair, the facts and
// the actions lives here (the rhythm roles), so a caller's facts carry no margins of their own.
import { Check, Crosshair } from "lucide-react";
import FactList from "@/components/ui/FactList.astro";
import StatCard from "@/components/ui/StatCard.astro";
import StatPair from "@/components/ui/StatPair.astro";
import { buttonVariants } from "@/components/ui/button";
import { getMessages } from "@/i18n";

interface Props {
  /** Best window, `HH:mm` in the site's time zone. */
  windowStart: string;
  windowEnd: string;
  bestTime: string;
  /** "SW, 45°" */
  bestDirection: string;
  /** The log form for this target, prefilled with tonight's night, site and telescope (FR-016). */
  logHref: string;
  /**
   * The finder chart for this target (finder-chart), a second link beside "Mark observed", a quiet one; the Moon card passes
   * none. It has no `data-needs-network`: offline, a stored chart opens from the device (D-15).
   */
  finderHref?: string;
  /** The finder link's accessible name with the target ("Finder chart for M31"); required with `finderHref`. */
  finderLabel?: string;
  /**
   * How the link names its target for assistive tech, keeping each caller's naming: `srSuffix` appends a visually
   * hidden " M31" (the label) to the visible text (objects), `ariaLabel` replaces the name ("Mark observed: Jupiter").
   */
  srSuffix?: string;
  ariaLabel?: string;
}

const { windowStart, windowEnd, bestTime, bestDirection, logHref, finderHref, finderLabel, srSuffix, ariaLabel } =
  Astro.props;
const tonight = getMessages(Astro.locals.locale).tonight;
const t = tonight.object;
// "Mark observed" is the per-item hairline (a border, no fill, a check icon); "Finder chart" is a quiet text action.
const markClass = buttonVariants({ variant: "hairline", size: "sm" });
const finderClass = buttonVariants({ variant: "quiet", size: "bare" });
---

<StatPair class="mt-group">
  <StatCard label={t.window} kind="when">
    {windowStart}–{windowEnd}
  </StatCard>
  <StatCard label={t.best} kind="best">
    {bestTime}
    <Fragment slot="sub">{bestDirection}</Fragment>
  </StatCard>
</StatPair>

<FactList class="mt-group border-t border-border pt-group">
  <slot />
</FactList>

<div class="mt-group flex flex-wrap gap-x-5 gap-y-line">
  {/* Saving an observation needs the network: disabled offline (S-06, src/lib/offline/page-state.ts). */}
  <a href={logHref} aria-label={ariaLabel} class:list={[markClass]} data-needs-network="">
    <Check aria-hidden="true" />
    {t.markObserved}
    {srSuffix !== undefined && <span class="sr-only"> {srSuffix}</span>}
  </a>
  {/* The chart opens offline too when it is stored (finder-chart D-15), so no `data-needs-network`. */}
  {finderHref !== undefined && (
    <a href={finderHref} aria-label={finderLabel} class:list={[finderClass]}>
      <Crosshair aria-hidden="true" />
      {tonight.finder.link}
    </a>
  )}
</div>
