---
/*
 * Tonight's sky (tonight-nightfall): a full-bleed zenith-to-horizon band with a decorative star field, ending in a
 * horizon silhouette in the page's ground colour. Under GearShell's sky-flow mode it continues the Topbar's zenith
 * strip, so the page reads as one sky. The slot (the date, the verdict and its reason) sits in the shared
 * `max-w-3xl px-4` container. Stars and horizon are inline SVG filled from tokens, so red mode stays pure red;
 * the stars show under a night sky (`night:`). Tonight's callers pass `night` (ui-sky-light): the band joins the
 * `night-sky` scope, so in the light theme it stays a navy night with its stars; the landing page leaves it out.
 */

import {
  SILHOUETTE_CLASS,
  SILHOUETTE_PATH,
  SILHOUETTE_VIEWBOX,
  STRIP_HEIGHT_CLASS,
  VERDICT_CONTAINER_CLASS,
  VERDICT_MIN_HEIGHT_CLASS,
} from "@/components/tonight/sky-band";

interface Props {
  /**
   * The sky holds a verdict (or the skeleton standing in for one): it keeps the verdict's minimum height. The setup,
   * add-site and no-view states leave it out, so their title-only sky stays short.
   */
  verdict?: boolean;
  /**
   * Reserve the interactive sky's panorama strip between the verdict and the silhouette (interactive-sky): the
   * skeleton sets it, so the live band (`TonightSkyView`) swaps in at the same height.
   */
  strip?: boolean;
  /** A Tonight sky: the band joins the `night-sky` scope and stays a navy night in the light theme (ui-sky-light). */
  night?: boolean;
  /**
   * Dim the symbolic star field (ui-user-adjustments): the focused pages and their skeleton pass it, so their stars
   * stay behind the content; the dashboard and the landing keep the full field. `--star` itself is unchanged.
   */
  quiet?: boolean;
}

const { verdict = false, strip = false, night = false, quiet = false } = Astro.props;

// A fixed, seeded field (the canvas's Lehmer generator), so every render draws the same sky. Positions are
// percentages of the band, so the field spans any width while each star keeps its size; more stars sit high.
const STAR_COUNT = 80;
let seed = 11;
const next = () => {
  seed = (seed * 16807) % 2147483647;
  return seed / 2147483647;
};
const stars = Array.from({ length: STAR_COUNT }, () => ({
  x: `${(next() * 100).toFixed(2)}%`,
  y: `${(3 + Math.pow(next(), 1.4) * 82).toFixed(2)}%`,
  r: (0.4 + next() * 0.9).toFixed(1),
}));
---

<div class:list={["relative overflow-hidden bg-linear-to-b from-zenith to-horizon", night && "night-sky"]}>
  <svg
    aria-hidden="true"
    focusable="false"
    class:list={["absolute inset-0 hidden size-full fill-star night:block", quiet && "opacity-40"]}
  >
    {stars.map((star) => (
      <circle cx={star.x} cy={star.y} r={star.r} />
    ))}
  </svg>
  <!-- The minimum height is the go/clear verdict's content, so the skeleton paints the same sky and nothing jumps. -->
  <div class:list={[VERDICT_CONTAINER_CLASS, verdict && VERDICT_MIN_HEIGHT_CLASS]}>
    <slot />
  </div>
  {strip && <div class:list={["relative", STRIP_HEIGHT_CLASS]} />}
  <svg
    aria-hidden="true"
    focusable="false"
    viewBox={SILHOUETTE_VIEWBOX}
    preserveAspectRatio="none"
    class:list={[SILHOUETTE_CLASS]}
  >
    <path d={SILHOUETTE_PATH}></path>
  </svg>
</div>
