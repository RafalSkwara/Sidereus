---
// One ranked object on Tonight: a row in the ranking band's ruled list, its heading and the shared details.
import ObjectDetails from "@/components/tonight/ObjectDetails.astro";
import SeenTag from "@/components/tonight/SeenTag.astro";
import { getMessages } from "@/i18n";
import { localCommonName } from "@/lib/catalogue/common-names";
import type { TonightEntry } from "@/lib/tonight/build";

interface Props {
  entry: TonightEntry;
  rank: number;
  /** The log form for this object, prefilled with the ranking's night, site and telescope (FR-016). */
  logHref: string;
}

const { entry, rank, logHref } = Astro.props;
const { locale } = Astro.locals;
const t = getMessages(locale).tonight.object;
const commonName = localCommonName(entry.messier, entry.commonName, locale);
---

<li class="py-4 first:pt-0 last:pb-0">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="font-display text-title font-semibold break-words text-heading">
      <span class="mr-2 font-mono text-label font-normal text-muted-foreground">{rank}.</span>
      {entry.id}
      {commonName && <span class="text-body text-foreground"> · {commonName}</span>}
    </h3>
    <span class="text-label text-muted-foreground">{t.inConstellation({ constellation: entry.constellation })}</span>
  </div>
  {entry.seenText && <SeenTag text={entry.seenText} />}

  <ObjectDetails entry={entry} logHref={logHref} />
</li>
