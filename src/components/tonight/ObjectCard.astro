---
import type { TonightEntry } from "@/lib/tonight/build";

interface Props {
  entry: TonightEntry;
  rank: number;
}

const { entry, rank } = Astro.props;
---

<li class="rounded-2xl border border-white/10 bg-white/5 p-4 sm:p-5">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="font-serif text-2xl text-amber-50">
      <span class="mr-2 text-sm text-amber-200/60">{rank}.</span>
      {entry.id}
      {entry.commonName && <span class="text-lg text-slate-200/90"> · {entry.commonName}</span>}
    </h3>
    <span class="text-sm text-slate-300/80">in {entry.constellation}</span>
  </div>

  <dl class="mt-3 grid gap-x-6 gap-y-1 text-sm sm:grid-cols-2">
    <div class="flex gap-2">
      <dt class="text-slate-400/80">Window</dt>
      <dd class="text-amber-100">
        {entry.windowStart}–{entry.windowEnd}
      </dd>
    </div>
    <div class="flex gap-2">
      <dt class="text-slate-400/80">Best</dt>
      <dd class="text-amber-100">
        {entry.bestTime}, {entry.bestDirection}
      </dd>
    </div>
  </dl>

  {entry.pair?.kind === "pair" && (
    <p class="mt-2 text-sm text-slate-300/90">
      Find with <span class="text-amber-100">{entry.pair.finding.name}</span> ({entry.pair.finding.magnification}×) ·
      detail with <span class="text-amber-100">{entry.pair.detail.name}</span> ({entry.pair.detail.magnification}×)
    </p>
  )}
  {entry.pair?.kind === "none-fit" && (
    <p class="mt-2 text-sm text-slate-300/90">
      Larger than any field in your kit; use your widest ({entry.pair.widestName}) and sweep across it
    </p>
  )}

  <p class="mt-2 text-sm text-slate-200/90">{entry.reason}</p>
</li>
