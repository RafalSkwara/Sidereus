---
// One object on the Targets page (tonight-all-objects, Nightfall since tonight-dashboard): a ruled row in the list's
// `divide-y`, which expands into the same details as Tonight's card. Native <details>, so opening a row needs no
// script of its own. `data-object` (the space-free target key, never the label) and `data-best-at` (the peak instant) are what the e2e reads.
import ObjectDetails from "@/components/tonight/ObjectDetails.astro";
import { localCommonName } from "@/lib/catalogue/common-names";
import type { TonightEntry } from "@/lib/tonight/build";
import { createFormatter } from "@/lib/tonight/format";

interface Props {
  entry: TonightEntry;
  /** The log form for this object, returning to the Targets page (`from=targets`). */
  logHref: string;
}

const { entry, logHref } = Astro.props;
const { locale } = Astro.locals;
const { objectDetailLine } = createFormatter(locale);
const commonName = localCommonName(entry.id, entry.commonName, locale);
const detailLine = objectDetailLine(entry.caldwell, entry.constellation);
---

<li data-object={entry.id} data-label={entry.label} data-best-at={entry.bestAt}>
  <details class="group">
    <!-- At least 44 px; the hover tint and the ring run a little past the text, inside the list's width. -->
    <summary
      class:list={[
        "-mx-2 flex min-h-11 cursor-pointer list-none items-center gap-3 rounded-lg px-2 py-4 [&::-webkit-details-marker]:hidden",
        "transition-colors hover:bg-accent motion-reduce:transition-none",
        "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring",
      ]}
    >
      <span class="w-7 shrink-0 text-right font-mono text-label text-muted-foreground">{entry.rank}.</span>
      <span class="min-w-0 flex-1">
        <span class="font-display text-title font-semibold break-words text-heading">{entry.label}</span>
        {commonName && <span class="text-body text-foreground"> · {commonName}</span>}
        {entry.seenText && <span class="block text-label text-muted-foreground">{entry.seenText}</span>}
      </span>
      <span class="shrink-0 text-right font-mono text-label text-heading">
        {entry.bestTime}
        <span class="block text-muted-foreground">{entry.bestDirection}</span>
      </span>
      <svg
        viewBox="0 0 24 24"
        class="size-4 shrink-0 text-muted-foreground transition-transform duration-150 group-open:rotate-180 motion-reduce:transition-none"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m6 9 6 6 6-6"></path>
      </svg>
    </summary>
    <div class="pb-5 pl-10">
      <p class="text-label text-muted-foreground">{detailLine}</p>
      <ObjectDetails entry={entry} logHref={logHref} />
    </div>
  </details>
</li>
