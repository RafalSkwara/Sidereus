---
// FR-012 / FR-019: which site or telescope Tonight is for, shown only to users who own two or more. Plain links
// (pills) or a plain GET form (dropdown), so both work without JavaScript; `/tonight?<param>=<id>` remembers the
// pick (see pages/tonight.astro). Only ids go into the links, never a site's coordinates.
import { selectorKind } from "@/lib/tonight/gear-choice";

interface Props {
  /** In `created_at` order. */
  items: { id: string; name: string }[];
  activeId: string;
  /** The page query parameter the pick travels in. */
  param: "site" | "telescope";
  /** Names the pills' navigation and the dropdown; must differ between the site and telescope selectors. */
  label: string;
  /** The dropdown's submit button, for when JavaScript is off. */
  show: string;
}

const { items, activeId, param, label, show } = Astro.props;
const kind = selectorKind(items.length);
const selectId = `${param}-select`;

const pillBase =
  "inline-flex max-w-full items-center rounded-full border px-3 py-1.5 text-sm font-medium transition-colors";
---

{kind === "pills" && (
  <nav aria-label={label} class="mb-6">
    <ul class="flex flex-wrap gap-2">
      {items.map((item) => {
        const active = item.id === activeId;
        return (
          <li class="min-w-0">
            <a
              href={`/tonight?${param}=${encodeURIComponent(item.id)}`}
              aria-current={active ? "page" : undefined}
              title={item.name}
              class:list={[
                pillBase,
                active
                  ? "border-primary bg-primary text-primary-foreground"
                  : "border-border bg-surface text-foreground hover:text-heading",
              ]}
            >
              <span class="truncate">{item.name}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
)}

{kind === "dropdown" && (
  <form method="get" action="/tonight" class="mb-6 flex flex-wrap items-center gap-2" data-gear-select={param}>
    <label for={selectId} class="text-sm text-muted-foreground">
      {label}
    </label>
    <select
      id={selectId}
      name={param}
      class="max-w-full rounded-lg border border-input bg-surface px-3 py-1.5 text-sm text-foreground outline-none transition-shadow focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50"
    >
      {items.map((item) => (
        <option value={item.id} selected={item.id === activeId}>
          {item.name}
        </option>
      ))}
    </select>
    <button
      type="submit"
      class="rounded-lg border border-border bg-surface px-3 py-1.5 text-sm font-medium text-foreground transition-colors hover:text-heading"
    >
      {show}
    </button>
  </form>
)}

<script>
  // Progressive enhancement: switch as soon as an item is picked. Without it, the Show button submits.
  function enhance(form: HTMLFormElement) {
    if (form.dataset.enhanced) return;
    form.dataset.enhanced = "true";
    form.querySelector("button[type=submit]")?.setAttribute("hidden", "");
    form.querySelector("select")?.addEventListener("change", () => {
      form.requestSubmit();
    });
  }
  document.querySelectorAll<HTMLFormElement>("form[data-gear-select]").forEach(enhance);
</script>
