---
// FR-012 / FR-019: which site or telescope Tonight is for, shown only to users who own two or more. Plain links
// (pills) or a plain GET form (dropdown) that need no script of their own (the one below only submits on change);
// `/tonight?<param>=<id>` remembers the pick (see pages/tonight.astro). They render inside the TonightContent server
// island, which the browser fetches with JavaScript, so Tonight as a whole still needs JS. Only ids go into the
// links, never a site's coordinates.
import GearSelectField from "@/components/tonight/GearSelectField";
import { buttonVariants } from "@/components/ui/button";
import { selectorKind } from "@/lib/tonight/gear-choice";
import { cn } from "@/lib/utils";

interface Props {
  /** In `created_at` order. */
  items: { id: string; name: string }[];
  activeId: string;
  /** The page query parameter the pick travels in. */
  param: "site" | "telescope";
  /** Names the pills' navigation and the dropdown; must differ between the site and telescope selectors. */
  label: string;
  /** The dropdown's submit button, for when JavaScript is off. */
  show: string;
}

const { items, activeId, param, label, show } = Astro.props;
const kind = selectorKind(items.length);
const selectId = `${param}-select`;

// 44 px link-buttons; the active pill is an outline (never the primary fill, which would read as an action).
const pillClass = (active: boolean) =>
  cn(buttonVariants({ variant: active ? "outline" : "ghost", size: "sm" }), "max-w-full");
---

{kind === "pills" && (
  <nav aria-label={label} class="mb-6">
    <ul class="flex flex-wrap gap-2">
      {items.map((item) => {
        const active = item.id === activeId;
        return (
          <li class="min-w-0">
            <a
              href={`/tonight?${param}=${encodeURIComponent(item.id)}`}
              aria-current={active ? "page" : undefined}
              title={item.name}
              class:list={[pillClass(active)]}
            >
              <span class="min-w-0 truncate">{item.name}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
)}

{kind === "dropdown" && (
  <form method="get" action="/tonight" class="mb-6 flex flex-wrap items-end gap-2 sm:max-w-sm" data-gear-select={param}>
    <GearSelectField id={selectId} name={param} label={label} items={items} activeId={activeId} />
    <button type="submit" class:list={[buttonVariants({ variant: "outline" })]}>
      {show}
    </button>
  </form>
)}

<script>
  // Progressive enhancement: switch as soon as an item is picked. Without it, the Show button submits.
  function enhance(form: HTMLFormElement) {
    if (form.dataset.enhanced) return;
    form.dataset.enhanced = "true";
    form.querySelector("button[type=submit]")?.setAttribute("hidden", "");
    form.querySelector("select")?.addEventListener("change", () => {
      form.requestSubmit();
    });
  }
  document.querySelectorAll<HTMLFormElement>("form[data-gear-select]").forEach(enhance);
</script>
