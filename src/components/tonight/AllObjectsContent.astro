---
// The data-dependent part of /tonight/all (tonight-all-objects): every object that cleared tonight's bar for the
// same site and telescope as Tonight, as compact rows, by rank or by best time. A server island like
// TonightContent, loading through the same loadTonight so both pages always agree.
import { ServerError } from "@/components/forms/ServerError";
import ObjectRow from "@/components/tonight/ObjectRow.astro";
import { getMessages, plural, translateKey } from "@/i18n";
import { localCommonName } from "@/lib/catalogue/common-names";
import { sortEntries, type AllObjectsSort } from "@/lib/tonight/all-objects";
import { loadTonightFor } from "@/lib/tonight/island";
import { logHref } from "@/lib/tonight/load";

interface Props {
  siteId?: string;
  telescopeId?: string;
  sort: AllObjectsSort;
}

const { locale } = Astro.locals;
const { siteId, telescopeId, sort } = Astro.props;
const m = getMessages(locale);
const t = m.tonight;
const a = t.all;

// Signed out, `load` is null and the island renders nothing.
const load = await loadTonightFor(Astro.locals, { siteId, telescopeId, limit: Number.POSITIVE_INFINITY });
const view = load?.view ?? null;
const rows = view?.ranking
  ? sortEntries(view.ranking.entries, sort).map((entry) => ({ entry, href: logHref(view, entry.id) }))
  : [];
// Washed out by the Moon (moonlight-and-the-verdict): shown whether or not anything cleared, so a shorter list on
// Tonight is never unexplained.
const washedOut = view?.ranking?.washedOutEntries ?? [];
const failure = load
  ? (load.tonightError ?? load.sitesError ?? load.telescopesError ?? (load.needsSetup ? "errors.load.setup" : null))
  : null;

const sortLinks: { value: AllObjectsSort; label: string }[] = [
  { value: "rank", label: a.byRank },
  { value: "time", label: a.byTime },
];
const segment =
  "inline-flex h-9 items-center rounded-full px-3.5 text-sm font-semibold transition-[background-color,color] duration-150 ease-out motion-reduce:transition-none outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50";
---

{load && (
  <>
    <a
      href="/tonight"
      class="mb-4 inline-flex min-h-11 items-center gap-1 text-sm text-muted-foreground transition-colors hover:text-heading"
    >
      ← {a.back}
    </a>
    <p class="mb-2 text-xs font-semibold tracking-[0.18em] text-primary uppercase">
      {view ? view.dateLabel : t.kicker}
    </p>
    <h1 class="mb-2 font-display text-3xl font-semibold text-balance text-heading sm:text-4xl">
      {rows.length > 0 ? plural(locale, rows.length, a.heading)({ count: String(rows.length) }) : a.title}
    </h1>
    {view && (
      <p class="mb-6 text-sm text-muted-foreground">
        {view.siteName} · {view.telescopeName}
      </p>
    )}

    {failure && !view ? (
      <ServerError message={translateKey(m, failure, "errors.generic")} />
    ) : rows.length === 0 ? (
      <div class="rounded-2xl border border-border bg-surface p-4 sm:p-6">
        {view && (
          <p class="mb-2 font-display text-xl text-heading">
            <span data-sky-headline={view.headline.key}>{view.headline.text}</span> — {view.verdictText}
          </p>
        )}
        <p class="text-sm text-muted-foreground">{a.empty}</p>
      </div>
    ) : (
      <>
        <div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-2">
          <nav aria-label={a.sortLabel} class="flex gap-0.5 rounded-full border border-border p-0.5">
            {sortLinks.map((link) => (
              <a
                href={`/tonight/all?sort=${link.value}`}
                aria-current={sort === link.value ? "page" : undefined}
                class:list={[
                  segment,
                  sort === link.value
                    ? "bg-selected text-selected-foreground"
                    : "text-muted-foreground hover:bg-accent hover:text-heading",
                ]}
              >
                {link.label}
              </a>
            ))}
          </nav>
          <p class="text-sm text-muted-foreground">{sort === "time" ? a.sortHintTime : a.sortHintRank}</p>
        </div>
        <ul class="grid gap-2">
          {rows.map(({ entry, href }) => (
            <ObjectRow entry={entry} logHref={href} />
          ))}
        </ul>
      </>
    )}

    {washedOut.length > 0 && (
      <section id="washed-out" aria-labelledby="washed-out-heading" class="mt-10 scroll-mt-20">
        <h2 id="washed-out-heading" class="mb-2 font-display text-2xl font-semibold text-heading">
          {t.washedOut.heading}
        </h2>
        <p class="mb-4 text-sm text-muted-foreground">{t.washedOut.intro}</p>
        <ul class="grid gap-2">
          {washedOut.map((entry) => {
            const commonName = localCommonName(entry.messier, entry.commonName, locale);
            return (
              <li
                data-washed-out-object={entry.id}
                class="flex min-h-14 items-center gap-3 rounded-xl border border-dashed border-border px-4 py-2.5"
              >
                <span class="min-w-0 flex-1">
                  <span class="font-display text-lg font-semibold text-muted-foreground">{entry.id}</span>
                  {commonName && <span class="text-sm text-muted-foreground"> · {commonName}</span>}
                  <span class="block text-xs text-muted-foreground">
                    {t.object.inConstellation({ constellation: entry.constellation })}
                  </span>
                </span>
                <span class="shrink-0 text-right font-mono text-sm text-muted-foreground">
                  {entry.bestTime}
                  <span class="block text-xs">{entry.bestDirection}</span>
                </span>
              </li>
            );
          })}
        </ul>
      </section>
    )}
  </>
)}
