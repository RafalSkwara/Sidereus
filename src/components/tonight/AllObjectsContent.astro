---
// The data-dependent part of /tonight/all (tonight-all-objects): every object that cleared tonight's bar for the
// same site and telescope as Tonight, as compact rows, by rank or by best time. A server island like
// TonightContent, loading through the same loadTonight so both pages always agree.
import { FORECAST_BASE_URL } from "astro:env/server";

import { ServerError } from "@/components/forms/ServerError";
import ObjectRow from "@/components/tonight/ObjectRow.astro";
import { getMessages, plural, translateKey } from "@/i18n";
import { kvForecastCache } from "@/lib/forecast/kv-cache";
import { sortEntries, type AllObjectsSort } from "@/lib/tonight/all-objects";
import { loadTonight, logHref } from "@/lib/tonight/load";

interface Props {
  siteId?: string;
  telescopeId?: string;
  sort: AllObjectsSort;
}

const { user, locale } = Astro.locals;
const { siteId, telescopeId, sort } = Astro.props;
// The island route sits outside PROTECTED_ROUTES, so it guards itself: signed out, it renders nothing.
const supabase = user ? Astro.locals.supabase : null;
const m = getMessages(locale);
const t = m.tonight;
const a = t.all;

const { view, tonightError, sitesError, telescopesError, needsSetup } = await loadTonight({
  supabase,
  locale,
  siteId,
  telescopeId,
  now: new Date(),
  cache: kvForecastCache(),
  forecastBaseUrl: FORECAST_BASE_URL,
  defer: (task) => {
    Astro.locals.cfContext.waitUntil(task);
  },
  limit: Number.POSITIVE_INFINITY,
});
const rows = view?.ranking
  ? sortEntries(view.ranking.entries, sort).map((entry) => ({ entry, href: logHref(view, entry.messier) }))
  : [];
const failure = tonightError ?? sitesError ?? telescopesError ?? (needsSetup ? "errors.load.setup" : null);

const sortLinks: { value: AllObjectsSort; label: string }[] = [
  { value: "rank", label: a.byRank },
  { value: "time", label: a.byTime },
];
const segment =
  "inline-flex h-9 items-center rounded-full px-3.5 text-sm font-semibold transition-[background-color,color] duration-150 ease-out motion-reduce:transition-none outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50";
---

{supabase && (
  <>
    <a
      href="/tonight"
      class="mb-4 inline-flex min-h-11 items-center gap-1 text-sm text-muted-foreground transition-colors hover:text-heading"
    >
      ← {a.back}
    </a>
    <p class="mb-2 text-xs font-semibold tracking-[0.18em] text-primary uppercase">
      {view ? view.dateLabel : t.kicker}
    </p>
    <h1 class="mb-2 font-display text-3xl font-semibold text-balance text-heading sm:text-4xl">
      {rows.length > 0 ? plural(locale, rows.length, a.heading)({ count: String(rows.length) }) : a.title}
    </h1>
    {view && (
      <p class="mb-6 text-sm text-muted-foreground">
        {view.siteName} · {view.telescopeName}
      </p>
    )}

    {failure && !view ? (
      <ServerError message={translateKey(m, failure, "errors.generic")} />
    ) : rows.length === 0 ? (
      <div class="rounded-2xl border border-border bg-surface p-4 sm:p-6">
        {view && (
          <p class="mb-2 font-display text-xl text-heading">
            {m.verdict.level[view.verdict.level]} — {view.verdictText}
          </p>
        )}
        <p class="text-sm text-muted-foreground">{a.empty}</p>
      </div>
    ) : (
      <>
        <div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-2">
          <nav aria-label={a.sortLabel} class="flex gap-0.5 rounded-full border border-border p-0.5">
            {sortLinks.map((link) => (
              <a
                href={`/tonight/all?sort=${link.value}`}
                aria-current={sort === link.value ? "page" : undefined}
                class:list={[
                  segment,
                  sort === link.value
                    ? "bg-selected text-selected-foreground"
                    : "text-muted-foreground hover:bg-accent hover:text-heading",
                ]}
              >
                {link.label}
              </a>
            ))}
          </nav>
          <p class="text-sm text-muted-foreground">{sort === "time" ? a.sortHintTime : a.sortHintRank}</p>
        </div>
        <ul class="grid gap-2">
          {rows.map(({ entry, href }) => (
            <ObjectRow entry={entry} logHref={href} />
          ))}
        </ul>
      </>
    )}
  </>
)}
