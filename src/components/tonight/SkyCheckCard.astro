---
// Tonight's sky question (verdict-check), a band under the summary (tonight-nightfall): how the sky really was on a
// recent night, against the headline Tonight showed then. The shared answer form posts to /api/log/sky/[id], which
// returns to Tonight; Skip rides in the same form. Asked for the newest open night of the last two (see
// `pendingCheck`).
import SkyAnswerForm from "@/components/sky-checks/SkyAnswerForm.astro";
import Band from "@/components/ui/Band.astro";
import { buttonVariants } from "@/components/ui/button";
import { VERDICT_TONES } from "@/components/tonight/verdict-tones";
import { getMessages, translateKey } from "@/i18n";
import { claimOf } from "@/lib/sky-checks/claim";
import { headlineLevel } from "@/lib/sky-checks/labels";
import { nightsBefore } from "@/lib/sky-checks/pending";
import { SKY_CHECKS_PAGE } from "@/lib/sky-checks/redirect";
import type { SkyCheckRecord } from "@/lib/sky-checks/store";
import { createFormatter, SKY_HEADLINE_KEYS } from "@/lib/tonight/format";

interface Props {
  check: SkyCheckRecord;
  /** Tonight's own night, `YYYY-MM-DD`: the question says "last night" for the night before it. */
  tonightDate: string;
}

const { check, tonightDate } = Astro.props;
const { locale } = Astro.locals;
const m = getMessages(locale);
const t = m.skyChecks.card;
const { formatShortNightDate } = createFormatter(locale);

const title =
  check.night === nightsBefore(tonightDate, 1)
    ? t.titleLastNight
    : t.titleOn({ date: formatShortNightDate(check.night) });
const headline = translateKey(m, SKY_HEADLINE_KEYS[check.headline], "errors.generic");

// The answer that matches what we said, outlined in the form; Skip and All are quiet links (no primary fill here,
// so the page keeps at most one primary action).
const matching = claimOf(check.headline);
const quietAction = buttonVariants({ variant: "link", size: "sm" });
---

<div data-sky-check>
  <Band headingId="sky-check-heading" heading={title}>
    <p class="mb-4 flex items-center gap-2 text-body text-foreground">
      <span
        class:list={["size-2 shrink-0 rounded-full", VERDICT_TONES[headlineLevel(check.headline)].dot]}
        aria-hidden="true"
      ></span>
      {t.weSaid({ site: check.siteName, headline })}
    </p>
    <SkyAnswerForm id={check.id} from="tonight" current={null} matching={matching} label={t.answers}>
      <div class="mt-2 flex flex-wrap items-center gap-x-2">
        <button type="submit" name="action" value="skip" class:list={[quietAction]}>
          {t.skip}
        </button>
        <a href={SKY_CHECKS_PAGE} class:list={[quietAction]}>
          {t.all}
        </a>
      </div>
      <p class="mt-1 text-label text-muted-foreground">{t.hint}</p>
    </SkyAnswerForm>
  </Band>
</div>
