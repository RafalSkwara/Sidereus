---
// The Moon's detail band (moonlight-and-the-verdict; a ruled Band since tonight-nightfall): the phase, the disc and a time slider across tonight's
// window (the `MoonTimeSlider` island, which the server renders at the page-load moment), with when the Moon is up and
// what it does to faint objects beside the disc, then, when the Moon is a target tonight (it passes the planets'
// gate), its observing details with the shared TargetDetails layout. Without a civil window (high-latitude summer)
// there are no states: only the phase shows, from local noon. The lines beside the disc are icon-led facts in one
// FactList (ui-fact-rhythm): the island's children sit in a box-less `<astro-slot>`, so the slider's own spacing never
// reaches them and the list carries it. Fact components stay server-side: the island only receives their markup.
import { ArrowRight } from "lucide-react";

import MoonTimeSlider from "@/components/tonight/MoonTimeSlider";
import NotSeenMark from "@/components/tonight/NotSeenMark.astro";
import NotSeenTip from "@/components/tonight/NotSeenTip.astro";
import SeenTag from "@/components/tonight/SeenTag.astro";
import TargetDetails from "@/components/tonight/TargetDetails.astro";
import Band from "@/components/ui/Band.astro";
import Fact from "@/components/ui/Fact.astro";
import FactList from "@/components/ui/FactList.astro";
import { buttonVariants } from "@/components/ui/button";
import { getMessages } from "@/i18n";
import type { TonightMoonCard } from "@/lib/tonight/build";

interface Props {
  card: TonightMoonCard;
  /** The log form for the Moon, prefilled with tonight's night, site and telescope (FR-016); used with `card.target`. */
  logHref: string;
  /**
   * The way to the objects tonight's Moon washes out, listed on Targets (`/tonight/targets#washed-out`), under the
   * faint-objects line; left out when it washes out none.
   */
  washedOut?: { href: string; label: string } | null;
}

const { card, logHref, washedOut = null } = Astro.props;
const locale = Astro.locals.locale;
const t = getMessages(locale).tonight;
const target = card.target;
// A quiet text action that wraps, so the long Polish label stays inside the column.
const washedOutLink = buttonVariants({ variant: "quiet", size: "bare" });
---

{/* The heading names the band; the phase line under it follows the slider, so it is not the heading. */}
<Band id="moon" headingId="moon-heading" heading={t.moon.card.kicker} headingHidden>
  {card.states.length > 0 ? (
    <MoonTimeSlider
      states={card.states}
      timeLabels={card.timeLabels}
      initialIndex={card.initialIndex}
      locale={locale}
      client:load
    >
      <div class="space-y-line">
        <FactList>
          {card.upText && (
            <Fact kind="when">
              <span class="font-semibold text-heading">{card.upText}</span>
            </Fact>
          )}
          {card.faintText && (
            <Fact kind="moon">
              <p>{card.faintText}</p>
            </Fact>
          )}
        </FactList>
        {washedOut && (
          <a href={washedOut.href} class:list={[washedOutLink]}>
            {washedOut.label}
            <ArrowRight aria-hidden="true" />
          </a>
        )}
      </div>
    </MoonTimeSlider>
  ) : (
    <p class="text-body font-semibold text-heading">{card.phaseText}</p>
  )}

  {target && (
    <div class="relative mt-item border-t border-border pt-item" data-not-seen-scope>
      {/* The Moon shows no visible name, so the mark takes the seen tag's place: the two never show together. */}
      {target.seenText ? (
        <SeenTag text={target.seenText} />
      ) : (
        target.notSeenYet && (
          <>
            <p class="mt-line">
              <NotSeenMark variant="tip" id="not-seen-tip-moon" />
            </p>
            <NotSeenTip id="not-seen-tip-moon" />
          </>
        )
      )}

      <TargetDetails
        windowStart={target.windowStart}
        windowEnd={target.windowEnd}
        bestTime={target.bestTime}
        bestDirection={target.bestDirection}
        logHref={logHref}
        ariaLabel={t.moon.markObserved({ name: target.name })}
      >
        <Fact kind="see" iconClass="text-primary-strong">
          <p>{target.note}</p>
        </Fact>
        {target.wholeDisc && (
          <Fact kind="eyepiece">
            <p>
              {target.wholeDiscFits ? (
                <>
                  {t.moon.wholeDiscWith} <span class="font-semibold text-heading">{target.wholeDisc.name}</span>{" "}
                  {t.object.magnification({ magnification: String(target.wholeDisc.magnification) })}
                </>
              ) : (
                t.moon.partDisc({ name: target.wholeDisc.name })
              )}
            </p>
            {target.detail && (
              /* The message reads on after the whole-disc part in lower case: its own line starts with a capital. */
              <p class="first-letter:uppercase">
                {t.moon.detailWith} <span class="font-semibold text-heading">{target.detail.name}</span>{" "}
                {t.object.magnification({ magnification: String(target.detail.magnification) })}
              </p>
            )}
          </Fact>
        )}
        <Fact kind="why" tone="muted">
          <p>{target.reason}</p>
        </Fact>
      </TargetDetails>
    </div>
  )}
</Band>
