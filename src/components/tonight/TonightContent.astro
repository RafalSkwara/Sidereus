---
// The data-dependent part of /tonight, rendered as a server island (`server:defer` in pages/tonight.astro) so the
// page shell paints before Supabase, KV and Open-Meteo answer; TonightSkeleton stands in until it arrives. Since
// tonight-dashboard it is the dashboard: the sky, then tiles that open the focused pages under /tonight/*, the sky
// check, the gear and the setup prompts (the tiles include the Session plan, loaded with `withSessionPlan`). The
// detail lives on those pages; only this island records the sky verdict.
import { ServerError } from "@/components/forms/ServerError";
import Band from "@/components/ui/Band.astro";
import Notice from "@/components/ui/Notice.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { buttonVariants } from "@/components/ui/button";
import EyepiecesPrompt from "@/components/tonight/EyepiecesPrompt.astro";
import GearSelector from "@/components/tonight/GearSelector.astro";
import OfflineCopy from "@/components/tonight/OfflineCopy.astro";
import SkyCheckCard from "@/components/tonight/SkyCheckCard.astro";
import TonightSky from "@/components/tonight/TonightSky.astro";
import TonightSkyView from "@/components/tonight/TonightSkyView";
import TonightTiles from "@/components/tonight/TonightTiles.astro";
import VerdictCard from "@/components/tonight/VerdictCard.astro";
import { getMessages, translateKey, type MessageKey } from "@/i18n";
import { pendingCheck } from "@/lib/sky-checks/pending";
import { recordableVerdict } from "@/lib/sky-checks/record";
import { skyCheckStore } from "@/lib/sky-checks/store";
import { islandDefer, loadTonightFor } from "@/lib/tonight/island";
import type { TonightLoad } from "@/lib/tonight/load";
import type { TonightNotice } from "@/lib/tonight/notice";

interface Props {
  /** The site picked on the page (`?site=` or the remembered cookie); resolved against the user's own. */
  siteId?: string;
  /** The telescope picked on the page (`?telescope=` or the remembered cookie); resolved against the user's own. */
  telescopeId?: string;
  /**
   * The page's notice, resolved in the shell from `?logged`, `?skyChecked` or `?error` to catalogue text (the
   * island's own Astro.url carries no page query). Shown under the sky; `null` when there is none.
   */
  notice?: TonightNotice | null;
  /**
   * `"next"` renders the evening after tonight (`?night=next`, the service worker's background copy for offline use):
   * it neither records the sky verdict nor asks the sky question, and loads no open sky checks.
   */
  night?: "tonight" | "next";
}

const { locale } = Astro.locals;
const { siteId, telescopeId, notice = null, night = "tonight" } = Astro.props;
const m = getMessages(locale);
const t = m.tonight;
const translate = (key: MessageKey | null) => (key ? translateKey(m, key, "errors.generic") : null);

// Signed out, the island loads nothing (`null`) and renders nothing; the empty load only keeps the names below typed.
const NOTHING_LOADED: TonightLoad = {
  sites: [],
  telescopes: [],
  eyepieces: [],
  sitesError: null,
  telescopesError: null,
  eyepiecesError: null,
  logError: null,
  site: undefined,
  telescope: undefined,
  multipleSites: false,
  multipleTelescopes: false,
  needsSetup: false,
  view: null,
  tonightError: null,
  openSkyChecks: [],
};
const load = await loadTonightFor(Astro.locals, {
  siteId,
  telescopeId,
  withSkyChecks: true,
  night,
  withSkyView: true,
  withSessionPlan: true,
});
const supabase = load ? Astro.locals.supabase : null;
const {
  sites,
  telescopes,
  sitesError,
  telescopesError,
  eyepiecesError,
  logError,
  site,
  telescope,
  multipleSites,
  multipleTelescopes,
  needsSetup,
  view,
  tonightError,
  openSkyChecks,
} = load ?? NOTHING_LOADED;

// Record the headline this view shows for the sky check (verdict-check). Fire and forget: it runs after the
// response, and a failure is swallowed (never logged, never shown) so the check can never cost Tonight its render.
const recordable = supabase && night === "tonight" ? recordableVerdict(view) : null;
if (supabase && recordable) {
  islandDefer(Astro.locals)(
    skyCheckStore.record(supabase, recordable).then(
      () => undefined,
      () => undefined,
    ),
  );
}
// The sky question for a recent night at the shown site (verdict-check); `null` when there is nothing to ask.
const skyCheck = night === "tonight" && site && view ? pendingCheck(openSkyChecks, site.id, view.date) : null;
// No eyepieces in the kit: the dashboard says how to add them, with the other setup prompts (the pages show only the
// eyepiece-load error). The log-load error shows here too, since "Point here first" depends on the log.
const noEyepieces = view !== null && !view.hasEyepieces && !eyepiecesError;
const showNotices = view !== null && (noEyepieces || logError !== null);
// The line under the title names only what no selector already shows; with both selectors it is omitted.
const gearLine = [multipleSites ? null : site?.name, multipleTelescopes ? null : telescope?.name]
  .filter((name): name is string => Boolean(name))
  .join(" · ");
// The setup and add prompts, each a band with one link-button; when both add prompts show, adding a site leads.
const addSite = !needsSetup && !sitesError && !site;
const addTelescope = !needsSetup && !telescopesError && !telescope;
const showPrompts = needsSetup || addSite || addTelescope;
// The gear line's link to /gear: 44 px, with the ring focus.
const gearLink =
  "inline-flex min-h-11 items-center rounded-lg text-label text-muted-foreground transition-colors hover:text-heading focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring";
---

{load && (
  <>
    {/* The live sky (interactive-sky): the island owns the band, with the verdict passed in as static children. */}
    {view?.skyView ? (
      <TonightSkyView view={view.skyView} locale={locale} client:load>
        <h1 class="sr-only">{t.title}</h1>
        <VerdictCard
          level={view.verdict.level}
          dateLabel={view.dateLabel}
          headline={view.headline}
          text={view.verdictText}
          darkWindow={view.darkWindow}
          timeZone={view.timeZone}
          forecastStatus={view.forecastStatus}
          explanation={view.explanation}
        />
      </TonightSkyView>
    ) : (
      <TonightSky night verdict={view !== null}>
        {view ? (
          <>
            <h1 class="sr-only">{t.title}</h1>
            <VerdictCard
              level={view.verdict.level}
              dateLabel={view.dateLabel}
              headline={view.headline}
              text={view.verdictText}
              darkWindow={view.darkWindow}
              timeZone={view.timeZone}
              forecastStatus={view.forecastStatus}
              explanation={view.explanation}
            />
          </>
        ) : (
          <PageHeader title={t.title} />
        )}
      </TonightSky>
    )}

    {view && <OfflineCopy view={view} night={night} />}

    <div class="mx-auto w-full max-w-3xl pt-8">
      {notice && (
        <div class="mb-6 px-4">
          {notice.tone === "success" ? (
            <Notice tone="success">{notice.text}</Notice>
          ) : (
            <div role="alert">
              <ServerError message={notice.text} />
            </div>
          )}
        </div>
      )}

      {/* The tiles run the container's full width, so their rules and hover reach the phone's edges. */}
      {view && <TonightTiles view={view} />}

      <div class:list={["space-y-6 px-4", view && "pt-8"]}>
        {view && skyCheck && <SkyCheckCard check={skyCheck} tonightDate={view.date} />}

        {site && telescope && (gearLine || multipleSites || multipleTelescopes) && (
          <div>
            {gearLine && (
              <p class="mb-6">
                <a href="/gear" class:list={[gearLink]}>
                  {gearLine}
                </a>
              </p>
            )}
            {multipleSites && (
              <GearSelector
                items={sites.map(({ id, name }) => ({ id, name }))}
                activeId={site.id}
                param="site"
                label={t.siteSelector.label}
                show={t.siteSelector.show}
              />
            )}
            {multipleTelescopes && (
              <GearSelector
                items={telescopes.map(({ id, name }) => ({ id, name }))}
                activeId={telescope.id}
                param="telescope"
                label={t.selector.label}
                show={t.selector.show}
              />
            )}
          </div>
        )}

        {sitesError && <ServerError message={translate(sitesError)} />}
        {telescopesError && <ServerError message={translate(telescopesError)} />}

        {showPrompts && (
          <div>
            {needsSetup && (
              <Band headingId="setup-heading" heading={t.setupPrompt}>
                <a href="/onboarding" class:list={[buttonVariants()]}>
                  {t.setup}
                </a>
              </Band>
            )}
            {addSite && (
              <Band headingId="add-site-heading" heading={t.addSitePrompt}>
                <a href="/gear/sites/new" class:list={[buttonVariants()]}>
                  {t.addSite}
                </a>
              </Band>
            )}
            {addTelescope && (
              <Band headingId="add-telescope-heading" heading={t.addTelescopePrompt}>
                <a
                  href="/gear/telescopes/new"
                  class:list={[buttonVariants({ variant: addSite ? "outline" : "default" })]}
                >
                  {t.addTelescope}
                </a>
              </Band>
            )}
          </div>
        )}

        {tonightError && <ServerError message={translate(tonightError)} />}

        {showNotices && (
          <div class="space-y-4">
            {noEyepieces && <EyepiecesPrompt />}
            {logError && <ServerError message={translate(logError)} />}
          </div>
        )}
      </div>
    </div>
  </>
)}
