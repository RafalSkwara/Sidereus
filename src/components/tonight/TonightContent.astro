---
// The data-dependent part of /tonight, rendered as a server island (`server:defer` in pages/tonight.astro) so the
// page shell paints before Supabase, KV and Open-Meteo answer; TonightSkeleton stands in until it arrives.
import { ServerError } from "@/components/forms/ServerError";
import Band from "@/components/ui/Band.astro";
import Notice from "@/components/ui/Notice.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { buttonVariants } from "@/components/ui/button";
import NightStrip from "@/components/tonight/NightStrip.astro";
import GearSelector from "@/components/tonight/GearSelector.astro";
import MoonCard from "@/components/tonight/MoonCard.astro";
import ObjectCard from "@/components/tonight/ObjectCard.astro";
import SkyCheckCard from "@/components/tonight/SkyCheckCard.astro";
import SolarSystemSection from "@/components/tonight/SolarSystemSection.astro";
import TonightSky from "@/components/tonight/TonightSky.astro";
import TonightSummary from "@/components/tonight/TonightSummary.astro";
import VerdictCard from "@/components/tonight/VerdictCard.astro";
import { getMessages, plural, translateKey, type MessageKey } from "@/i18n";
import { cn } from "@/lib/utils";
import { pendingCheck } from "@/lib/sky-checks/pending";
import { recordableVerdict } from "@/lib/sky-checks/record";
import { skyCheckStore } from "@/lib/sky-checks/store";
import { MOON_TARGET_KEY } from "@/lib/targets";
import { islandDefer, loadTonightFor } from "@/lib/tonight/island";
import { logHref, type TonightLoad } from "@/lib/tonight/load";
import type { TonightNotice } from "@/lib/tonight/notice";

interface Props {
  /** The site picked on the page (`?site=` or the remembered cookie); resolved against the user's own. */
  siteId?: string;
  /** The telescope picked on the page (`?telescope=` or the remembered cookie); resolved against the user's own. */
  telescopeId?: string;
  /**
   * The page's notice, resolved in the shell from `?logged`, `?skyChecked` or `?error` to catalogue text (the
   * island's own Astro.url carries no page query). Shown under the sky; `null` when there is none.
   */
  notice?: TonightNotice | null;
}

const { locale } = Astro.locals;
const { siteId, telescopeId, notice = null } = Astro.props;
const m = getMessages(locale);
const t = m.tonight;
const translate = (key: MessageKey | null) => (key ? translateKey(m, key, "errors.generic") : null);

// Signed out, the island loads nothing (`null`) and renders nothing; the empty load only keeps the names below typed.
const NOTHING_LOADED: TonightLoad = {
  sites: [],
  telescopes: [],
  eyepieces: [],
  sitesError: null,
  telescopesError: null,
  eyepiecesError: null,
  logError: null,
  site: undefined,
  telescope: undefined,
  multipleSites: false,
  multipleTelescopes: false,
  needsSetup: false,
  view: null,
  tonightError: null,
  openSkyChecks: [],
};
const load = await loadTonightFor(Astro.locals, { siteId, telescopeId, withSkyChecks: true });
const supabase = load ? Astro.locals.supabase : null;
const {
  sites,
  telescopes,
  sitesError,
  telescopesError,
  eyepiecesError,
  logError,
  site,
  telescope,
  multipleSites,
  multipleTelescopes,
  needsSetup,
  view,
  tonightError,
  openSkyChecks,
} = load ?? NOTHING_LOADED;

// Record the headline this view shows for the sky check (verdict-check). Fire and forget: it runs after the
// response, and a failure is swallowed (never logged, never shown) so the check can never cost Tonight its render.
const recordable = supabase ? recordableVerdict(view) : null;
if (supabase && recordable) {
  islandDefer(Astro.locals)(
    skyCheckStore.record(supabase, recordable).then(
      () => undefined,
      () => undefined,
    ),
  );
}
// The sky question for a recent night at the shown site (verdict-check); `null` when there is nothing to ask.
const skyCheck = site && view ? pendingCheck(openSkyChecks, site.id, view.date) : null;
// The line under the title names only what no selector already shows; with both selectors it is omitted.
// More objects cleared the bar than Tonight lists: link to the Targets page (tonight-dashboard).
const hasMore = view?.ranking ? view.ranking.clearedCount > view.ranking.entries.length : false;
// The log, eyepiece and no-eyepieces notices speak for the Moon target, the planets and the ranking alike, so they
// show once, below the cards and above the sections, whenever any of them is shown.
const noEyepieces = view !== null && !view.hasEyepieces && !eyepiecesError;
const showSections =
  view !== null && (view.moonCard?.target != null || view.solarSystem !== null || view.ranking !== null);
const showNotices = showSections && (eyepiecesError !== null || noEyepieces || logError !== null);
const gearLine = [multipleSites ? null : site?.name, multipleTelescopes ? null : telescope?.name]
  .filter((name): name is string => Boolean(name))
  .join(" · ");
// The setup and add prompts, each a band with one link-button; when both add prompts show, adding a site leads.
const addSite = !needsSetup && !sitesError && !site;
const addTelescope = !needsSetup && !telescopesError && !telescope;
const showPrompts = needsSetup || addSite || addTelescope;
// The quiet links (the gear line, "See all", the washed-out and add-eyepieces links): the link style at 44 px, with
// the ring focus; they may wrap. The ranking's "See all N" is the band's one outline button.
const linkButton = buttonVariants({ variant: "link", size: "sm" });
const quietLink = cn(linkButton, "-ml-3 whitespace-normal");
const inlineLink = cn(linkButton, "px-0 whitespace-normal");
// On a phone the long ranking heading wraps the action under it (left edge); from sm it sits on the right.
const actionLink = cn(linkButton, "-ml-3 sm:ml-0 sm:-mr-3");
const gearLink =
  "inline-flex min-h-11 items-center rounded-lg text-label text-muted-foreground transition-colors hover:text-heading focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring";
---

{load && (
  <>
    <TonightSky verdict={view !== null}>
      {view ? (
        <>
          <h1 class="sr-only">{t.title}</h1>
          <VerdictCard
            level={view.verdict.level}
            dateLabel={view.dateLabel}
            headline={view.headline}
            text={view.verdictText}
            darkWindow={view.darkWindow}
            timeZone={view.timeZone}
            forecastStatus={view.forecastStatus}
            explanation={view.explanation}
          />
        </>
      ) : (
        <PageHeader title={t.title} />
      )}
    </TonightSky>

    <div class="mx-auto w-full max-w-3xl pt-8">
      {notice && (
        <div class="mb-6 px-4">
          {notice.tone === "success" ? (
            <Notice tone="success">{notice.text}</Notice>
          ) : (
            <div role="alert">
              <ServerError message={notice.text} />
            </div>
          )}
        </div>
      )}

      {/* The summary bands run the container's full width, so their rules and hover reach the phone's edges. */}
      {view && <TonightSummary view={view} />}

      <div class:list={["space-y-6 px-4", view && "pt-8"]}>
        {view && skyCheck && <SkyCheckCard check={skyCheck} tonightDate={view.date} />}

        {site && telescope && (gearLine || multipleSites || multipleTelescopes) && (
          <div>
            {gearLine && (
              <p class="mb-6">
                <a href="/gear" class:list={[gearLink]}>
                  {gearLine}
                </a>
              </p>
            )}
            {multipleSites && (
              <GearSelector
                items={sites.map(({ id, name }) => ({ id, name }))}
                activeId={site.id}
                param="site"
                label={t.siteSelector.label}
                show={t.siteSelector.show}
              />
            )}
            {multipleTelescopes && (
              <GearSelector
                items={telescopes.map(({ id, name }) => ({ id, name }))}
                activeId={telescope.id}
                param="telescope"
                label={t.selector.label}
                show={t.selector.show}
              />
            )}
          </div>
        )}

        {sitesError && <ServerError message={translate(sitesError)} />}
        {telescopesError && <ServerError message={translate(telescopesError)} />}

        {showPrompts && (
          <div>
            {needsSetup && (
              <Band headingId="setup-heading" heading={t.setupPrompt}>
                <a href="/onboarding" class:list={[buttonVariants()]}>
                  {t.setup}
                </a>
              </Band>
            )}
            {addSite && (
              <Band headingId="add-site-heading" heading={t.addSitePrompt}>
                <a href="/gear/sites/new" class:list={[buttonVariants()]}>
                  {t.addSite}
                </a>
              </Band>
            )}
            {addTelescope && (
              <Band headingId="add-telescope-heading" heading={t.addTelescopePrompt}>
                <a
                  href="/gear/telescopes/new"
                  class:list={[buttonVariants({ variant: addSite ? "outline" : "default" })]}
                >
                  {t.addTelescope}
                </a>
              </Band>
            )}
          </div>
        )}

        {tonightError && <ServerError message={translate(tonightError)} />}

        {view && (
          /* The detail bands, ruled like the summary above; the summary's chevrons jump to their ids. */
          <div>
            {view.moonCard && <MoonCard card={view.moonCard} logHref={logHref(view, MOON_TARGET_KEY)} />}

            {showNotices && (
              <div class="space-y-4 pb-8">
                {eyepiecesError && <ServerError message={translate(eyepiecesError)} />}
                {noEyepieces && (
                  <p class="text-label text-muted-foreground">
                    {t.noEyepiecesPrompt}{" "}
                    <a href="/gear/eyepieces/new" class:list={[inlineLink]}>
                      {t.addEyepieces}
                    </a>
                  </p>
                )}
                {logError && <ServerError message={translate(logError)} />}
              </div>
            )}

            {view.solarSystem && (
              <SolarSystemSection solarSystem={view.solarSystem} logHref={(key: string) => logHref(view, key)} />
            )}

            {view.ranking && (
              <Band id="ranking" headingId="ranking-heading" heading={view.ranking.clearedText}>
                {hasMore && (
                  <a slot="action" href="/tonight/targets" class:list={[actionLink]}>
                    {t.all.seeAll}
                    <span aria-hidden="true">→</span>
                  </a>
                )}
                {multipleTelescopes && (
                  <p class="mb-4 text-label text-muted-foreground">{t.rankingFor({ telescope: view.telescopeName })}</p>
                )}
                {view.ranking.washedOutText && (
                  <p class="mb-4">
                    <a
                      href="/tonight/targets#washed-out"
                      data-washed-out={view.ranking.washedOutCount}
                      class:list={[quietLink]}
                    >
                      {view.ranking.washedOutText}
                      <span aria-hidden="true">→</span>
                    </a>
                  </p>
                )}
                {view.ranking.entries.length > 0 && (
                  <ol class="divide-y divide-border">
                    {view.ranking.entries.map((entry, i) => (
                      <ObjectCard entry={entry} rank={i + 1} logHref={logHref(view, entry.id)} />
                    ))}
                  </ol>
                )}
                {hasMore && (
                  <a href="/tonight/targets" class:list={[buttonVariants({ variant: "outline" }), "mt-6 w-full"]}>
                    {plural(
                      locale,
                      view.ranking.clearedCount,
                      t.all.seeAllCount,
                    )({
                      count: String(view.ranking.clearedCount),
                    })}
                    <span aria-hidden="true">→</span>
                  </a>
                )}
              </Band>
            )}

            <NightStrip siteName={view.siteName} timeZone={view.timeZone} nights={view.nights} />
          </div>
        )}
      </div>
    </div>
  </>
)}
