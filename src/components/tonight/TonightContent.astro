---
// The data-dependent part of /tonight, rendered as a server island (`server:defer` in pages/tonight.astro) so the
// page shell paints before Supabase, KV and Open-Meteo answer; TonightSkeleton stands in until it arrives.
import { FORECAST_BASE_URL } from "astro:env/server";

import { ServerError } from "@/components/forms/ServerError";
import NightStrip from "@/components/tonight/NightStrip.astro";
import GearSelector from "@/components/tonight/GearSelector.astro";
import ObjectCard from "@/components/tonight/ObjectCard.astro";
import VerdictCard from "@/components/tonight/VerdictCard.astro";
import { getMessages, translateKey, type MessageKey } from "@/i18n";
import { kvForecastCache } from "@/lib/forecast/kv-cache";
import { getForecast } from "@/lib/forecast/service";
import {
  eyepieceStore,
  siteStore,
  telescopeStore,
  type EyepieceRecord,
  type SiteRecord,
  type TelescopeRecord,
} from "@/lib/gear/store";
import type { LogEntry } from "@/lib/engine";
import { observationStore } from "@/lib/observations/store";
import { buildTonight, type TonightView } from "@/lib/tonight/build";
import { chooseOwned, selectorKind } from "@/lib/tonight/gear-choice";

interface Props {
  /** The site picked on the page (`?site=` or the remembered cookie); resolved against the user's own. */
  siteId?: string;
  /** The telescope picked on the page (`?telescope=` or the remembered cookie); resolved against the user's own. */
  telescopeId?: string;
}

// Fixed, value-free message keys: nothing about the site (coordinates included) ever reaches the page or a log.
const SITES_FAILED: MessageKey = "errors.load.sites";
const TELESCOPES_FAILED: MessageKey = "errors.load.telescopes";
const EYEPIECES_FAILED: MessageKey = "tonight.eyepiecesFailed";
const LOG_FAILED: MessageKey = "tonight.logFailed";
const TONIGHT_FAILED: MessageKey = "tonight.failed";

const { user, locale } = Astro.locals;
const { siteId, telescopeId } = Astro.props;
// The island route (/_server-islands/...) sits outside PROTECTED_ROUTES, so it guards itself: signed out, it
// renders nothing and loads nothing.
const supabase = user ? Astro.locals.supabase : null;
const m = getMessages(locale);
const t = m.tonight;
const translate = (key: MessageKey | null) => (key ? translateKey(m, key, "errors.generic") : null);

/** Loads one list; a failure only affects what depends on it, never the whole page. */
async function load<T>(
  list: () => Promise<T[]>,
  failed: MessageKey,
): Promise<{ items: T[]; error: MessageKey | null }> {
  try {
    return { items: await list(), error: null };
  } catch {
    return { items: [], error: failed };
  }
}

let sites: SiteRecord[] = [];
let telescopes: TelescopeRecord[] = [];
let eyepieces: EyepieceRecord[] = [];
let sitesError: MessageKey | null = null;
let telescopesError: MessageKey | null = null;
let eyepiecesError: MessageKey | null = null;
// A log that fails to load ranks as an empty one, with a notice (never an error page).
let log: LogEntry[] = [];
let logError: MessageKey | null = null;
let view: TonightView | null = null;
let tonightError: MessageKey | null = null;

if (supabase) {
  const [siteResult, telescopeResult, eyepieceResult, logResult] = await Promise.all([
    load(() => siteStore.list(supabase), SITES_FAILED),
    load(() => telescopeStore.list(supabase), TELESCOPES_FAILED),
    load(() => eyepieceStore.list(supabase), EYEPIECES_FAILED),
    load(() => observationStore.listForRanking(supabase), LOG_FAILED),
  ]);
  ({ items: sites, error: sitesError } = siteResult);
  ({ items: telescopes, error: telescopesError } = telescopeResult);
  ({ items: eyepieces, error: eyepiecesError } = eyepieceResult);
  ({ items: log, error: logError } = logResult);
}

// The site and the telescope are the ones picked on the page when the user owns them, else the oldest (FR-012,
// FR-019); both lists are in `created_at` order. The forecast, the verdict, the ranking, the strip and the log
// prefill all follow the chosen site.
const site = chooseOwned(sites, siteId);
const telescope = chooseOwned(telescopes, telescopeId);
// FR-012 / FR-019: a selector, and naming the telescope on the ranking, only matter with two or more.
const multipleSites = selectorKind(sites.length) !== "none";
const multipleTelescopes = selectorKind(telescopes.length) !== "none";
// The line under the title names only what no selector already shows; with both selectors it is omitted.
const gearLine = [multipleSites ? null : site?.name, multipleTelescopes ? null : telescope?.name]
  .filter((name): name is string => Boolean(name))
  .join(" · ");
// No site and no telescope (e.g. onboarding abandoned): one route back to setup instead of two cards (FR-021
// single-item empty states stay as they are).
const needsSetup = supabase !== null && !sitesError && !telescopesError && !site && !telescope;

if (site && telescope) {
  const now = new Date();
  try {
    // getForecast never throws: an outage with nothing cached yields null, and the verdict turns marginal;
    // a saved copy served in an outage comes back flagged `fallback`, and buildTonight caps it at marginal.
    const result = await getForecast({
      fetchFn: globalThis.fetch.bind(globalThis),
      cache: kvForecastCache(),
      siteId: site.id,
      coords: { latitudeDeg: site.latitudeDeg, longitudeDeg: site.longitudeDeg },
      now,
      ...(FORECAST_BASE_URL ? { baseUrl: FORECAST_BASE_URL } : {}),
      // The KV write runs after the response is sent.
      defer: (task) => {
        Astro.locals.cfContext.waitUntil(task);
      },
    });
    view = buildTonight({ site, telescope, eyepieces, forecast: result, now, log }, locale);
  } catch {
    tonightError = TONIGHT_FAILED;
  }
}

/** The log form for one ranked object, prefilled with the ranking's night, site and telescope (FR-016). */
function logHref(tonight: TonightView, messier: number): string {
  const query = new URLSearchParams({
    object: String(messier),
    night: tonight.date,
    site: tonight.siteId,
    telescope: tonight.telescopeId,
  });
  return `/log/new?${query.toString()}`;
}

const primaryLink =
  "inline-flex items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90";
const promptCard = "rounded-2xl border border-border bg-surface p-4 sm:p-6";
---

{supabase && (
  <>
    <p class="mb-2 text-xs font-semibold tracking-[0.18em] text-primary uppercase">
      {view ? view.dateLabel : t.kicker}
    </p>
    <h1 class="mb-2 font-display text-4xl font-semibold text-heading sm:text-5xl">{t.title}</h1>
    {site && telescope && gearLine && (
      <p class="mb-6 text-sm text-muted-foreground">
        <a href="/gear" class="transition-colors hover:text-heading">
          {gearLine}
        </a>
      </p>
    )}
    {site && telescope && multipleSites && (
      <GearSelector
        items={sites.map(({ id, name }) => ({ id, name }))}
        activeId={site.id}
        param="site"
        label={t.siteSelector.label}
        show={t.siteSelector.show}
      />
    )}
    {site && telescope && multipleTelescopes && (
      <GearSelector
        items={telescopes.map(({ id, name }) => ({ id, name }))}
        activeId={telescope.id}
        param="telescope"
        label={t.selector.label}
        show={t.selector.show}
      />
    )}

    <div class="mt-6 space-y-6">
      {sitesError && <ServerError message={translate(sitesError)} />}
      {telescopesError && <ServerError message={translate(telescopesError)} />}

      {needsSetup && (
        <div class:list={[promptCard]}>
          <p class="mb-4 text-foreground">{t.setupPrompt}</p>
          <a href="/onboarding" class:list={[primaryLink]}>
            {t.setup}
          </a>
        </div>
      )}
      {!needsSetup && !sitesError && !site && (
        <div class:list={[promptCard]}>
          <p class="mb-4 text-foreground">{t.addSitePrompt}</p>
          <a href="/gear/sites/new" class:list={[primaryLink]}>
            {t.addSite}
          </a>
        </div>
      )}
      {!needsSetup && !telescopesError && !telescope && (
        <div class:list={[promptCard]}>
          <p class="mb-4 text-foreground">{t.addTelescopePrompt}</p>
          <a href="/gear/telescopes/new" class:list={[primaryLink]}>
            {t.addTelescope}
          </a>
        </div>
      )}

      {tonightError && <ServerError message={translate(tonightError)} />}

      {view && (
        <>
          <VerdictCard
            level={view.verdict.level}
            text={view.verdictText}
            darkWindow={view.darkWindow}
            timeZone={view.timeZone}
            forecastStatus={view.forecastStatus}
            explanation={view.explanation}
            nightsLink={view.ranking !== null}
          />

          {view.ranking && (
            <section aria-labelledby="ranking-heading">
              <h2
                id="ranking-heading"
                class:list={["font-display text-2xl font-semibold text-heading", multipleTelescopes ? "mb-1" : "mb-4"]}
              >
                {view.ranking.clearedText}
              </h2>
              {multipleTelescopes && (
                <p class="mb-4 text-sm text-muted-foreground">{t.rankingFor({ telescope: view.telescopeName })}</p>
              )}
              {eyepiecesError && (
                <div class="mb-4">
                  <ServerError message={translate(eyepiecesError)} />
                </div>
              )}
              {!view.hasEyepieces && !eyepiecesError && (
                <p class="mb-4 text-sm text-muted-foreground">
                  {t.noEyepiecesPrompt}{" "}
                  <a
                    href="/gear/eyepieces/new"
                    class="font-medium text-primary-strong underline-offset-4 transition-colors hover:underline"
                  >
                    {t.addEyepieces}
                  </a>
                </p>
              )}
              {logError && (
                <div class="mb-4">
                  <ServerError message={translate(logError)} />
                </div>
              )}
              {view.ranking.entries.length > 0 && (
                <ol class="space-y-4">
                  {view.ranking.entries.map((entry, i) => (
                    <ObjectCard entry={entry} rank={i + 1} logHref={logHref(view, entry.messier)} />
                  ))}
                </ol>
              )}
            </section>
          )}

          <NightStrip siteName={view.siteName} timeZone={view.timeZone} nights={view.nights} />
        </>
      )}
    </div>
  </>
)}
