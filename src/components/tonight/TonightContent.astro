---
// The data-dependent part of /tonight, rendered as a server island (`server:defer` in pages/tonight.astro) so the
// page shell paints before Supabase, KV and Open-Meteo answer; TonightSkeleton stands in until it arrives.
import { FORECAST_BASE_URL } from "astro:env/server";

import { ServerError } from "@/components/forms/ServerError";
import NightStrip from "@/components/tonight/NightStrip.astro";
import GearSelector from "@/components/tonight/GearSelector.astro";
import MoonCard from "@/components/tonight/MoonCard.astro";
import ObjectCard from "@/components/tonight/ObjectCard.astro";
import SolarSystemSection from "@/components/tonight/SolarSystemSection.astro";
import VerdictCard from "@/components/tonight/VerdictCard.astro";
import { getMessages, plural, translateKey, type MessageKey } from "@/i18n";
import { kvForecastCache } from "@/lib/forecast/kv-cache";
import { MOON_TARGET_KEY } from "@/lib/targets";
import { loadTonight, logHref } from "@/lib/tonight/load";

interface Props {
  /** The site picked on the page (`?site=` or the remembered cookie); resolved against the user's own. */
  siteId?: string;
  /** The telescope picked on the page (`?telescope=` or the remembered cookie); resolved against the user's own. */
  telescopeId?: string;
}

const { user, locale } = Astro.locals;
const { siteId, telescopeId } = Astro.props;
// The island route (/_server-islands/...) sits outside PROTECTED_ROUTES, so it guards itself: signed out, it
// renders nothing and loads nothing.
const supabase = user ? Astro.locals.supabase : null;
const m = getMessages(locale);
const t = m.tonight;
const translate = (key: MessageKey | null) => (key ? translateKey(m, key, "errors.generic") : null);

const {
  sites,
  telescopes,
  sitesError,
  telescopesError,
  eyepiecesError,
  logError,
  site,
  telescope,
  multipleSites,
  multipleTelescopes,
  needsSetup,
  view,
  tonightError,
} = await loadTonight({
  supabase,
  locale,
  siteId,
  telescopeId,
  now: new Date(),
  cache: kvForecastCache(),
  forecastBaseUrl: FORECAST_BASE_URL,
  // The KV write runs after the response is sent.
  defer: (task) => {
    Astro.locals.cfContext.waitUntil(task);
  },
});
// The line under the title names only what no selector already shows; with both selectors it is omitted.
// More objects cleared the bar than Tonight lists: link to the all-objects page (tonight-all-objects).
const hasMore = view?.ranking ? view.ranking.clearedCount > view.ranking.entries.length : false;
// The log, eyepiece and no-eyepieces notices speak for the Moon target, the planets and the ranking alike, so they
// show once, below the cards and above the sections, whenever any of them is shown.
const noEyepieces = view !== null && !view.hasEyepieces && !eyepiecesError;
const showSections =
  view !== null && (view.moonCard?.target != null || view.solarSystem !== null || view.ranking !== null);
const showNotices = showSections && (eyepiecesError !== null || noEyepieces || logError !== null);
const gearLine = [multipleSites ? null : site?.name, multipleTelescopes ? null : telescope?.name]
  .filter((name): name is string => Boolean(name))
  .join(" · ");

const primaryLink =
  "inline-flex items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90";
const promptCard = "rounded-2xl border border-border bg-surface p-4 sm:p-6";
---

{supabase && (
  <>
    <p class="mb-2 text-xs font-semibold tracking-[0.18em] text-primary uppercase">
      {view ? view.dateLabel : t.kicker}
    </p>
    <h1 class="mb-2 font-display text-4xl font-semibold text-heading sm:text-5xl">{t.title}</h1>
    {site && telescope && gearLine && (
      <p class="mb-6 text-sm text-muted-foreground">
        <a href="/gear" class="transition-colors hover:text-heading">
          {gearLine}
        </a>
      </p>
    )}
    {site && telescope && multipleSites && (
      <GearSelector
        items={sites.map(({ id, name }) => ({ id, name }))}
        activeId={site.id}
        param="site"
        label={t.siteSelector.label}
        show={t.siteSelector.show}
      />
    )}
    {site && telescope && multipleTelescopes && (
      <GearSelector
        items={telescopes.map(({ id, name }) => ({ id, name }))}
        activeId={telescope.id}
        param="telescope"
        label={t.selector.label}
        show={t.selector.show}
      />
    )}

    <div class="mt-6 space-y-6">
      {sitesError && <ServerError message={translate(sitesError)} />}
      {telescopesError && <ServerError message={translate(telescopesError)} />}

      {needsSetup && (
        <div class:list={[promptCard]}>
          <p class="mb-4 text-foreground">{t.setupPrompt}</p>
          <a href="/onboarding" class:list={[primaryLink]}>
            {t.setup}
          </a>
        </div>
      )}
      {!needsSetup && !sitesError && !site && (
        <div class:list={[promptCard]}>
          <p class="mb-4 text-foreground">{t.addSitePrompt}</p>
          <a href="/gear/sites/new" class:list={[primaryLink]}>
            {t.addSite}
          </a>
        </div>
      )}
      {!needsSetup && !telescopesError && !telescope && (
        <div class:list={[promptCard]}>
          <p class="mb-4 text-foreground">{t.addTelescopePrompt}</p>
          <a href="/gear/telescopes/new" class:list={[primaryLink]}>
            {t.addTelescope}
          </a>
        </div>
      )}

      {tonightError && <ServerError message={translate(tonightError)} />}

      {view && (
        <>
          {/* The sky and the Moon side by side from md, stacked on a phone; the sky card alone if the Moon failed. */}
          <div class:list={["grid gap-6", view.moonCard && "md:grid-cols-2"]}>
            <VerdictCard
              level={view.verdict.level}
              headline={view.headline}
              text={view.verdictText}
              darkWindow={view.darkWindow}
              timeZone={view.timeZone}
              forecastStatus={view.forecastStatus}
              explanation={view.explanation}
              nightsLink={view.ranking !== null || view.solarSystem !== null}
            />
            {view.moonCard && <MoonCard card={view.moonCard} logHref={logHref(view, MOON_TARGET_KEY)} />}
          </div>

          {showNotices && (
            <div class="space-y-4">
              {eyepiecesError && <ServerError message={translate(eyepiecesError)} />}
              {noEyepieces && (
                <p class="text-sm text-muted-foreground">
                  {t.noEyepiecesPrompt}{" "}
                  <a
                    href="/gear/eyepieces/new"
                    class="font-medium text-primary-strong underline-offset-4 transition-colors hover:underline"
                  >
                    {t.addEyepieces}
                  </a>
                </p>
              )}
              {logError && <ServerError message={translate(logError)} />}
            </div>
          )}

          {view.solarSystem && (
            <SolarSystemSection solarSystem={view.solarSystem} logHref={(key: string) => logHref(view, key)} />
          )}

          {view.ranking && (
            <section aria-labelledby="ranking-heading">
              <div
                class:list={[
                  "flex flex-wrap items-baseline justify-between gap-x-4",
                  multipleTelescopes ? "mb-1" : "mb-4",
                ]}
              >
                <h2 id="ranking-heading" class="font-display text-2xl font-semibold text-heading">
                  {view.ranking.clearedText}
                </h2>
                {hasMore && (
                  <a
                    href="/tonight/all"
                    class="inline-flex min-h-11 items-center gap-1 text-sm font-semibold text-primary-strong transition-colors hover:text-heading"
                  >
                    {t.all.seeAll}
                    <span aria-hidden="true">→</span>
                  </a>
                )}
              </div>
              {multipleTelescopes && (
                <p class="mb-4 text-sm text-muted-foreground">{t.rankingFor({ telescope: view.telescopeName })}</p>
              )}
              {view.ranking.washedOutText && (
                <p class="mb-4 text-sm">
                  <a
                    href="/tonight/all#washed-out"
                    data-washed-out={view.ranking.washedOutCount}
                    class="inline-flex min-h-11 items-center gap-1 font-medium text-primary-strong underline-offset-4 transition-colors hover:underline"
                  >
                    {view.ranking.washedOutText}
                    <span aria-hidden="true">→</span>
                  </a>
                </p>
              )}
              {view.ranking.entries.length > 0 && (
                <ol class="space-y-4">
                  {view.ranking.entries.map((entry, i) => (
                    <ObjectCard entry={entry} rank={i + 1} logHref={logHref(view, entry.id)} />
                  ))}
                </ol>
              )}
              {hasMore && (
                <a
                  href="/tonight/all"
                  class="mt-4 flex min-h-12 w-full items-center justify-center gap-1.5 rounded-xl border border-border bg-surface px-4 text-sm font-semibold text-heading transition-colors hover:bg-accent"
                >
                  {plural(
                    locale,
                    view.ranking.clearedCount,
                    t.all.seeAllCount,
                  )({
                    count: String(view.ranking.clearedCount),
                  })}
                  <span aria-hidden="true">→</span>
                </a>
              )}
            </section>
          )}

          <NightStrip siteName={view.siteName} timeZone={view.timeZone} nights={view.nights} />
        </>
      )}
    </div>
  </>
)}
