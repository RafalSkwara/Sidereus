---
// The Moon's disc for one state (moonlight-and-the-verdict): lunar north up, IAU lunar east (Mare Crisium) right, from
// `moonDiscPaths`. Drawn back to front: the plain dark disc (no earthshine), the lit part, the maria clipped to the
// lit part, then the limb. The `moon-*` tokens
// draw it the same in the dark and light themes (a bright lit part on a dark disc) and in red in red mode.
import { getMessages } from "@/i18n";
import { moonDiscPaths } from "@/lib/moon-disc/geometry";
import type { MoonDiscState } from "@/lib/moon-disc/state";
import { cn } from "@/lib/utils";

interface Props {
  state: MoonDiscState;
  /**
   * Prefixes the lit part's `<clipPath>` id, which also carries the state's time, so two discs on one page never
   * share an id unless they draw the same instant under the same prefix.
   */
  idPrefix?: string;
  class?: string;
}

const { state, idPrefix = "moon-disc", class: className } = Astro.props;
const m = getMessages(Astro.locals.locale).tonight.moon;
const { litPath, mariaPaths } = moonDiscPaths(state);
const clipId = `${idPrefix}-lit-${state.time.replace(/\D/g, "")}`;
// `illuminatedFraction` is in 0.01 steps, so the whole percent needs no locale formatting.
const label = m.card.discLabel({
  phase: m.phase[state.band],
  lit: m.lit({ percent: String(Math.round(state.illuminatedFraction * 100)) }),
});
---

<svg viewBox="-1.04 -1.04 2.08 2.08" role="img" aria-label={label} class:list={[cn("block", className)]}>
  {litPath && (
    <defs>
      <clipPath id={clipId}>
        <path d={litPath} />
      </clipPath>
    </defs>
  )}
  <circle r="1" class="fill-moon-dark" />
  {litPath && (
    <>
      <path d={litPath} class="fill-moon-lit" />
      <g class="fill-moon-mare opacity-50" clip-path={`url(#${clipId})`}>
        {mariaPaths.map((d) => (
          <path d={d} />
        ))}
      </g>
    </>
  )}
  <circle r="1" class="fill-none stroke-moon-limb" stroke-width="1.5" vector-effect="non-scaling-stroke" />
</svg>
