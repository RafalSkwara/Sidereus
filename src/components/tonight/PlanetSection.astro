---
// "Planets tonight" (M-2 S-01): between the verdict card and the deep-sky ranking. It shows whenever the planet
// window's own weather is go or marginal, so also on a cloudy-at-night no-go or a night without a dark window,
// where the ranking is absent.
import PlanetCard from "@/components/tonight/PlanetCard.astro";
import { getMessages } from "@/i18n";
import type { TonightPlanets } from "@/lib/tonight/build";

interface Props {
  planets: TonightPlanets;
  /** The log form for a planet by its target key ("jupiter"), prefilled with tonight's night, site and telescope. */
  logHref: (key: string) => string;
}

const { planets, logHref } = Astro.props;
const t = getMessages(Astro.locals.locale).tonight.planets;
---

<section aria-labelledby="planets-heading">
  <h2 id="planets-heading" class="mb-1 font-display text-2xl font-semibold text-heading">
    {t.heading}
  </h2>
  <p class="text-sm text-muted-foreground">{planets.windowText}</p>
  {planets.weatherText && <p class="mt-1 text-sm text-foreground">{planets.weatherText}</p>}
  {planets.entries.length > 0 ? (
    <ol class="mt-4 space-y-4">
      {planets.entries.map((entry) => (
        <PlanetCard entry={entry} logHref={logHref(entry.key)} />
      ))}
    </ol>
  ) : (
    <p class="mt-4 rounded-2xl border border-border bg-surface p-4 text-sm text-foreground sm:p-5">
      {planets.noneText}
    </p>
  )}
</section>
