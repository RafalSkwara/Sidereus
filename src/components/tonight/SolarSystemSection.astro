---
// "Planets tonight" (M-2 S-01): between the sky and Moon cards and the deep-sky ranking. It shows whenever the planet
// window's own weather is go or marginal, so also on a cloudy-at-night no-go or a night without a dark window, where
// the ranking is absent. Planets only: since moonlight-and-the-verdict the Moon has its own card at the top.
import PlanetCard from "@/components/tonight/PlanetCard.astro";
import Band from "@/components/ui/Band.astro";
import { getMessages } from "@/i18n";
import type { TonightSolarSystem } from "@/lib/tonight/build";

interface Props {
  solarSystem: TonightSolarSystem;
  /** The log form for a planet by its key ("jupiter"), prefilled with tonight's night, site and telescope. */
  logHref: (key: string) => string;
}

const { solarSystem, logHref } = Astro.props;
const t = getMessages(Astro.locals.locale).tonight.planets;
---

<Band id="planets" headingId="planets-heading" heading={t.heading}>
  <p class="text-label text-muted-foreground">{solarSystem.windowText}</p>
  {solarSystem.weatherText && <p class="mt-1 text-label text-foreground">{solarSystem.weatherText}</p>}
  {solarSystem.entries.length > 0 && (
    <ol aria-label={t.listLabel} class="mt-4 divide-y divide-border">
      {solarSystem.entries.map((entry) => (
        <PlanetCard entry={entry} logHref={logHref(entry.key)} />
      ))}
    </ol>
  )}
  {solarSystem.noneText && <p class="mt-4 text-body text-foreground">{solarSystem.noneText}</p>}
</Band>
