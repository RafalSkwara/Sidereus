---
/**
 * Data credits required by the OpenNGC (CC BY-SA 4.0), HYG (CC BY-SA 4.0), Hipparcos (ESA, CC BY-NC 3.0 IGO) and
 * Open-Meteo (CC BY 4.0) licences. HYG compiles Hipparcos, so ESA is credited beside it. The meteor showers of the
 * sky events page credit NASA (peak nights) and the IAU Meteor Data Center (radiants), as `LICENSE-DATA.md` promises.
 */
import { getMessages } from "@/i18n";

const t = getMessages(Astro.locals.locale).tonight.attribution;
// Inline links in a credit line (exempt from the 44 px target); they still take the shared focus ring.
const link =
  "rounded-sm underline decoration-border underline-offset-2 transition-colors hover:text-heading focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring";
---

<p class="text-xs text-muted-foreground">
  {t.objectData}{" "}
  <a href="https://github.com/mattiaverga/OpenNGC" class:list={[link]} rel="noopener noreferrer">
    OpenNGC
  </a>{" "}
  (CC BY-SA 4.0) · {t.starData}{" "}
  <a href="https://github.com/astronexus/HYG-Database" class:list={[link]} rel="noopener noreferrer">
    HYG
  </a>{" "}
  (CC BY-SA 4.0) ·{" "}
  <a href="https://www.cosmos.esa.int/web/hipparcos/catalogues" class:list={[link]} rel="noopener noreferrer">
    Hipparcos,
  </a>{" "}
  {t.hipparcosCredit} (CC BY-NC 3.0 IGO) · {t.weather}{" "}
  <a href="https://open-meteo.com/" class:list={[link]} rel="noopener noreferrer">
    Open-Meteo
  </a>{" "}
  (CC BY 4.0) · {t.meteorData}{" "}
  <a href="https://science.nasa.gov/meteor-showers/" class:list={[link]} rel="noopener noreferrer">
    NASA
  </a>{" "}
  ({t.nasaFor}),{" "}
  <a href="https://ceresiaumdc.ta3.sk/" class:list={[link]} rel="noopener noreferrer">
    IAU Meteor Data Center
  </a>{" "}
  ({t.mdcFor})
</p>
