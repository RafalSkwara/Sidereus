---
/** Data credits required by the OpenNGC (CC BY-SA 4.0) and Open-Meteo (CC BY 4.0) licences. */
import { getMessages } from "@/i18n";

const t = getMessages(Astro.locals.locale).tonight.attribution;
// Inline links in a credit line (exempt from the 44 px target); they still take the shared focus ring.
const link =
  "rounded-sm underline decoration-border underline-offset-2 transition-colors hover:text-heading focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring";
---

<p class="text-xs text-muted-foreground">
  {t.objectData}{" "}
  <a href="https://github.com/mattiaverga/OpenNGC" class:list={[link]} rel="noopener noreferrer">
    OpenNGC
  </a>{" "}
  (CC BY-SA 4.0) · {t.weather}{" "}
  <a href="https://open-meteo.com/" class:list={[link]} rel="noopener noreferrer">
    Open-Meteo
  </a>{" "}
  (CC BY 4.0)
</p>
