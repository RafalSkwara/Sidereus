---
// The details of one ranked object: window and best time, then its facts in D5's order (ui-fact-rhythm): what you'll
// see (the accent Eye), the eyepiece pair, why (muted), then "Mark observed". Shown by the Targets page's best five
// (ObjectCard) and its expandable rows (ObjectRow); Tonight's dashboard lists no details since tonight-dashboard.
import TargetDetails from "@/components/tonight/TargetDetails.astro";
import Fact from "@/components/ui/Fact.astro";
import { getMessages } from "@/i18n";
import type { ExpectationKey } from "@/lib/engine";
import type { TonightEntry } from "@/lib/tonight/build";

interface Props {
  entry: TonightEntry;
  /** The log form for this object, prefilled with the ranking's night, site and telescope (FR-016). */
  logHref: string;
  /** The finder chart for this object (finder-chart). */
  finderHref: string;
  /**
   * What the object will look like in the user's telescope (what-to-expect), computed on the server for a confirmed
   * full plan only. Absent or null: no line.
   */
  expectation?: { key: ExpectationKey; text: string } | null;
}

const { entry, logHref, finderHref, expectation = null } = Astro.props;
const tonight = getMessages(Astro.locals.locale).tonight;
const t = tonight.object;
---

<TargetDetails
  windowStart={entry.windowStart}
  windowEnd={entry.windowEnd}
  bestTime={entry.bestTime}
  bestDirection={entry.bestDirection}
  logHref={logHref}
  finderHref={finderHref}
  finderLabel={tonight.finder.linkLabel({ target: entry.label })}
  srSuffix={entry.label}
>
  {expectation && (
    /* The first fact, above the eyepiece pair. `data-expect` carries the key on the fact's root, whose only text is the
       phrase (the icon is an aria-hidden svg): the bare attribute would also match `data-expect-locked`, so smoke and
       e2e look for `data-expect="`. */
    <Fact kind="see" iconClass="text-primary-strong" data-expect={expectation.key}>
      <span>{expectation.text}</span>
    </Fact>
  )}
  {/* No eyepieces, no eyepiece fact: "Find with" and the none-fit sentence stay out of the page. */}
  {entry.pair?.kind === "pair" && (
    <Fact kind="eyepiece">
      <p>
        {t.findWith} <span class="font-semibold text-heading">{entry.pair.finding.name}</span>{" "}
        {t.magnification({ magnification: String(entry.pair.finding.magnification) })}
      </p>
      {/* The message reads on after "Find with …" in lower case: its own line starts with a capital. */}
      <p class="first-letter:uppercase">
        {t.detailWith} <span class="font-semibold text-heading">{entry.pair.detail.name}</span>{" "}
        {t.magnification({ magnification: String(entry.pair.detail.magnification) })}
      </p>
    </Fact>
  )}
  {entry.pair?.kind === "none-fit" && (
    <Fact kind="eyepiece">
      <p>{t.noneFit({ name: entry.pair.widestName })}</p>
    </Fact>
  )}
  <Fact kind="why" tone="muted">
    <p>{entry.reason}</p>
  </Fact>
</TargetDetails>
