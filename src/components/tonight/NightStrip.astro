---
// FR-011: the next seven nights at the Tonight site, from tonight (the verdict card's night) onward. Nights 1-3
// carry the verdict, worded by its sky headline; nights 4-7 only the dark window, the moon and a cloud outlook, in
// neutral tokens and never a headline or tone (invariant 5). A ruled Band: one row per night, the date and dark
// window stacked in a fixed-width column on a phone and side by side on wider screens.
import { VERDICT_TONES } from "@/components/tonight/verdict-tones";
import Band from "@/components/ui/Band.astro";
import { getMessages } from "@/i18n";
import type { TonightNight } from "@/lib/tonight/build";

interface Props {
  siteName: string;
  timeZone: string;
  /** In date order, night 1 first. */
  nights: TonightNight[];
}

type VerdictNight = Extract<TonightNight, { kind: "verdict" }>;
type OutlookNight = Extract<TonightNight, { kind: "outlook" }>;

const { siteName, timeZone, nights } = Astro.props;
const m = getMessages(Astro.locals.locale);
const t = m.tonight.nights;

const verdictNights = nights.filter((night): night is VerdictNight => night.kind === "verdict");
const outlookNights = nights.filter((night): night is OutlookNight => night.kind === "outlook");

// Phone: date over dark window on the left, verdict/outlook and moon on the right. sm+: date | dark window | rest.
// The left column is a fixed width from the spacing scale (w-26, then w-26 + w-28), so the rows line up.
const row = "flex gap-x-4 py-3 text-label";
const leftCell = "w-26 shrink-0 sm:flex sm:w-auto sm:gap-x-4";
const dateCell = "block font-semibold text-heading sm:w-26";
const darkCell = "block text-foreground tabular-nums sm:w-28";
const mainCell = "min-w-0 flex-1";
const groupLabel = "text-label font-semibold";
---

<Band
  id="nights"
  headingId="nights-heading"
  heading={t.heading({ count: String(nights.length), site: siteName })}
  headingHidden
>
  <p class="mb-4 text-label text-muted-foreground">{t.timesIn({ zone: timeZone })}</p>

  <div>
    {verdictNights.length > 0 && (
      <>
        <h3 class:list={[groupLabel, "text-primary"]}>{t.verdictLabel}</h3>
        <ol class="divide-y divide-border">
          {verdictNights.map((night) => (
            <li class:list={[row]}>
              <div class:list={[leftCell]}>
                <span class:list={[dateCell]}>{night.label}</span>
                <span class:list={[darkCell]}>{night.darkText}</span>
              </div>
              <div class:list={[mainCell]}>
                <p>
                  <span
                    class="inline-flex items-center gap-2 font-semibold text-heading"
                    data-sky-headline={night.headline.key}
                  >
                    <span
                      class:list={["size-2 shrink-0 rounded-full", VERDICT_TONES[night.level].dot]}
                      aria-hidden="true"
                    ></span>
                    {night.headline.text}
                  </span>
                  {night.reasonText && <span class="text-muted-foreground"> — {night.reasonText}</span>}
                </p>
                <p class="text-muted-foreground">{night.moonText}</p>
              </div>
            </li>
          ))}
        </ol>
      </>
    )}

    {outlookNights.length > 0 && (
      <>
        <h3
          class:list={[
            groupLabel,
            "text-muted-foreground",
            verdictNights.length > 0 && "mt-1 border-t-2 border-dashed border-border pt-4",
          ]}
        >
          {t.outlookLabel}
        </h3>
        <ol start={verdictNights.length + 1} class="divide-y divide-border">
          {outlookNights.map((night) => (
            <li class:list={[row]}>
              <div class:list={[leftCell]}>
                <span class:list={[dateCell]}>{night.label}</span>
                <span class:list={[darkCell]}>{night.darkText}</span>
              </div>
              <div class:list={[mainCell, "text-muted-foreground"]}>
                {night.cloudText !== null && <p>{night.cloudText}</p>}
                <p>{night.moonText}</p>
              </div>
            </li>
          ))}
        </ol>
      </>
    )}
  </div>
</Band>
