---
// FR-011: the next seven nights at the Tonight site, from tonight (the verdict card's night) onward. Nights 1-3
// carry the verdict; nights 4-7 only the dark window, the moon and a cloud outlook, in neutral tokens and never a
// verdict level or tone (invariant 5). One row per night on a phone; a three-column grid on wider screens.
import { VERDICT_TONES } from "@/components/tonight/verdict-tones";
import { getMessages } from "@/i18n";
import type { TonightNight } from "@/lib/tonight/build";

interface Props {
  siteName: string;
  timeZone: string;
  /** In date order, night 1 first. */
  nights: TonightNight[];
}

type VerdictNight = Extract<TonightNight, { kind: "verdict" }>;
type OutlookNight = Extract<TonightNight, { kind: "outlook" }>;

const { siteName, timeZone, nights } = Astro.props;
const m = getMessages(Astro.locals.locale);
const t = m.tonight.nights;

const verdictNights = nights.filter((night): night is VerdictNight => night.kind === "verdict");
const outlookNights = nights.filter((night): night is OutlookNight => night.kind === "outlook");

// Phone: date over dark window on the left, verdict/outlook and moon on the right. sm+: date | dark window | rest.
const row =
  "grid grid-cols-[6.5rem_minmax(0,1fr)] gap-x-4 gap-y-0.5 px-4 py-3 text-sm sm:grid-cols-[6.5rem_7rem_minmax(0,1fr)] sm:px-5";
const dateCell = "font-semibold text-heading";
const darkCell = "col-start-1 row-start-2 text-foreground tabular-nums sm:col-start-2 sm:row-start-1";
const mainCell = "col-start-2 row-span-2 row-start-1 min-w-0 sm:col-start-3 sm:row-span-1";
const groupLabel = "px-4 pb-1 text-xs font-semibold tracking-[0.18em] uppercase sm:px-5";
---

<section id="nights" aria-labelledby="nights-heading" class="scroll-mt-6">
  <h2 id="nights-heading" class="mb-1 font-display text-2xl font-semibold text-heading">
    {t.heading({ site: siteName })}
  </h2>
  <p class="mb-4 text-sm text-muted-foreground">{t.timesIn({ zone: timeZone })}</p>

  <div class="overflow-hidden rounded-2xl border border-border bg-surface">
    {verdictNights.length > 0 && (
      <>
        <h3 class:list={[groupLabel, "pt-3 text-primary"]}>{t.verdictLabel}</h3>
        <ol class="divide-y divide-border">
          {verdictNights.map((night) => (
            <li class:list={[row]}>
              <span class:list={[dateCell]}>{night.label}</span>
              <span class:list={[darkCell]}>{night.darkText}</span>
              <div class:list={[mainCell]}>
                <p>
                  <span class="inline-flex items-center gap-2 font-semibold text-heading">
                    <span
                      class:list={["size-2 shrink-0 rounded-full", VERDICT_TONES[night.level].dot]}
                      aria-hidden="true"
                    ></span>
                    {m.verdict.level[night.level]}
                  </span>
                  {night.reasonText && <span class="text-muted-foreground"> — {night.reasonText}</span>}
                </p>
                <p class="text-muted-foreground">{night.moonText}</p>
              </div>
            </li>
          ))}
        </ol>
      </>
    )}

    {outlookNights.length > 0 && (
      <>
        <h3
          class:list={[
            groupLabel,
            "text-muted-foreground",
            verdictNights.length > 0 ? "border-t-2 border-dashed border-border pt-4" : "pt-3",
          ]}
        >
          {t.outlookLabel}
        </h3>
        <ol start={verdictNights.length + 1} class="divide-y divide-border">
          {outlookNights.map((night) => (
            <li class:list={[row]}>
              <span class:list={[dateCell]}>{night.label}</span>
              <span class:list={[darkCell]}>{night.darkText}</span>
              <div class:list={[mainCell, "text-muted-foreground"]}>
                {night.cloudText !== null && <p>{night.cloudText}</p>}
                <p>{night.moonText}</p>
              </div>
            </li>
          ))}
        </ol>
      </>
    )}
  </div>
</section>
