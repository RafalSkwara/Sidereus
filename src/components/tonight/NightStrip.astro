---
// FR-011: the next seven nights at the Tonight site, from tonight (the verdict card's night) onward. Nights 1-3
// carry the verdict, worded by its sky headline; nights 4-7 only the dark window, the moon and a cloud outlook, in
// neutral tokens and never a headline or tone (invariant 5). A ruled Band: one row per night, the date and dark
// window stacked in a fixed-width column at every width, and the headline, its reason and the Moon each on their own
// line beside it (ui-user-adjustments). The group labels use the muted overline role, and the lines beside the
// headline are muted icon-led facts (ui-fact-rhythm); a row holds no list element (the spec counts `ol > li`).
import { VERDICT_TONES } from "@/components/tonight/verdict-tones";
import Band from "@/components/ui/Band.astro";
import Fact from "@/components/ui/Fact.astro";
import { getMessages } from "@/i18n";
import type { TonightNight } from "@/lib/tonight/build";

interface Props {
  siteName: string;
  timeZone: string;
  /** In date order, night 1 first. */
  nights: TonightNight[];
}

type VerdictNight = Extract<TonightNight, { kind: "verdict" }>;
type OutlookNight = Extract<TonightNight, { kind: "outlook" }>;

const { siteName, timeZone, nights } = Astro.props;
const m = getMessages(Astro.locals.locale);
const t = m.tonight.nights;

const verdictNights = nights.filter((night): night is VerdictNight => night.kind === "verdict");
const outlookNights = nights.filter((night): night is OutlookNight => night.kind === "outlook");

// Date over dark window on the left, headline / reason / moon (or cloud outlook / moon) on the right, the line role
// between the lines and the item role around each row. The left column is a fixed width from the spacing scale (w-26,
// w-28 from sm), so the rows line up.
const row = "flex gap-x-4 py-item text-label";
const leftCell = "flex w-26 shrink-0 flex-col gap-y-line sm:w-28";
const dateCell = "block font-semibold text-heading";
const darkCell = "block text-foreground tabular-nums";
const mainCell = "flex min-w-0 flex-1 flex-col gap-y-line";
const groupLabel = "text-overline text-muted-foreground";
---

<Band
  id="nights"
  headingId="nights-heading"
  heading={t.heading({ count: String(nights.length), site: siteName })}
  headingHidden
>
  <p class="mb-group text-label text-muted-foreground">{t.timesIn({ zone: timeZone })}</p>

  <div>
    {verdictNights.length > 0 && (
      <>
        <h3 class:list={[groupLabel]}>{t.verdictLabel}</h3>
        <ol class="divide-y divide-border">
          {verdictNights.map((night) => (
            <li class:list={[row]}>
              <div class:list={[leftCell]}>
                <span class:list={[dateCell]}>{night.label}</span>
                <span class:list={[darkCell]}>{night.darkText}</span>
              </div>
              <div class:list={[mainCell]}>
                <p>
                  <span
                    class="inline-flex items-center gap-2 font-semibold text-heading"
                    data-sky-headline={night.headline.key}
                  >
                    <span
                      class:list={["size-2 shrink-0 rounded-full", VERDICT_TONES[night.level].dot]}
                      aria-hidden="true"
                    ></span>
                    {night.headline.text}
                  </span>
                </p>
                {night.reasonText && (
                  <Fact kind="why" tone="muted">
                    <p class="first-letter:uppercase">{night.reasonText}</p>
                  </Fact>
                )}
                <Fact kind="moon" tone="muted">
                  <span>{night.moonText}</span>
                </Fact>
              </div>
            </li>
          ))}
        </ol>
      </>
    )}

    {outlookNights.length > 0 && (
      <>
        <h3
          class:list={[
            groupLabel,
            verdictNights.length > 0 && "mt-line border-t-2 border-dashed border-border pt-group",
          ]}
        >
          {t.outlookLabel}
        </h3>
        <ol start={verdictNights.length + 1} class="divide-y divide-border">
          {outlookNights.map((night) => (
            <li class:list={[row]}>
              <div class:list={[leftCell]}>
                <span class:list={[dateCell]}>{night.label}</span>
                <span class:list={[darkCell]}>{night.darkText}</span>
              </div>
              <div class:list={[mainCell]}>
                {night.cloudText !== null && (
                  <Fact kind="cloud" tone="muted">
                    <span>{night.cloudText}</span>
                  </Fact>
                )}
                <Fact kind="moon" tone="muted">
                  <span>{night.moonText}</span>
                </Fact>
              </div>
            </li>
          ))}
        </ol>
      </>
    )}
  </div>
</Band>
