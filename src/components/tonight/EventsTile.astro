---
/*
 * The dashboard's "Sky events" tile (M-3 S-07, sky-events Phase 5): the next notable visible event and when to go
 * ("Perseids peak · night of 12/13 Aug", "Moon and Jupiter, 1.8° apart · tonight"), or the fact that there is none in
 * the window. Always shown, straight after "Point here first", and it opens `/tonight/events`. Its own component so
 * `TonightTiles` and the /design specimens share it, the specimens with their own heading ids.
 */
import Tile from "@/components/ui/Tile.astro";
import { getMessages } from "@/i18n";
import { eventsTileLine, type TonightSkyEvents } from "@/lib/tonight/sky-events";

interface Props {
  /** The view's events block; `null` when working it out failed (the tile then says so). */
  events: TonightSkyEvents | null;
  /** The heading's id; /design gives each specimen its own so ids stay unique. */
  headingId?: string;
}

const { events, headingId = "tile-events-heading" } = Astro.props;
const { locale } = Astro.locals;
const m = getMessages(locale);
---

<Tile href="/tonight/events" headingId={headingId} heading={m.tonight.summary.events}>
  <span class="mt-3 block text-body font-semibold break-words" data-events-tile-line>
    {eventsTileLine(events, locale)}
  </span>
</Tile>
