---
/*
 * Tonight's tiles under the sky (tonight-dashboard): what to point at first, the Session plan, the Moon, the planets and
 * the week, each a ruled, full-width row that opens its own page (`/tonight/targets`, `/tonight/plan`, `/tonight/moon`,
 * `/tonight/planets`, `/tonight/nights`, and since sky-events `/tonight/events`, the second tile), never an anchor on
 * the dashboard. A tile only restates the view at a glance; the pages keep every number and action. Tiles with nothing to say are left out (no Session plan, no Moon card, no
 * solar system, no nights); "Point here first" always shows and always opens Targets, with "no targets" when nothing
 * ranks (the page says why). The Session plan tile is its heading and the server's `nextUp` line (no timeline; the
 * Plan page draws it): "First up: <target> <time>" before sunset, "Next: <target> <time>" during the night, "Nothing
 * left on tonight's plan." once every window has ended, or the empty line when nothing is planned. Each link is
 * named by its heading only (`aria-labelledby`), not by the whole tile; "Point here first" adds "Open Targets", since
 * its heading does not name the page it opens. The → says it opens a page. "Sky events" always shows, straight after
 * the targets: the next notable visible event and when to go ("Perseids peak · night of 12/13 Aug"), or the fact that
 * there is none in the window.
 *
 * Rhythm (ui-dashboard-tiles D1, D2): each tile is a `py-item` row (`tile.ts`); its content sits under the heading at
 * `TILE_CONTENT_CLASS` (`line`), the lines of one group on `line` (the targets' rows `space-y-line`, the Planets reason,
 * the nights' columns), and an explanatory caption is a second group at `mt-group` (the not-seen legend with the
 * cleared-count caption `mt-line` under it, the nights caption). Overrides of the shared caption go through `cn()`. The
 * Planets reason is the same muted "why" `Fact` as on `/tonight/planets`. Tile headings carry no icon (2B); the Events
 * line is the one exception to text-led tiles: it leads with the next event's kind icon (D5, `EventsTile`).
 */
import EventsTile from "@/components/tonight/EventsTile.astro";
import MoonDisc from "@/components/tonight/MoonDisc";
import NotSeenLegend from "@/components/tonight/NotSeenLegend.astro";
import NotSeenMark from "@/components/tonight/NotSeenMark.astro";
import Fact from "@/components/ui/Fact.astro";
import Tile from "@/components/ui/Tile.astro";
import { TILE_CONTENT_CLASS } from "@/components/ui/tile";
import { getMessages, plural } from "@/i18n";
import { localCommonName } from "@/lib/catalogue/common-names";
import { OUTLOOK_NIGHTS, VERDICT_NIGHTS } from "@/lib/engine/parameters";
import type { TonightView } from "@/lib/tonight/build";
import { createFormatter, formatLocaleTag } from "@/lib/tonight/format";
import { cn } from "@/lib/utils";

interface Props {
  view: TonightView;
}

const { view } = Astro.props;
const { locale } = Astro.locals;
const m = getMessages(locale);
const t = m.tonight.summary;
const open = (page: string) => m.tonight.pages.open({ page });
const nightsTitle = t.nights({ count: String(OUTLOOK_NIGHTS) });
const { listOf } = createFormatter(locale);
const tag = formatLocaleTag(locale);

// A caption line; it follows another caption line at `line`, and opens its own group with `cn(caption, "mt-group")`.
const caption = "mt-line block text-label text-muted-foreground";

// Point here first. Without a ranking (weather no-go or no darkness) the tile says there are no targets; it still
// opens Targets, which gives the reason and the way to the week.
const targets = view.summaryTargets.map((entry) => ({
  id: entry.id,
  name: localCommonName(entry.id, entry.commonName, locale) ?? entry.label,
  bestTime: entry.bestTime,
  notSeenYet: entry.notSeenYet,
}));
const anyNotSeen = targets.some((target) => target.notSeenYet);

// Session plan: the row the server's `nextUp` points at (by best time, or in the user's order on an edited plan,
// adjustable-session-plan D13; named as the live sky's markers name it).
const plan = view.sessionPlan;
const nextUp = plan?.nextUp ?? null;
const nextRow = plan && nextUp && nextUp.kind !== "done" ? (plan.rows[nextUp.index] ?? null) : null;
const planLine =
  nextUp === null
    ? t.planEmpty
    : nextUp.kind === "done"
      ? t.planDone
      : nextRow
        ? (nextUp.kind === "first" ? t.planFirst : t.planNext)({ name: nextRow.name, time: nextRow.bestTime })
        : t.planEmpty;

// The Moon at the page-load moment: the card's own initial state, so the tile and the Moon page's slider agree.
const moonCard = view.moonCard;
const moonState = moonCard && moonCard.states.length > 0 ? moonCard.states[moonCard.initialIndex] : null;
const percentFormat = new Intl.NumberFormat(tag, { style: "percent", maximumFractionDigits: 0 });
// One line: "9% · Waning crescent · Up 05:52–07:03" (the up part is left out when the card has none).
const moonLine = moonState
  ? [percentFormat.format(moonState.illuminatedFraction), m.tonight.moon.phase[moonState.band], moonCard?.upText]
      .filter(Boolean)
      .join(t.separator)
  : "";

// Planets: the names as one list, best-placed first, and the best one's reason.
const solarSystem = view.solarSystem;
const planetNames = solarSystem ? listOf(solarSystem.entries.map((entry) => entry.name)) : "";

// The week as bars: height is the clear share (a hairline at 0-2 %, a dashed outline with no forecast), colour the
// verdict on the verdict nights and a neutral ink after. Under each verdict bar a mark repeats the verdict by shape
// (go a filled dot, marginal a half-filled one, no-go a ring), so it reads without colour and in red mode. The bars
// are decorative; a hidden sentence reads the verdict nights instead.
const BAR_FILLS = { go: "fill-go", marginal: "fill-marginal", "no-go": "fill-no-go", faint: "fill-faint" } as const;
const BAR_STROKES = {
  go: "stroke-go",
  marginal: "stroke-marginal",
  "no-go": "stroke-no-go",
  faint: "stroke-faint",
} as const;
const MARK_TONES = { go: "text-go", marginal: "text-marginal", "no-go": "text-no-go" } as const;
const HAIRLINE = 2;
const weekdayFormat = new Intl.DateTimeFormat(tag, { timeZone: "UTC", weekday: "short" });
const weekday = (date: string) => {
  const [year, month, day] = date.split("-").map(Number);
  return weekdayFormat.format(new Date(Date.UTC(year, month - 1, day)));
};
const bars = view.nights.map((night) => {
  const tone = night.kind === "verdict" ? night.level : "faint";
  return {
    day: weekday(night.date),
    height: night.clearPct === null ? null : Math.max(HAIRLINE, night.clearPct),
    fill: BAR_FILLS[tone],
    stroke: BAR_STROKES[tone],
    mark: night.kind === "verdict" ? night.level : null,
  };
});
const nightsSummary = view.nights
  .flatMap((night) => (night.kind === "verdict" ? [`${night.label}: ${night.headline.text}`] : []))
  .join("; ");
---

<div data-tonight-tiles>
  <Tile href="/tonight/targets" headingId="tile-targets-heading" heading={t.targets} labelledBy="tile-targets-open">
    {targets.length > 0 ? (
      <>
        <ul class:list={[TILE_CONTENT_CLASS, "space-y-line"]}>
          {targets.map((target) => (
            <li class="flex items-baseline justify-between gap-3 text-title">
              <span class="min-w-0 font-semibold break-words">
                {target.name}
                {/* The tile is a link: no button in it, so a static icon and one legend line under the rows. */}
                {target.notSeenYet && <NotSeenMark variant="static" srLabel={false} />}
              </span>
              <span class="shrink-0 tabular-nums">{target.bestTime}</span>
            </li>
          ))}
        </ul>
        {anyNotSeen && <NotSeenLegend class="mt-group" />}
        {view.ranking && (
          <span class:list={cn(caption, !anyNotSeen && "mt-group")}>
            {plural(locale, view.ranking.clearedCount, t.targetsCaption)({ count: String(view.ranking.clearedCount) })}
          </span>
        )}
      </>
    ) : (
      <span class:list={[TILE_CONTENT_CLASS, "block text-body font-semibold"]}>{t.noTargets}</span>
    )}
    <span id="tile-targets-open" class="sr-only">
      {open(m.tonight.pages.targets)}
    </span>
  </Tile>

  <EventsTile events={view.skyEvents} />

  {plan && (
    <Tile href="/tonight/plan" headingId="tile-plan-heading" heading={t.plan}>
      <span class:list={[TILE_CONTENT_CLASS, "block text-body font-semibold"]}>{planLine}</span>
    </Tile>
  )}

  {moonCard && (
    <Tile href="/tonight/moon" headingId="tile-moon-heading" heading={t.moon}>
      {moonState ? (
        <span class:list={[TILE_CONTENT_CLASS, "flex items-center gap-4"]}>
          <MoonDisc state={moonState} clipId="moon-summary-lit" decorative className="size-6 shrink-0" />
          <span class="min-w-0 text-body">{moonLine}</span>
        </span>
      ) : (
        <span class:list={[TILE_CONTENT_CLASS, "block text-body"]}>{moonCard.phaseText}</span>
      )}
    </Tile>
  )}

  {solarSystem && (
    <Tile href="/tonight/planets" headingId="tile-planets-heading" heading={t.planets}>
      {solarSystem.entries.length > 0 ? (
        <>
          <span class:list={[TILE_CONTENT_CLASS, "block text-body font-semibold break-words"]}>{planetNames}</span>
          {/* A `div`, never a `span`: `Fact` is a block. */}
          <div class="mt-line">
            <Fact kind="why" tone="muted">
              <p>{solarSystem.entries[0].reason}</p>
            </Fact>
          </div>
        </>
      ) : (
        solarSystem.noneText && <span class:list={[TILE_CONTENT_CLASS, "block text-body"]}>{solarSystem.noneText}</span>
      )}
    </Tile>
  )}

  {bars.length > 0 && (
    <Tile href="/tonight/nights" headingId="tile-nights-heading" heading={nightsTitle}>
      <span class:list={[TILE_CONTENT_CLASS, "grid grid-cols-7 items-end gap-x-2"]} aria-hidden="true">
        {bars.map((bar) => (
          <span class="flex flex-col items-center gap-line">
            <svg
              viewBox="0 0 10 100"
              preserveAspectRatio="none"
              focusable="false"
              class="block h-10 w-full overflow-visible sm:h-18"
            >
              {bar.height === null ? (
                <rect
                  x="0"
                  y="0"
                  width="10"
                  height="100"
                  stroke-width="1.5"
                  stroke-dasharray="4 3"
                  vector-effect="non-scaling-stroke"
                  class:list={["fill-none", bar.stroke]}
                />
              ) : (
                <rect x="0" y={100 - bar.height} width="10" height={bar.height} class:list={[bar.fill]} />
              )}
            </svg>
            {bar.mark ? (
              <svg viewBox="0 0 12 12" focusable="false" class:list={["block size-3", MARK_TONES[bar.mark]]}>
                {bar.mark === "go" && <circle cx="6" cy="6" r="5.25" class="fill-current" />}
                {bar.mark === "marginal" && <path d="M6 0.75a5.25 5.25 0 0 0 0 10.5z" class="fill-current" />}
                {bar.mark !== "go" && (
                  <circle cx="6" cy="6" r="4.5" stroke-width="1.5" class="fill-none stroke-current" />
                )}
              </svg>
            ) : (
              <span class="block size-3"></span>
            )}
            <span class="text-label font-semibold">{bar.day}</span>
          </span>
        ))}
      </span>
      {nightsSummary && <span class="sr-only">{nightsSummary}</span>}
      <span class:list={cn(caption, "mt-group")}>{t.nightsCaption({ count: String(VERDICT_NIGHTS) })}</span>
    </Tile>
  )}
</div>
