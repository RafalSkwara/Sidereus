---
import NavIcon from "@/components/NavIcon.astro";
import TopbarControls from "@/components/TopbarControls";
import { getMessages } from "@/i18n";
import { getAccountPlan } from "@/lib/account-plan";
import { NAV_ITEMS, isCurrentPage } from "@/lib/navigation";

const { user, theme, locale } = Astro.locals;
// The account plan line in the settings panel (F-01 addendum): one lazy query per page, signed in only.
const accountPlan = user ? await getAccountPlan(Astro.locals) : null;
const m = getMessages(locale);
const { pathname } = Astro.url;
const links = NAV_ITEMS.map((item) => ({
  ...item,
  text: m.nav[item.label],
  current: isCurrentPage(pathname, item.href),
}));
const onSignin = isCurrentPage(pathname, "/auth/signin");
// `/` is the signed-out landing and redirects a user to `/tonight` (ui-landing), so the logo skips that hop.
// Focus is a `--ring` outline offset from the control, so it shows on the filled current segment too.
const focusRing = "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring";
---

<!--
  One row at every width (top-nav-redesign). From `md` the destinations are a segmented pill in the right-hand
  cluster, next to the eye and settings buttons; below `md` the tab bar (TabBar.astro, rendered by each shell)
  carries them instead. Theme, language and sign-out live in TopbarControls' settings popover.
-->
<header class="flex h-16 items-center gap-3 sm:gap-4">
  <a
    href={user ? "/tonight" : "/"}
    class:list={["flex shrink-0 items-center gap-2.5 rounded-md transition-opacity hover:opacity-90", focusRing]}
  >
    <svg viewBox="0 0 24 24" class="size-5.5 text-primary" fill="currentColor" aria-hidden="true">
      <path d="M12 2 13.8 10.2 22 12l-8.2 1.8L12 22l-1.8-8.2L2 12l8.2-1.8Z"></path>
    </svg>
    <span class="font-display text-title font-semibold text-heading">{m.common.appName}</span>
  </a>

  <div class="ml-auto flex items-center gap-1 sm:gap-3">
    {user && (
      <nav aria-label={m.nav.primary} class="hidden gap-0.5 rounded-full border border-border p-0.5 md:flex">
        {links.map((link) => (
          <a
            href={link.href}
            aria-current={link.current ? "page" : undefined}
            data-needs-network={link.needsNetwork ? "" : undefined}
            class:list={[
              "group inline-flex h-11 items-center gap-1.5 rounded-full px-3.5 text-sm font-semibold",
              "transition duration-150 ease-out active:scale-95 motion-reduce:transition-none",
              focusRing,
              link.current
                ? "bg-selected text-selected-foreground"
                : "text-muted-foreground hover:bg-accent hover:text-heading",
            ]}
            style={
              // The current segment is the indicator that glides to the next page's segment (global.css).
              link.current ? "view-transition-name: nav-current" : undefined
            }
          >
            <NavIcon
              name={link.icon}
              class:list={[
                "size-4 transition-transform duration-150 ease-out motion-reduce:transition-none",
                !link.current && "group-hover:-translate-y-px",
              ]}
            />
            {link.text}
          </a>
        ))}
      </nav>
    )}
    {!user && (
      <a
        href="/auth/signin"
        aria-current={onSignin ? "page" : undefined}
        class:list={[
          "inline-flex min-h-11 items-center rounded-md px-1 text-label whitespace-nowrap transition-colors hover:text-heading",
          focusRing,
          onSignin ? "font-semibold text-heading" : "text-muted-foreground",
        ]}
      >
        {m.nav.signIn}
      </a>
    )}
    <TopbarControls theme={theme} locale={locale} email={user?.email ?? null} accountPlan={accountPlan} client:load />
  </div>
</header>
