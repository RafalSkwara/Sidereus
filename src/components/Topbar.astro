---
const { user } = Astro.locals;
---

<header class="flex items-center justify-between gap-4">
  <a href="/" class="flex items-center gap-2 text-amber-100/90 transition-colors hover:text-amber-50">
    <svg viewBox="0 0 24 24" class="size-5 text-amber-300" fill="currentColor" aria-hidden="true">
      <path d="M12 2 13.8 10.2 22 12l-8.2 1.8L12 22l-1.8-8.2L2 12l8.2-1.8Z"></path>
    </svg>
    <span class="font-serif text-lg tracking-wide">Sidereus</span>
  </a>

  <div class="flex items-center gap-3 text-sm">
    {user ? (
      <>
        <a href="/gear" class="text-amber-200/90 transition-colors hover:text-amber-50">
          My gear
        </a>
        <span class="hidden items-center gap-2 rounded-full border border-emerald-300/20 bg-emerald-300/10 px-3 py-1 text-emerald-100 sm:inline-flex">
          <span class="size-1.5 rounded-full bg-emerald-300" aria-hidden="true"></span>
          Welcome!
        </span>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="text-slate-300/80 transition-colors hover:text-amber-100">
            Sign out
          </button>
        </form>
      </>
    ) : (
      <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-slate-300/80">
        <span class="size-1.5 rounded-full bg-slate-400" aria-hidden="true"></span>
        Not logged in
      </span>
    )}
  </div>
</header>
