---
import PreferenceSwitches from "@/components/PreferenceSwitches";
import { getMessages } from "@/i18n";

const { user, theme, locale } = Astro.locals;
const m = getMessages(locale);
const { pathname } = Astro.url;

const navLink = "transition-colors hover:text-heading";
/** The link for the page being shown reads as the current one: heading ink, semibold (board A). */
function navState(href: string) {
  const current = pathname === href || pathname.startsWith(`${href}/`);
  return {
    class: current ? [navLink, "font-semibold text-heading"] : [navLink, "text-muted-foreground"],
    "aria-current": current ? ("page" as const) : undefined,
  };
}
const tonightLink = navState("/tonight");
const gearLink = navState("/gear");
const signinLink = navState("/auth/signin");
---

<header class="flex items-center justify-between gap-4">
  <a href="/" class="flex items-center gap-2.5 transition-opacity hover:opacity-90">
    <svg viewBox="0 0 24 24" class="size-[22px] text-primary" fill="currentColor" aria-hidden="true">
      <path d="M12 2 13.8 10.2 22 12l-8.2 1.8L12 22l-1.8-8.2L2 12l8.2-1.8Z"></path>
    </svg>
    <span class="font-display text-2xl font-semibold text-heading">{m.common.appName}</span>
  </a>

  <div class="flex flex-wrap items-center justify-end gap-x-4 gap-y-3 text-[15px]">
    {user ? (
      <>
        <a href="/tonight" class:list={tonightLink.class} aria-current={tonightLink["aria-current"]}>
          {m.nav.tonight}
        </a>
        <a href="/gear" class:list={gearLink.class} aria-current={gearLink["aria-current"]}>
          {m.nav.myGear}
        </a>
        <span class="hidden items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-sm text-muted-foreground sm:inline-flex">
          <span class="size-1.5 rounded-full bg-success" aria-hidden="true"></span>
          {m.nav.welcome}
        </span>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="cursor-pointer text-muted-foreground transition-colors hover:text-heading">
            {m.nav.signOut}
          </button>
        </form>
        <PreferenceSwitches theme={theme} locale={locale} client:load />
      </>
    ) : (
      <>
        <a href="/auth/signin" class:list={signinLink.class} aria-current={signinLink["aria-current"]}>
          {m.nav.signIn}
        </a>
        <PreferenceSwitches theme={theme} locale={locale} client:load />
      </>
    )}
  </div>
</header>
