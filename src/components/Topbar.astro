---
import TopbarControls from "@/components/TopbarControls";
import { getMessages } from "@/i18n";
import { RETURN_THEME_COOKIE, resolveReturnTheme } from "@/lib/preferences";

const { user, theme, locale } = Astro.locals;
const m = getMessages(locale);
const { pathname } = Astro.url;
const returnTheme = resolveReturnTheme(Astro.cookies.get(RETURN_THEME_COOKIE)?.value);

const navLink = "border-b-2 py-1.5 transition-colors hover:text-heading";
/** The link for the page being shown reads as the current one: heading ink, semibold, amber underline (board A). */
function navState(href: string) {
  const current = pathname === href || pathname.startsWith(`${href}/`);
  return {
    class: current
      ? [navLink, "border-primary font-semibold text-heading"]
      : [navLink, "border-transparent text-muted-foreground"],
    "aria-current": current ? ("page" as const) : undefined,
  };
}
const links = [
  { href: "/tonight", label: m.nav.tonight },
  { href: "/log", label: m.nav.log },
  { href: "/gear", label: m.nav.myGear },
].map((link) => ({ ...link, ...navState(link.href) }));
const signinLink = navState("/auth/signin");
---

<!--
  One row at every width (top-nav-redesign). Destinations sit inline here; on phones the tab bar
  (TabBar.astro) carries them instead. Theme, language and sign-out live in TopbarControls' settings popover.
-->
<header class="flex h-16 items-center gap-4">
  <a href="/" class="flex shrink-0 items-center gap-2.5 transition-opacity hover:opacity-90">
    <svg viewBox="0 0 24 24" class="size-[22px] text-primary" fill="currentColor" aria-hidden="true">
      <path d="M12 2 13.8 10.2 22 12l-8.2 1.8L12 22l-1.8-8.2L2 12l8.2-1.8Z"></path>
    </svg>
    <span class="font-display text-2xl font-semibold text-heading">{m.common.appName}</span>
  </a>

  {user && (
    <nav aria-label={m.nav.primary} class="mx-auto flex items-center gap-6 text-[15px]">
      {links.map((link) => (
        <a href={link.href} class:list={link.class} aria-current={link["aria-current"]}>
          {link.label}
        </a>
      ))}
    </nav>
  )}

  <div class="ml-auto flex items-center gap-3 text-[15px]">
    {!user && (
      <a href="/auth/signin" class:list={signinLink.class} aria-current={signinLink["aria-current"]}>
        {m.nav.signIn}
      </a>
    )}
    <TopbarControls theme={theme} returnTheme={returnTheme} locale={locale} email={user?.email ?? null} client:load />
  </div>
</header>
