---
// The answer buttons for one sky check (verdict-check), shared by Tonight's card and the sky checks page: a plain
// form with one named submit button per sky word, posting to /api/log/sky/[id]. No client state, so no island. The
// current answer, if any, is pressed (the selected fill). The default slot adds controls inside the same form (Tonight's Skip).
import { buttonVariants } from "@/components/ui/button";
import { getMessages } from "@/i18n";
import { SKY_ANSWERS, type SkyAnswer } from "@/lib/sky-checks/claim";
import { answerLabel } from "@/lib/sky-checks/labels";
import type { SkyCheckReturn } from "@/lib/sky-checks/schemas";

interface Props {
  id: string;
  /** Which page the route returns to. */
  from: SkyCheckReturn;
  /** The saved answer, shown pressed; `null` when the night is unanswered. */
  current: SkyAnswer | null;
  /**
   * Tonight only: the answer that matches the headline we showed (`claimOf`), outlined while `current` is unset, the
   * others ghost. Left out (the sky checks page), every answer is an equal outline button, so none is suggested.
   */
  matching?: SkyAnswer | null;
  /** Names the button group for assistive tech. */
  label: string;
}

const { id, from, current, matching, label } = Astro.props;
const m = getMessages(Astro.locals.locale);

// With `matching`, one answer is outlined (the saved one, or else the one that matches what we said) and the others
// are ghost buttons; without it, all three are outline. The saved answer also takes the selected fill. No primary
// fill, so the page keeps its one primary action.
const neutral = matching === undefined;
const outlined = current ?? matching;
const pressed = "aria-pressed:border-selected aria-pressed:bg-selected aria-pressed:text-selected-foreground";
// Answering needs the network (S-06): offline the form's controls are disabled and this caption shows under them; the
// page script names it as their description (src/lib/offline/page-state.ts).
const captionId = `sky-answer-offline-${id}`;
---

<form method="POST" action={`/api/log/sky/${encodeURIComponent(id)}`} data-needs-network={captionId}>
  <input type="hidden" name="from" value={from} />
  <div role="group" aria-label={label} class="flex flex-wrap gap-2">
    {SKY_ANSWERS.map((answer) => (
      <button
        type="submit"
        name="action"
        value={answer}
        aria-pressed={current === null ? undefined : current === answer}
        class:list={[buttonVariants({ variant: neutral || answer === outlined ? "outline" : "ghost" }), pressed]}
      >
        {answerLabel(m, answer)}
      </button>
    ))}
  </div>
  <slot />
  <p id={captionId} class="mt-2 hidden text-label text-muted-foreground offline:block">
    {m.offline.needsConnection}
  </p>
</form>
