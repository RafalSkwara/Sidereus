---
type Variant = "info" | "warning" | "error";

interface Props {
  variant?: Variant;
}

const { variant = "info" } = Astro.props;

// Tinted strips on the theme tokens: info on the subtle accent surface, warning amber, error red.
const TONES: Record<Variant, string> = {
  info: "border-border bg-accent",
  warning: "border-warning/40 bg-warning/10",
  error: "border-destructive/40 bg-destructive/10",
};
---

<div
  class:list={[
    "border-b px-4 py-3 text-center text-sm text-foreground [&_a]:font-semibold [&_a]:text-heading [&_a]:underline",
    TONES[variant],
  ]}
  role={variant === "error" ? "alert" : "status"}
>
  <slot />
</div>
